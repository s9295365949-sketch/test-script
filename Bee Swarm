    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    btn.Activated:Connect(function()
        STATE.CurrentField = fieldKey
        for _, child in ipairs(MainFrame:GetChildren()) do
            if child:IsA("TextButton") and child.Name == "FieldBtn" then
                child.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                child.TextColor3 = Color3.new(1,1,1)
            end
        end
        btn.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
        btn.TextColor3 = Color3.new(0, 0, 0)
    end)
    btn.Name = "FieldBtn"
end

