print("=== ДИАГНОСТИКА BSS ===")
print("STEP 1: Скрипт начал работу")

local Players = game:GetService("Players")
print("STEP 2: Сервис Players получен")

local LP = Players.LocalPlayer
print("STEP 3: LocalPlayer найден: " .. tostring(LP))
if not LP then print("❌ КРАШ: LocalPlayer = nil"); return end

local PGui = LP:WaitForChild("PlayerGui", 10)
print("STEP 4: PlayerGui найден: " .. tostring(PGui))
if not PGui then print("❌ КРАШ: PlayerGui = nil"); return end

local ScreenGui = Instance.new("ScreenGui")
print("STEP 5: ScreenGui создан")
ScreenGui.Name = "BSS_Test"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PGui
print("STEP 6: ScreenGui привязан к PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 200, 0, 100)
Frame.Position = UDim2.new(0.5, -100, 0.5, -50)
Frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
Frame.Parent = ScreenGui
print("STEP 7: Frame создан")

local Label = Instance.new("TextLabel")
Label.Size = UDim2.new(1, 0, 1, 0)
Label.BackgroundTransparency = 1
Label.Text = "TEST OK"
Label.TextColor3 = Color3.fromRGB(255, 255, 255)
Label.Font = Enum.Font.GothamBold
Label.TextSize = 20
Label.Parent = Frame
print("STEP 8: TextLabel создан")

local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(1, -20, 0, 30)
Btn.Position = UDim2.new(0, 10, 0, 50)
Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
Btn.Text = "Click Me"
Btn.TextColor3 = Color3.fromRGB(0, 0, 0)
Btn.Parent = Frame
print("STEP 9: TextButton создан")

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 255, 0)
UIStroke.Thickness = 2
UIStroke.Parent = Frame
print("STEP 10: UIStroke создан")

print("=== ВСЁ РАБОТАЕТ, должен быть красный квадрат ===")
