        QuestFieldBlue = STATE.QuestFieldBlue, WalkSpeed = STATE.WalkSpeed, JumpPower = STATE.JumpPower
    }
    local success, err = pcall(function()
        writefile("BB_BSS_Config.json", HttpService:JSONEncode(data))
    end)
    if success then print("✅ [BSS] Настройки сохранены!") 
    else print("❌ [BSS] Ошибка сохранения: " .. tostring(err)) end
end

local function LoadSettings()
    local success, data = pcall(function()
        if isfile and isfile("BB_BSS_Config.json") then
            return HttpService:JSONDecode(readfile("BB_BSS_Config.json"))
        end
    end)
    if success and data then
        for k, v in pairs(data) do
            if STATE[k] ~= nil then STATE[k] = v end
        end
        
        -- Обновляем UI (Тумблеры, списки и ползунки)
        for _, update in ipairs(UI_References.Toggles) do update() end
        for _, update in ipairs(UI_References.Dropdowns) do update() end
        for _, update in ipairs(UI_References.Sliders) do update() end
        
        -- Применяем к игроку
        local char = LP.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.WalkSpeed = STATE.WalkSpeed
            char.Humanoid.JumpPower = STATE.JumpPower
            char.Humanoid.UseJumpPower = true
        end
        print("✅ [BSS] Настройки загружены!")
    else
        print("❌ [BSS] Файл конфигурации не найден.")
    end
end

