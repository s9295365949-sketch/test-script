local function CreateSlider(parent, yPos, titleText, minVal, maxVal, stateKey, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0, 260, 0, 45)
    Container.Position = UDim2.new(0, 0, 0, yPos)
    Container.BackgroundTransparency = 1
    Container.Parent = parent

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 20)
    Label.BackgroundTransparency = 1
    Label.Text = titleText .. ": " .. tostring(STATE[stateKey])
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container

    local Bar = Instance.new("Frame")
    Bar.Size = UDim2.new(1, -10, 0, 8)
    Bar.Position = UDim2.new(0, 5, 0, 28)
    Bar.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Bar.Parent = Container
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

    local initialRatio = (STATE[stateKey] - minVal) / (maxVal - minVal)
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    Fill.Parent = Bar
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = UDim2.new(initialRatio, -8, 0.5, -8)
    Knob.BackgroundColor3 = Color3.new(1, 1, 1)
    Knob.Parent = Bar
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local HitBox = Instance.new("TextButton")
    HitBox.Size = UDim2.new(1, 20, 0, 30)
    HitBox.Position = UDim2.new(0, -10, 0, -11)
    HitBox.BackgroundTransparency = 1
    HitBox.Text = ""
    HitBox.Parent = Bar
    HitBox.Active = true

    local isDragging = false
    local function updateValue(inputX)
        local ratio = clamp((inputX - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(minVal + (maxVal - minVal) * ratio)
        STATE[stateKey] = value
        Label.Text = titleText .. ": " .. tostring(value)
        Fill.Size = UDim2.new(ratio, 0, 1, 0)
        Knob.Position = UDim2.new(ratio, -8, 0.5, -8)
        callback(value)
    end

    HitBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true; updateValue(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    table.insert(UI_References.Sliders, function()
        local val = STATE[stateKey]
        local ratio = (val - minVal) / (maxVal - minVal)
        Label.Text = titleText .. ": " .. tostring(val)
        Fill.Size = UDim2.new(ratio, 0, 1, 0)
        Knob.Position = UDim2.new(ratio, -8, 0.5, -8)
    end)
end

