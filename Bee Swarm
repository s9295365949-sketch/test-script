-- Безопасное плавное перемещение к позиции
local function TweenToPosition(targetPos, duration)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    
    STATE.IsBusy = true
    
    -- Создаем Tween
    local tweenInfo = TweenInfo.new(duration or 1.5, Enum.EasingStyle.Linear)
    local goal = {CFrame = CFrame.new(targetPos)}
    local tween = TweenService:Create(tweenPart, tweenInfo, goal)
    
    tween:Play()
    tween.Completed:Wait()
    
    -- Телепортируем персонажа к финальной точке (безопасно, т.к. движение было плавным)
    hrp.CFrame = CFrame.new(targetPos)
    
    STATE.IsBusy = false
    return true
end

