-- Поиск ближайшего цветка для сбора пыльцы
local function FindNearestFlower()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart.Position
    
    local nearest = nil
    local shortestDist = 40 -- Радиус поиска
    
    -- Цветы обычно в Workspace.Flowers или Workspace
    local flowerFolder = Workspace:FindFirstChild("Flowers") or Workspace
    
    for _, obj in ipairs(flowerFolder:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name:find("Flower") or obj.Name:find("Pollen")) then
            local dist = (obj.Position - hrp).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearest = obj
            end
        end
    end
    return nearest
end

-- Поиск ближайшего моба
local function FindNearestMob()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart.Position
    
    local nearest = nil
    local shortestDist = 50
    
    -- Мобы обычно в Workspace.Mobs или Workspace
    local mobFolder = Workspace:FindFirstChild("Mobs") or Workspace
    
    for _, obj in ipairs(mobFolder:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= LP.Name then
            local root = obj:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - hrp).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

-- Поиск квестового предмета (например, Honey, Egg)
local function FindQuestItem()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart.Position
    
    local nearest = nil
    local shortestDist = 60
    
    -- Квестовые предметы могут быть в Workspace или в папке Tokens
    local searchArea = Workspace:FindFirstChild("Tokens") or Workspace
    
    for _, obj in ipairs(searchArea:GetChildren()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("honey") or name:find("egg") or name:find("quest") or name:find("strawberry") then
                local dist = (obj.Position - hrp).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

