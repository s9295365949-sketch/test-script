-- Авто-фарм (Клик по ближайшему цветку)
task.spawn(function()
    while task.wait(0.3) do
        if STATE.AutoFarm and not isBusy then
            local char = LP.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
            local hrp = char.HumanoidRootPart.Position
            
            local nearestFlower = nil
            local shortestDist = 25 -- Радиус фарма (25 стабсов)

            -- Ищем цветы в Workspace.Flowers или Workspace
            local flowerFolder = Workspace:FindFirstChild("Flowers") or Workspace
            
            for _, obj in ipairs(flowerFolder:GetChildren()) do
                if obj:IsA("BasePart") and obj.Name:find("Flower") then
                    local dist = (obj.Position - hrp).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestFlower = obj
                    end
                end
            end

            if nearestFlower then
                isBusy = true
                -- Физически "касаемся" цветка, чтобы собрать пыльцу
                pcall(function()
                    firetouchinterest(char.HumanoidRootPart, nearestFlower, 0)
                    task.wait(0.05)
                    firetouchinterest(char.HumanoidRootPart, nearestFlower, 1)
                end)
                isBusy = false
            end
        end
    end
end)

