local function TweenToPosition(targetPos, duration)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local tweenPart = Instance.new("Part")
    tweenPart.Anchored = true; tweenPart.CanCollide = false; tweenPart.Transparency = 1
    tweenPart.CFrame = hrp.CFrame; tweenPart.Parent = Workspace
    
    local tween = TweenService:Create(tweenPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play(); tween.Completed:Wait()
    
    hrp.CFrame = CFrame.new(targetPos)
    tweenPart:Destroy()
end

local function GetBackpackPercentage()
    local percent = 0
    for _, obj in ipairs(PGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local match = obj.Text:match("(%d+)%%")
            if match then
                local num = tonumber(match)
                if num and num > percent then percent = num end
            end
        end
    end
    return percent
end

function FindMyBase()
    local hivesFolder = Workspace:FindFirstChild("Hives")
    if not hivesFolder then return nil end
    for _, hive in ipairs(hivesFolder:GetChildren()) do
        local owner = hive:GetAttribute("Owner")
        if owner == LP.Name or owner == LP.UserId or tostring(owner) == LP.Name then
            local basePart = hive:FindFirstChild("ClaimPart") or hive:FindFirstChildWhichIsA("BasePart")
            if basePart then return basePart.Position end
        end
    end
    return nil
end

function ClaimNewBase()
    STATE.DebugText = "🔍 Ищем свободную базу..."
    local char = LP.Character
    if not char then return false end
    for i, pos in ipairs(BASE_LOCATIONS) do
        STATE.DebugText = "📡 Проверяем базу #" .. i
        TweenToPosition(pos, 1)
        task.wait(0.5)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and (obj.Parent.Position - char.HumanoidRootPart.Position).Magnitude < 25 then
                STATE.DebugText = "🔑 Занимаем базу!"
                if fireproximityprompt then fireproximityprompt(obj) end
                task.wait(1.5)
                local myBase = FindMyBase()
                if myBase then
                    STATE.MyBasePos = myBase
                    STATE.DebugText = "✅ База занята!"
                    return true
                end
            end
        end
    end
    return false
end

local function GetNearestItem(keywords)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    local nearest, shortestDist = nil, 100
    
    local searchFolders = {Workspace}
    if Workspace:FindFirstChild("Tokens") then table.insert(searchFolders, Workspace.Tokens) end
    
    for _, folder in ipairs(searchFolders) do
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("BasePart") then
                local name = obj.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw) then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist < shortestDist then shortestDist = dist; nearest = obj end
                        break
                    end
                end
            end
        end
    end
    return nearest, shortestDist
end

