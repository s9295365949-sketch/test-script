_G.BSS_RefreshProfiles = function()
    for _, child in ipairs(ProfileList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("Frame") then child:Destroy() end
    end
    
    local autoName = ""
    pcall(function()
        if isfile and isfile("BSS_AutoLoad.txt") then autoName = readfile("BSS_AutoLoad.txt") end
    end)

    local files = {}
    pcall(function()
        if listfiles then
            for _, f in ipairs(listfiles(PROFILE_FOLDER)) do
                local match = f:match("(.+)%.json")
                if match then table.insert(files, match) end
            end
        end
    end)
    
    if #files == 0 then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 25)
        lbl.BackgroundTransparency = 1
        lbl.Text = "Нет сохранений"
        lbl.TextColor3 = Color3.fromRGB(150, 150, 150)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 11
        lbl.Parent = ProfileList
        return
    end

    table.sort(files)
    if autoName ~= "" then
        for i, v in ipairs(files) do
            if v == autoName then
                table.remove(files, i)
                table.insert(files, 1, v)
                break
            end
        end
    end

    for _, name in ipairs(files) do
        local isAuto = (name == autoName)
        
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 25)
        row.BackgroundTransparency = 1
        row.Parent = ProfileList

        local loadBtn = Instance.new("TextButton")
        loadBtn.Size = UDim2.new(0.6, -2, 1, 0)
        loadBtn.BackgroundColor3 = isAuto and Color3.fromRGB(255, 180, 0) or Color3.fromRGB(45, 45, 55)
        loadBtn.Text = (isAuto and "★ " or "") .. name
        loadBtn.TextColor3 = isAuto and Color3.new(0,0,0) or Color3.new(1,1,1)
        loadBtn.Font = Enum.Font.GothamBold
        loadBtn.TextSize = 11
        loadBtn.Parent = row
        Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0, 4)
        loadBtn.MouseButton1Click:Connect(function() LoadSettings(name) end)

        local autoBtn = Instance.new("TextButton")
        autoBtn.Size = UDim2.new(0.4, -2, 1, 0)
        autoBtn.Position = UDim2.new(0.6, 2, 0, 0)
        autoBtn.BackgroundColor3 = isAuto and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(100, 150, 255)
        autoBtn.Text = isAuto and "✓ AUTO" or "Set Auto"
        autoBtn.TextColor3 = isAuto and Color3.new(0,0,0) or Color3.new(1,1,1)
        autoBtn.Font = Enum.Font.GothamBold
        autoBtn.TextSize = 10
        autoBtn.Parent = row
        Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0, 4)
        
        autoBtn.MouseButton1Click:Connect(function()
            if isAuto then
                pcall(function() delfile("BSS_AutoLoad.txt") end)
                print(">>> [BSS] Авто-загрузка профиля отключена.")
            else
                pcall(function() writefile("BSS_AutoLoad.txt", name) end)
                print(">>> [BSS] Профиль '" .. name .. "' установлен на авто-старт.")
            end
            _G.BSS_RefreshProfiles()
        end)
    end
end

