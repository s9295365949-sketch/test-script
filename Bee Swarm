local function SaveSettings()
    local pName = "Default"
    if _G.BSS_ProfileNameBox and _G.BSS_ProfileNameBox.Text ~= "" then pName = _G.BSS_ProfileNameBox.Text end
    
    local data = {
        AutoFarm = STATE.AutoFarm, AutoPollen = STATE.AutoPollen, AutoToken = STATE.AutoToken, 
        AutoConvert = STATE.AutoConvert, AutoQuest = STATE.AutoQuest,
        CurrentField = STATE.CurrentField, CurrentQuestNPC = STATE.CurrentQuestNPC,
        QuestFieldRed = STATE.QuestFieldRed, QuestFieldWhite = STATE.QuestFieldWhite, QuestFieldBlue = STATE.QuestFieldBlue,
        WalkSpeed = STATE.WalkSpeed, JumpPower = STATE.JumpPower,
        CustomFields = STATE.CustomFields, CustomBases = STATE.CustomBases -- Сохраняем координаты
    }
    
    local success = pcall(function()
        -- Просто перезаписываем файл, если он есть
        writefile(PROFILE_FOLDER .. "/" .. pName .. ".json", HttpService:JSONEncode(data))
    end)
    if success then print(">>> [BSS] Профиль '" .. pName .. "' сохранен (или перезаписан)!") 
    else print(">>> [BSS] Ошибка сохранения.") end
    
    if _G.BSS_RefreshProfiles then _G.BSS_RefreshProfiles() end
end

local function LoadSettings(profileName)
    local success, data = pcall(function()
        if isfile and isfile(PROFILE_FOLDER .. "/" .. profileName .. ".json") then 
            return HttpService:JSONDecode(readfile(PROFILE_FOLDER .. "/" .. profileName .. ".json")) 
        end
    end)
    if success and data then
        for k, v in pairs(data) do 
            if STATE[k] ~= nil then 
                if type(v) == "table" then
                    STATE[k] = v
                else
                    STATE[k] = v 
                end
            end 
        end
        for _, update in ipairs(UI_References.Toggles) do update() end
        for _, update in ipairs(UI_References.Dropdowns) do update() end
        for _, update in ipairs(UI_References.Sliders) do update() end
        
        local char = LP.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.WalkSpeed = STATE.WalkSpeed
            char.Humanoid.JumpPower = STATE.JumpPower
            char.Humanoid.UseJumpPower = true
        end
        print(">>> [BSS] Профиль '" .. profileName .. "' загружен!")
    else 
        print(">>> [BSS] Профиль не найден.") 
    end
end

