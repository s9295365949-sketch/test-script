-- [ ЛОГИКА: AUTO POLLEN ]
-- ============================================================
task.spawn(function()
    while task.wait(0.15) do
        if STATE.AutoPollen then
            local char = LP.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    STATE.DebugText = "Pollen: Tool found ("..tool.Name..")"
                    
                    -- Способ 1: Активация инструмента
                    pcall(function() tool:Activate() end)
                    
                    -- Способ 2: Клик в центр экрана (чтобы махать палкой)
                    pcall(function()
                        local cam = Workspace.CurrentCamera
                        local vp = cam.ViewportSize
                        VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 0)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 0)
                    end)
                else
                    STATE.DebugText = "Pollen: NO TOOL EQUIPPED!"
                end
            end
        end
    end
end)

-- ============================================================
-- [ ЛОГИКА: AUTO TOKEN (БЕГ) ]
-- ============================================================
task.spawn(function()
    while task.wait(0.3) do
        if STATE.AutoToken then
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid
                
                local nearestToken = nil
                local shortestDist = 150 -- Увеличили радиус поиска
                
                -- Ищем токены в папке Tokens, если она есть, иначе везде
                local searchFolders = {Workspace}
                if Workspace:FindFirstChild("Tokens") then
                    table.insert(searchFolders, Workspace.Tokens)
                end
                if Workspace:FindFirstChild("Debris") then
                    table.insert(searchFolders, Workspace.Debris)
                end
                
                for _, folder in ipairs(searchFolders) do
                    for _, obj in ipairs(folder:GetChildren()) do
                        if obj:IsA("BasePart") then
                            local name = obj.Name:lower()
                            if name:find("token") or name:find("honey") or name:find("pollen") or name:find("strawberry") or name:find("blueberry") then
                                local dist = (obj.Position - hrp.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    nearestToken = obj
                                end
                            end
                        end
                    end
                end
                
                if nearestToken then
                    STATE.DebugText = string.format("Token: Found '%s' (%.1f studs)", nearestToken.Name, shortestDist)
                    humanoid:MoveTo(nearestToken.Position)
                    
                    -- Прыжок, если застряли
                    if humanoid.MoveDirection.Magnitude < 0.1 then
                        humanoid.Jump = true
                    end
                else
                    STATE.DebugText = "Token: None found (Radius 150)"
                end
            end
        end
    end
end)

