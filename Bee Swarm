local function CreateToggle(parent, yPos, text, stateKey, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 260, 0, 35)
    Btn.Position = UDim2.new(0, 0, 0, yPos)
    Btn.BackgroundColor3 = STATE[stateKey] and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(40, 40, 45)
