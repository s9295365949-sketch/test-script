-- 1. Цикл авто-фарма (перемещение по полю и сбор)
task.spawn(function()
    while task.wait(0.5) do
        if STATE.Enabled and not STATE.IsBusy then
            local fieldData = FIELD_POSITIONS[STATE.CurrentField]
            if not fieldData then continue end
            
            -- Проверяем, не заполнен ли рюкзак
            if STATE.AutoConvert and IsBackpackFull() then
                ConvertPollen()
                continue
            end
            
            -- Перемещаемся в выбранное поле (если далеко)
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart.Position
                local distToField = (fieldData.Position - hrp).Magnitude
                
                if distToField > 50 then
                    -- Плавно летим к полю
                    TweenToPosition(fieldData.Position, 2)
                else
                    -- Мы на поле, ищем цветок и собираем
                    local flower = FindNearestFlower()
                    if flower then
                        -- Плавно подходим к цветку (имитация движения)
                        local flowerPos = flower.Position + Vector3.new(0, 3, 0)
                        TweenToPosition(flowerPos, 0.4)
                        
                        -- Активируем сбор (касание)
                        pcall(function()
                            firetouchinterest(char.HumanoidRootPart, flower, 0)
                            task.wait(0.05)
                            firetouchinterest(char.HumanoidRootPart, flower, 1)
                        end)
                    end
                end
            end
        end
    end
end)

