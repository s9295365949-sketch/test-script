-- Поиск мяча
local function GetBall()
    if State.CurrentBall and State.CurrentBall.Parent then 
        return State.CurrentBall 
    end
    
    local BallsFolder = Workspace:FindFirstChild("Balls")
    if BallsFolder then
        for _, obj in ipairs(BallsFolder:GetChildren()) do
            if obj:IsA("BasePart") then State.CurrentBall = obj; return obj end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("BasePart") and obj:GetAttribute("realBall") then
            State.CurrentBall = obj; return obj
        end
    end
    return nil
end

-- Строгая проверка: летит ли ИМЕННО в нас?
local function IsTargetingMe(ball)
    if not ball then return false end
    
    local attrs = {"target", "Target", "targetPlayer", "TargetPlayer"}
    for _, attr in ipairs(attrs) do
        local val = ball:GetAttribute(attr)
        if val then
            if val == LP or val == LP.Name or val == LP.UserId or val == LP.Character or tostring(val) == LP.Name then
                return true
            else
                return false -- Если там другой игрок, отменяем.
            end
        end
    end
    
    local char = LP.Character
    if char and char:FindFirstChild("Highlight") then return true end
    
    return false
end

-- Расчет 3-х зон
local function GetDynamicZone(speed)
    local Z = CFG.ZONE
    if speed <= Z.MIN_SPEED then return Z.MIN_DIST
    elseif speed <= Z.MID_SPEED then
        local a = (speed - Z.MIN_SPEED) / (Z.MID_SPEED - Z.MIN_SPEED)
        return Z.MIN_DIST + (Z.MID_DIST - Z.MIN_DIST) * a
    elseif speed <= Z.MAX_SPEED then
        local a = (speed - Z.MID_SPEED) / (Z.MAX_SPEED - Z.MID_SPEED)
        return Z.MID_DIST + (Z.MAX_DIST - Z.MID_DIST) * a
    else
        return Z.MAX_DIST
    end
end

-- Вызов парирования
local function FireParry()
    if not State.Enabled or not State.IsArmed then return end
    if tick() - State.LastParry < CFG.PARRY_COOLDOWN then return end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)

    State.LastParry = tick()
    State.IsArmed = false
end

-- ============================================================
-- [6] ОСНОВНОЙ ЦИКЛ
-- ============================================================
local PulseTime = 0

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if not hrp or not hum or hum.Health <= 0 then
            if Sphere then Sphere.Transparency = 1 end
            if InnerSphere then InnerSphere.Transparency = 1 end
            return
        end

        local ball = GetBall()
        local hrpPos = hrp.Position
        
        local targetDist = CFG.ZONE.MIN_DIST * 2
        local targetColor = CFG.SPHERE_COLOR_SAFE
        local currentSpeed = 0
        local statusText = "Safe"

        if ball then
            local bp = ball.Position
            local dist = (hrpPos - bp).Magnitude
            
            -- Сброс при появлении нового мяча
            if State.CurrentBall ~= ball then
                State.CurrentBall = ball
                State.PrevBallPos = bp
                State.IsArmed = true
            end
            
            if dist > CFG.ZONE.MAX_DIST * 1.5 then State.IsArmed = true end

            -- Вычисление скорости
            if State.PrevBallPos and dt > 0 then
                currentSpeed = (bp - State.PrevBallPos).Magnitude / dt
            end

            -- Логика
            if IsTargetingMe(ball) then
                local zone = GetDynamicZone(currentSpeed)
                targetDist = zone * 2
                
                if dist <= zone then
                    targetColor = CFG.SPHERE_COLOR_THREAT
                    statusText = "PARRY!"
                    FireParry()
                else
                    statusText = "Incoming!"
                end
            else
                statusText = "Target: Other"
            end
            
            State.PrevBallPos = bp
        else
            State.IsArmed = true
            State.PrevBallPos = nil
        end

        -- ==========================================
        -- ВИЗУАЛИЗАЦИЯ СФЕРЫ (Плавная и красивая)
        -- ==========================================
        if State.ShowSphere and Sphere and InnerSphere then
            PulseTime = PulseTime + dt * 3
            
            -- Эффект "дыхания" (пульсация размера)
            local pulse = 1 + math.sin(PulseTime) * 0.03
            local finalSize = targetDist * pulse
            
            -- Плавное изменение размера (Lerp)
            local currentSize = Sphere.Size.X
            local newSize = currentSize + (finalSize - currentSize) * math.exp(-10 * dt)
            
            Sphere.Size = Vector3.new(newSize, newSize, newSize)
            Sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.SPHERE_Y_OFFSET, hrpPos.Z)
            
            -- Плавная смена цвета
            Sphere.Color = Sphere.Color:Lerp(targetColor, math.clamp(10 * dt, 0, 1))
            InnerSphere.Color = Sphere.Color
            
            -- Внутренняя сфера немного крутится
            InnerSphere.CFrame = Sphere.CFrame * CFrame.Angles(PulseTime, PulseTime, 0)
            InnerSphere.Size = Vector3.new(newSize * 0.2, newSize * 0.2, newSize * 0.2)
            
            Sphere.Transparency = 0.8
            InnerSphere.Transparency = 0.9
        end

        -- ==========================================
        -- ОБНОВЛЕНИЕ ОТЛАДЧИКА
        -- ==========================================
        if DebugText and DebugText.Parent then
            DebugText.Text = string.format(
                "⚡ Speed: %.0f\n🎯 Status: %s\n📏 Dist: %.1f\n🛡️ Armed: %s",
                currentSpeed, statusText, (ball and (hrpPos - ball.Position).Magnitude or 0), tostring(State.IsArmed)
            )
            
            -- Красим текст в красный при опасности
            if statusText == "PARRY!" then
                DebugText.TextColor3 = CFG.SPHERE_COLOR_THREAT
            else
                DebugText.TextColor3 = CFG.UI_THEME.ACCENT
            end
        end
    end)
end)

