--[[
    ╔═══════════════════════════════════════════════════════════════════════╗
    ║   BLADE BALL — DYNAMIC GAP SPHERE                                     ║
    ║   • Сфера всегда держится в 10 стабсах от мяча                        ║
    ║   • Сжимается до MIN_RADIUS, после чего мяч пролетает 10 стабсов     ║
    ║   • Мгновенный парир в момент пересечения границы сферы               ║
    ╚═══════════════════════════════════════════════════════════════════════╝
]]

-- ============================================================
-- 1. НАСТРОЙКИ (КРУТИЛКИ)
-- ============================================================
local CFG = {
    -- ─── Геометрия и дистанция ─────────────────────────────
    BALL_GAP_STUDS      = 10,        -- Отступ от мяча до края сферы
    MIN_RADIUS          = 6,         -- Минимальный радиус сферы (точка срабатывания парира)
    MAX_DIAMETER        = 40,        -- Максимальный диаметр сферы (чтобы не росла бесконечно)

    -- ─── Визуал ────────────────────────────────────────────
    DISTANCE_FOR_FAR    = 25,        
    NEAR_TRANSPARENCY   = 0.60,      
    FAR_TRANSPARENCY    = 0.70,      
    Y_OFFSET            = -0.5,      

    -- ─── Парирование ───────────────────────────────────────
    PARRY_COOLDOWN      = 0.15,      
    REARM_MULTIPLIER    = 1.5,       
    PARRY_KEY           = Enum.KeyCode.F,

    -- ─── Предиктивка и стабильность ────────────────────────
    PREDICT_FRAMES      = 2,
    MIN_AHEAD           = 0.06,
    MAX_AHEAD           = 0.25,
    DAMP_LAMBDA         = 14,
    FREEZE_TIMEOUT      = 0.35,      
    APPROACH_MIN        = -2,        

    -- ─── Движение сферы ────────────────────────────────────
    PULSE_SPEED         = 2.2,       
    PULSE_SIZE_AMPL     = 0.04,      
    PULSE_ALPHA_AMPL    = 0.04,      
    BOB_SPEED           = 1.8,       
    BOB_AMPLITUDE       = 0.15,      
    BRIGHTNESS_PULSE    = 0.10,      

    -- ─── Цвета градиента ───────────────────────────────────
    COLOR_NEAR = Color3.fromRGB(255, 30, 30),    
    COLOR_MID  = Color3.fromRGB(255, 200, 0),    
    COLOR_FAR  = Color3.fromRGB(30, 255, 50),    

    DEBUG = false,                   
}

-- ============================================================
-- 2. СЕРВИСЫ И БАЗОВЫЕ ПЕРЕМЕННЫЕ
-- ============================================================
local function svc(name)
    local ok, s = pcall(function() return cloneref(game:GetService(name)) end)
    return ok and s or game:GetService(name)
end

local Players           = svc("Players")
local RunService        = svc("RunService")
local UserInputService  = svc("UserInputService")
local Workspace         = svc("Workspace")
local Stats             = svc("Stats")
local ReplicatedStorage = svc("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 10)

-- ============================================================
-- 3. УТИЛИТЫ
-- ============================================================
local function log(...) if CFG.DEBUG then print("[BB]", ...) end end
local function jitter(base) return base * (0.6 + math.random() * 0.8) end
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

local function gradientColor(t)
    t = clamp01(t)
    if t <= 0.5 then return CFG.COLOR_NEAR:Lerp(CFG.COLOR_MID, t * 2)
    else              return CFG.COLOR_MID:Lerp(CFG.COLOR_FAR, (t - 0.5) * 2) end
end

-- ============================================================
-- 4. ПИНГ
-- ============================================================
local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- ============================================================
-- 5. СОЗДАНИЕ СФЕРЫ
-- ============================================================
local sphere = Instance.new("Part")
sphere.Name         = "ParrySphere"
sphere.Shape        = Enum.PartType.Ball
sphere.Anchored     = true
sphere.CanCollide   = false
sphere.CanTouch     = false
sphere.CanQuery     = false
sphere.CastShadow   = false
sphere.Material     = Enum.Material.ForceField
sphere.Color        = CFG.COLOR_FAR
sphere.Transparency = CFG.FAR_TRANSPARENCY
sphere.Size         = Vector3.new(CFG.MAX_DIAMETER, CFG.MAX_DIAMETER, CFG.MAX_DIAMETER)
sphere.Parent       = Workspace

-- ============================================================
-- 6. ДЕТЕКЦИЯ МЯЧА
-- ============================================================
local cachedBall = nil

local function findBall()
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (n == "ball" or n == "energyball" or n == "fireball" or n == "iceball" or n == "snowball") 
               and not n:find("explosion") and not n:find("effect") and not n:find("death") then
                return o
            end
        end
    end
    return nil
end

cachedBall = findBall()

Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall then
        local n = o.Name:lower()
        if o:GetAttribute("realBall") or n == "ball" then
            cachedBall = o
        end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ============================================================
-- 7. ПАРИРОВАНИЕ (Чистый ввод)
-- ============================================================
local parryRemote = nil
local function findParryRemote()
    local ok, found = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("parry") or n:find("block") or n:find("deflect") then
                    return obj
                end
            end
        end
    end)
    return ok and found or nil
end
parryRemote = findParryRemote()

local function sendParryOnce()
    if parryRemote then
        pcall(function()
            if parryRemote:IsA("RemoteEvent") then parryRemote:FireServer()
            else parryRemote:InvokeServer() end
        end)
        return
    end
    pcall(function()
        UserInputService:SendKeyEvent(true,  CFG.PARRY_KEY, false, game)
        task.wait(jitter(0.02))
        UserInputService:SendKeyEvent(false, CFG.PARRY_KEY, false, game)
    end)
end

local burstActive = false
local function fireParry()
    if burstActive then return end
    burstActive = true
    task.spawn(function()
        local count = math.random(1, 2)
        for i = 1, count do
            sendParryOnce()
            if i < count then task.wait(jitter(0.05)) end
        end
        task.wait(jitter(0.03))
        burstActive = false
    end)
end

-- ============================================================
-- 8. ВИЗУАЛЬНОЕ ПРИМЕНЕНИЕ
-- ============================================================
local lastState = {
    pos = Vector3.new(), size = -1, alpha = -1, color = Color3.new(),
}

local function applySphere(center, diameter, transparency, color)
    local moved     = (center - lastState.pos).Magnitude > 0.005
    local resized   = math.abs(diameter - lastState.size) > 0.005
    local transed   = math.abs(transparency - lastState.alpha) > 0.003
    local recolored = (color.R - lastState.color.R)^2 + (color.G - lastState.color.G)^2 + (color.B - lastState.color.B)^2 > 0.0001
    
    if not (moved or resized or transed or recolored) then return end

    lastState.pos, lastState.size, lastState.alpha, lastState.color = center, diameter, transparency, color

    sphere.CFrame       = CFrame.new(center)
    sphere.Size         = Vector3.new(diameter, diameter, diameter)
    sphere.Transparency = transparency
    sphere.Color        = color
end

-- ============================================================
-- 9. СОСТОЯНИЕ
-- ============================================================
local state = {
    diameter     = CFG.MAX_DIAMETER,
    transparency = CFG.FAR_TRANSPARENCY,
    color        = CFG.COLOR_FAR,
    lastParry    = 0,
    lastFlash    = 0,
    armed        = true,
    prevDist     = math.huge,
    phase        = 0,
    frozenTime   = 0,
    lastBallPos  = nil,
}

-- ============================================================
-- 10. ГЛАВНЫЙ ЦИКЛ (Logic)
-- ============================================================
local function mainTick(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end

    local hrpPos = HRP.Position
    local ball   = cachedBall

    local tgtDiameter     = CFG.MAX_DIAMETER
    local tgtTransparency = CFG.FAR_TRANSPARENCY
    local tgtColor        = CFG.COLOR_FAR
    local doParry         = false

    if ball then
        local dist = (hrpPos - ball.Position).Magnitude

        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed    = bv.Magnitude
        local approach = 0
        if speed > 0.5 then
            local dir = (hrpPos - ball.Position).Unit
            approach = bv:Dot(dir)
        end

        -- Проверка цели
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
                  or ball:GetAttribute("targetPlayer") or ball:GetAttribute("TargetPlayer")
        
        local hasTarget = (tVal ~= nil)
        local isMe = false
        local isOther = false
        
        if hasTarget then
            if tVal == LocalPlayer or tVal == LocalPlayer.Character or tVal == LocalPlayer.Name 
               or (typeof(tVal) == "Instance" and tVal == Character)
               or (typeof(tVal) == "Instance" and tVal == LocalPlayer)
               or tostring(tVal) == LocalPlayer.Name then
                isMe = true
            else
                isOther = true
            end
        end
        
        local hl = Character and Character:FindFirstChild("Highlight")
        if hl and hl.Enabled then isMe = true end
        if isMe then isOther = false end
        
        local targeting = isMe
        if isOther then targeting = false end
        
        -- Аварийный детект (если мяч летит в нас без цели)
        if not hasTarget and not targeting then
            if dist < 15 and speed > 30 and approach > 10 then
                targeting = true
            end
        end

        local isThreat = targeting and (speed > 2 or approach > 0)

        if isThreat then
            -- Детект зависания
            if state.lastBallPos and (ball.Position - state.lastBallPos).Magnitude < 0.15 then
                state.frozenTime = state.frozenTime + dt
            else
                state.frozenTime  = 0
                state.lastBallPos = ball.Position
            end
            local frozen = state.frozenTime > CFG.FREEZE_TIMEOUT

            local movingAway   = approach < CFG.APPROACH_MIN
            local distanceGrew = dist > state.prevDist + 0.8
            local frozenThreat = frozen and dist > CFG.MIN_RADIUS * 2

            local visualTargeting = not (movingAway or distanceGrew or frozenThreat)

            if visualTargeting then
                -- ЖЕЛАЕМЫЙ РАДИУС: дистанция до мяча + 10 стабсов.
                -- Но он не может быть меньше MIN_RADIUS.
                local targetRadius = math.max(CFG.MIN_RADIUS, dist + CFG.BALL_GAP_STUDS)
                
                -- Ограничиваем максимальный размер, чтобы не занимал пол-экрана
                local maxRadius = CFG.MAX_DIAMETER / 2
                targetRadius = math.min(targetRadius, maxRadius)

                tgtDiameter = targetRadius * 2

                local u = clamp01(dist / CFG.DISTANCE_FOR_FAR)
                tgtTransparency = CFG.NEAR_TRANSPARENCY + (CFG.FAR_TRANSPARENCY - CFG.NEAR_TRANSPARENCY) * u
                tgtColor        = gradientColor(u)
            else
                tgtDiameter     = CFG.MAX_DIAMETER
                tgtTransparency = CFG.FAR_TRANSPARENCY
                tgtColor        = CFG.COLOR_FAR
            end

            -- Перевзвод
            if dist > CFG.MIN_RADIUS * CFG.REARM_MULTIPLIER then state.armed = true end

            -- ПАРИРОВАНИЕ: срабатывает, если мяч пересек границу MIN_RADIUS
            if state.armed then
                if dist <= CFG.MIN_RADIUS then
                    doParry = true
                end
                if not doParry and state.prevDist > CFG.MIN_RADIUS and dist <= CFG.MIN_RADIUS then
                    doParry = true
                end
                -- Предиктивка (чтобы не умереть от пинга, предсказываем за 1-2 кадра)
                if not doParry and approach > 0 then
                    local horizon = math.clamp(pingCache + CFG.PREDICT_FRAMES / 60, CFG.MIN_AHEAD, CFG.MAX_AHEAD)
                    if (dist - CFG.MIN_RADIUS) / approach <= horizon then 
                        doParry = true 
                    end
                end
            end
            state.prevDist = dist
        else
            state.armed       = true
            state.prevDist    = math.huge
            state.frozenTime  = 0
            state.lastBallPos = nil
        end
    else
        state.armed       = true
        state.prevDist    = math.huge
        state.frozenTime  = 0
        state.lastBallPos = nil
    end

    -- Вызов парирования
    if doParry then
        local now = tick()
        if now - state.lastParry >= CFG.PARRY_COOLDOWN then
            fireParry()
            state.lastParry = now
            state.lastFlash = now
            state.armed     = false
        end
    end

    -- Сглаживание
    state.diameter     = damp(state.diameter,     tgtDiameter,     CFG.DAMP_LAMBDA, dt)
    state.transparency = damp(state.transparency, tgtTransparency, CFG.DAMP_LAMBDA, dt)
    state.color        = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))

    -- Анимация
    state.phase = state.phase + dt * CFG.PULSE_SPEED
    local pulse = math.sin(state.phase)

    local finalDiameter = state.diameter * (1 + pulse * CFG.PULSE_SIZE_AMPL)
    local finalTrans    = math.clamp(state.transparency + pulse * CFG.PULSE_ALPHA_AMPL, 0, 0.95)
    
    local brightMul = 1 + pulse * CFG.BRIGHTNESS_PULSE
    local finalColor = Color3.new(
        math.clamp(state.color.R * brightMul, 0, 1),
        math.clamp(state.color.G * brightMul, 0, 1),
        math.clamp(state.color.B * brightMul, 0, 1)
    )

    if tick() - state.lastFlash < 0.12 then
        finalColor = Color3.fromRGB(255, 255, 255)
    end

    local bob = math.sin(state.phase * (CFG.BOB_SPEED / CFG.PULSE_SPEED)) * CFG.BOB_AMPLITUDE
    local center = Vector3.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET + bob, hrpPos.Z)

    applySphere(center, finalDiameter, finalTrans, finalColor)
    sphere.Transparency = finalTrans
end

RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(mainTick, dt)
    if not ok and CFG.DEBUG then warn("[BB] tick:", err) end
end)

