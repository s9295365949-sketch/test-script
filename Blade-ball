-- 5. ПОИСК МЯЧА
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then
        if not cachedBall then cachedBall = o end
    end
end)

-- 6. ПАРИРОВАНИЕ
local lastParry = 0
local lastAction = "None"
local isArmed = true

local function executeParry()
    if not CFG.PARRY_ENABLED then return end
    if not isArmed then return end
    if tick() - lastParry < CFG.PARRY_COOLDOWN then return end

    local fired = false

    pcall(function()
        ContextActionService:CallFunction("Block", Enum.UserInputState.Begin, nil)
        ContextActionService:CallFunction("Parry", Enum.UserInputState.Begin, nil)
        fired = true
    end)

    if parryRemote then
        pcall(function() parryRemote:FireServer() end)
        fired = true
    end

    lastAction = fired and "CAS + Remote" or "Failed"
    lastParry = tick()
    isArmed = false
end

-- 7. ЦИКЛ
local lastBall = nil
local prevPos = nil
local currentDiameter = CFG.MAX_RADIUS * 2
local currentColor = CFG.COLOR_OUTSIDE

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            sphere.Transparency = 1
            return
        end

        if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
        local ball = cachedBall
        local hrpPos = hrp.Position
        
        local dbg_ball = "NO"
        local dbg_dist = 0
        local dbg_time = 999
        local dbg_status = "Safe"
        local targetDiameter = CFG.MAX_RADIUS * 2
        local targetColor = CFG.COLOR_OUTSIDE

        if ball then
            dbg_ball = "YES"
            local bp = ball.Position
            local dist = (hrpPos - bp).Magnitude
            dbg_dist = dist

            -- Перезаряжаем скрипт
            if dist > CFG.PARRY_RADIUS * 2.5 then
                isArmed = true
            end

            if lastBall ~= ball then
                prevPos = bp
                lastBall = ball
            end

            local speed = 0
            local approachSpeed = 0
            
            if prevPos and dt > 0 then
                local moveVec = bp - prevPos
                speed = moveVec.Magnitude / dt
                
                if speed > 1 then 
                    local dirToMe = (hrpPos - bp).Unit
                    local dot = moveVec.Unit:Dot(dirToMe)
                    if dot > 0.5 then 
                        approachSpeed = speed * dot
                    end
                end
            end

            local isTargetingMe = false
            local tVal = ball:GetAttribute("target")
            
            if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then 
                isTargetingMe = true 
            elseif approachSpeed > 1 or (speed > 1 and dist < 50) then
                isTargetingMe = true 
            end

            if isTargetingMe then
                if approachSpeed > 1 then
                    dbg_time = dist / approachSpeed
                end

                dbg_status = "Incoming!"
                
                local targetRadius = math.clamp(dist, CFG.PARRY_RADIUS, CFG.MAX_RADIUS)
                targetDiameter = targetRadius * 2
                
                -- СРАБАТЫВАНИЕ ЗА 0.35 СЕК
                if dbg_time <= CFG.PREDICT_TIME or dist <= CFG.PARRY_RADIUS then
                    executeParry()
                    if not isArmed then
                        dbg_status = "PARRY!"
                        targetColor = CFG.COLOR_INSIDE
                    end
                end
            end
            prevPos = bp
        else
            isArmed = true
        end

        debugText.Text = string.format("Ball: %s\nDist: %.1f\nTime: %s\nArmed: %s\nStatus: %s\nMethod: %s", 
            dbg_ball, dbg_dist, (dbg_time > 900 and "N/A" or string.format("%.2fs", dbg_time)), tostring(isArmed), dbg_status, lastAction)

        if CFG.SPHERE_VISIBLE then
            currentDiameter = currentDiameter + (targetDiameter - currentDiameter) * math.exp(-14 * dt)
            currentColor = currentColor:Lerp(targetColor, math.clamp(14 * dt, 0, 1))
            sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
            sphere.Size = Vector3.new(currentDiameter, currentDiameter, currentDiameter)
            sphere.Transparency = 0.7
            sphere.Color = currentColor
        else
            sphere.Transparency = 1
        end
    end)
end)
