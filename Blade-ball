-- Функции-помощники для UI
local yOffset = 0
local elements = {}

local function addLabel(text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -10, 0, 20)
    l.Position = UDim2.new(0, 5, 0, yOffset)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(220, 220, 220)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.GothamBold
    l.TextSize = 13
    l.Parent = scroll
    yOffset = yOffset + 22
    table.insert(elements, {el=l, prop="TextColor3", colorKey="text"})
end

local function addSlider(labelText, min, max, current, callback)
    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, -10, 0, 45)
    cont.Position = UDim2.new(0, 5, 0, yOffset)
    cont.BackgroundTransparency = 1
    cont.Parent = scroll
    yOffset = yOffset + 48

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 18)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText .. ": " .. current
    lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.Parent = cont
    table.insert(elements, {el=lbl, prop="TextColor3", colorKey="text"})

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.new(0, 5, 0, 30)
    bar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
    bar.BorderSizePixel = 0
    bar.Parent = cont
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    table.insert(elements, {el=bar, prop="BackgroundColor3", colorKey="off"})

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    table.insert(elements, {el=fill, prop="BackgroundColor3", colorKey="accent"})

    -- Для удобного тапа на мобилке сделаем невидимую кнопку поверх
    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 20, 0, 30)
    hit.Position = UDim2.new(0, -10, 0, 15)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = cont

    local dragging = false
    local function updateFromX(x)
        local relX = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * relX)
        fill.Size = UDim2.new(relX, 0, 1, 0)
        lbl.Text = labelText .. ": " .. value
        callback(value)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    hit.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                         or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
end

local function addToggle(labelText, current, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, yOffset)
    btn.BackgroundColor3 = current and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
    btn.Text = labelText .. ": " .. (current and "ВКЛ" or "ВЫКЛ")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    yOffset = yOffset + 42

    local state = current
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = labelText .. ": " .. (state and "ВКЛ" or "ВЫКЛ")
        btn.BackgroundColor3 = state and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
        callback(state)
    end)
end

local function addThemeSelector()
    addLabel("🎨 Тема")
    local themes = {"Dark", "Light", "Matrix", "Cyber"}
    local cont = Instance.new("Frame")
    cont.Size = UDim2.new(1, -10, 0, 35)
    cont.Position = UDim2.new(0, 5, 0, yOffset)
    cont.BackgroundTransparency = 1
    cont.Parent = scroll
    yOffset = yOffset + 42

    local btns = {}
    for i, themeName in ipairs(themes) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.24, -4, 1, 0)
        b.Position = UDim2.new((i-1) * 0.25, 0, 0, 0)
        b.BackgroundColor3 = (CFG.THEME == themeName) and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(60, 60, 75)
        b.Text = themeName
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.BorderSizePixel = 0
        b.Parent = cont
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
        table.insert(btns, {btn = b, name = themeName})
    end

    for _, data in ipairs(btns) do
        data.btn.MouseButton1Click:Connect(function()
            CFG.THEME = data.name
            for _, d in ipairs(btns) do
                d.btn.BackgroundColor3 = (d.name == data.name) and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(60, 60, 75)
            end
            applyTheme()
        end)
    end
end

local function applyTheme()
    local t = THEMES[CFG.THEME] or THEMES.Dark
    mainFrame.BackgroundColor3 = t.bg
    header.BackgroundColor3 = t.header
    title.TextColor3 = t.text
    for _, item in ipairs(elements) do
        item.el[item.prop] = t[item.colorKey]
    end
end

