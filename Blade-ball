    ╔═══════════════════════════════════════════════════════════════════════╗
    ║   BLADE BALL — FRAME-PERFECT PARRY                                    ║
    ║   • Вычисляет скорость мяча по разнице координат (игнорирует баги)    ║
    ║   • Предсказывает удар с учетом пинга                                 ║
    ║   • Защита от спама и бана                                            ║
    ╚═══════════════════════════════════════════════════════════════════════╝
]]

print("⏳ [BB] Запуск...")

local CFG = {
    PARRY_RADIUS        = 25,        -- Зона парирования
    MAX_RADIUS          = 35,        -- Размер сферы
    PARRY_COOLDOWN      = 0.30,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
    
    PING_SAFETY         = 0.08,      -- Запас на пинг (80 мс)
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats             = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 15)

-- 1. ПИНГ
local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function() 
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 
        end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- 2. REMOTE
local parryRemote = nil
task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                parryRemote = obj
                print("✅ [BB] Найден Remote: " .. obj.Name)
                break
            end
        end
    end
end)

-- 3. СФЕРА (В WORKSPACE)
local sphere = Instance.new("Part")
sphere.Name = "AuraVisual"
sphere.Shape = Enum.PartType.Ball
sphere.Anchored = true
sphere.CanCollide = false
sphere.CanTouch = false
sphere.CanQuery = false
sphere.CastShadow = false
sphere.Massless = true
sphere.Material = Enum.Material.ForceField
sphere.Color = CFG.COLOR_OUTSIDE
sphere.Transparency = 1
sphere.Size = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent = Workspace

-- 4. МЯЧ
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (o:GetAttribute("realBall") or n:find("ball")) and not n:find("explosion") then return o end
        end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then cachedBall = o end
end)
Workspace.ChildRemoved:Connect(function(o) if o == cachedBall then cachedBall = nil end end)

-- 5. ПАРИРОВАНИЕ
local armed = true
local lastParry = 0
local lastAction = "None"

local function executeParry()
    if not CFG.PARRY_ENABLED or not parryRemote then return end
    pcall(function() parryRemote:FireServer() end)
    lastAction = "Fired (Ping: " .. math.floor(pingCache * 1000) .. "ms)"
    lastParry = tick()
end

-- 6. ОТЛАДЧИК
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BBDebug"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local debugText = Instance.new("TextLabel")
debugText.Size = UDim2.new(0, 250, 0, 120)
debugText.Position = UDim2.new(0, 10, 0, 60) 
debugText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
debugText.BackgroundTransparency = 0.5
debugText.TextColor3 = Color3.fromRGB(0, 255, 0)
debugText.Font = Enum.Font.Code
debugText.TextSize = 12
debugText.TextXAlignment = Enum.TextXAlignment.Left
debugText.TextYAlignment = Enum.TextYAlignment.Top
debugText.Text = "Загрузка..."
debugText.Parent = screenGui

-- 7. МЕНЮ
local menuGui = Instance.new("ScreenGui")
menuGui.Name = "BBMenu"
menuGui.ResetOnSpawn = false
menuGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local menuBtn = Instance.new("TextButton")
menuBtn.Size = UDim2.new(0, 60, 0, 60)
menuBtn.Position = UDim2.new(1, -80, 1, -80) 
menuBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
menuBtn.Text = "MENU"
menuBtn.TextColor3 = Color3.new(1,1,1)
menuBtn.Font = Enum.Font.GothamBold
menuBtn.Parent = menuGui
Instance.new("UICorner", menuBtn).CornerRadius = UDim.new(1, 0)

local menuFrame = Instance.new("Frame")
menuFrame.Size = UDim2.new(0, 250, 0, 200)
menuFrame.Position = UDim2.new(1, -270, 1, -300)
menuFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
menuFrame.Visible = false
menuFrame.Parent = menuGui
Instance.new("UICorner", menuFrame).CornerRadius = UDim.new(0, 10)

local closeMenu = Instance.new("TextButton")
closeMenu.Size = UDim2.new(0, 30, 0, 30)
closeMenu.Position = UDim2.new(1, -35, 0, 5)
closeMenu.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
closeMenu.Text = "X"
closeMenu.TextColor3 = Color3.new(1,1,1)
closeMenu.Parent = menuFrame
Instance.new("UICorner", closeMenu).CornerRadius = UDim.new(0, 6)

local parryToggle = Instance.new("TextButton")
parryToggle.Size = UDim2.new(1, -20, 0, 40)
parryToggle.Position = UDim2.new(0, 10, 0, 50)
parryToggle.BackgroundColor3 = Color3.fromRGB(60, 180, 100)
parryToggle.Text = "Парирование: ВКЛ"
parryToggle.TextColor3 = Color3.new(1,1,1)
parryToggle.Font = Enum.Font.GothamBold
parryToggle.Parent = menuFrame
Instance.new("UICorner", parryToggle).CornerRadius = UDim.new(0, 6)

parryToggle.MouseButton1Click:Connect(function()
    CFG.PARRY_ENABLED = not CFG.PARRY_ENABLED
    parryToggle.Text = "Парирование: " .. (CFG.PARRY_ENABLED and "ВКЛ" or "ВЫКЛ")
    parryToggle.BackgroundColor3 = CFG.PARRY_ENABLED and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
end)
menuBtn.MouseButton1Click:Connect(function() menuFrame.Visible = not menuFrame.Visible end)
closeMenu.MouseButton1Click:Connect(function() menuFrame.Visible = false end)

-- 8. ГЛАВНЫЙ ЦИКЛ
local state = { diameter = CFG.MAX_RADIUS * 2, color = CFG.COLOR_OUTSIDE, lastFlash = 0 }
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

local lastBall = nil
local prevBallPos = nil

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtColor = CFG.COLOR_OUTSIDE
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_approach = 0
    local dbg_time = 999

    if ball then
        dbg_ball = "YES"
        local ballPos = ball.Position
        local dist = (hrpPos - ballPos).Magnitude
        dbg_dist = dist
        
        -- Сброс при появлении нового мяча
        if lastBall ~= ball then
            prevBallPos = ballPos
            lastBall = ball
            armed = true
        end
        
        -- ВЫЧИСЛЕНИЕ СКОРОСТИ ЧЕРЕЗ РАЗНИЦУ КООРДИНАТ (Работает всегда)
        local approach = 0
        if prevBallPos and dt > 0 then
            local moveVec = ballPos - prevBallPos
            local speed = moveVec.Magnitude / dt
            
            -- Если мяч реально летит (скорость > 5)
            if speed > 5 then
                local dirToMe = (hrpPos - ballPos).Unit
                approach = moveVec:Dot(dirToMe) / dt
            end
        end
        prevBallPos = ballPos
        dbg_approach = approach

        -- Время до удара
        if approach > 1 then
            dbg_time = dist / approach
        end

        -- Проверка цели
        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then 
            targeting = true 
        elseif Character:FindFirstChild("Highlight") then 
            targeting = true 
        elseif approach > 10 and dist < 80 then 
            targeting = true 
        end

        -- Логика парирования
        if targeting then
            local targetRadius = math.clamp(dist, CFG.PARRY_RADIUS, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (dist <= CFG.PARRY_RADIUS) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            local pingDelay = pingCache + CFG.PING_SAFETY
            local timeInsideZone = (dist - CFG.PARRY_RADIUS) / math.max(approach, 1)
            
            local isInside = dist <= CFG.PARRY_RADIUS
            local willBeInside = (approach > 0) and (timeInsideZone <= pingDelay)
            
            if (isInside or willBeInside) and armed then
                executeParry()
                armed = false 
                state.lastFlash = tick()
            end
        end
    end

    -- Перезарядка, если мяч улетел
    if ball and (hrpPos - ball.Position).Magnitude > CFG.PARRY_RADIUS * 3 then
        armed = true
    end
    if not ball then armed = true end

    -- Отладчик
    debugText.Text = string.format(
        "Ball: %s\nDist: %.1f\nAppr: %.1f\nTime: %s\nArmed: %s\nMethod: %s", 
        dbg_ball, dbg_dist, dbg_approach, 
        (dbg_time > 900 and "N/A" or string.format("%.2fs", dbg_time)), 
        tostring(armed), lastAction)

    -- Визуал
    state.diameter = damp(state.diameter, tgtDiameter, 14, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(14 * dt))

    if CFG.SPHERE_VISIBLE and sphere.Parent then
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
        sphere.Transparency = 0.7
        sphere.Color = finalColor
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP = newChar:WaitForChild("HumanoidRootPart", 15)
    cachedBall = nil
    lastBall = nil
    prevBallPos = nil
end)
