if PlayerGui:FindFirstChild("BBDebug") then PlayerGui.BBDebug:Destroy() end
if PlayerGui:FindFirstChild("BBMenu") then PlayerGui.BBMenu:Destroy() end
if Workspace:FindFirstChild("VisualEffect") then Workspace.VisualEffect:Destroy() end

local CFG = {
    -- НАСТРОЙКИ 3-Х ПОЗИЦИЙ (Скорость мяча и соответствующая зона парирования)
    MIN_SPEED           = 50,        -- Медленный мяч (стабсов/сек)
    MIN_ZONE            = 20,        -- Зона для медленного мяча

    MID_SPEED           = 125,       -- Средняя скорость (стабсов/сек)
    MID_ZONE            = 45,        -- Зона для среднего мяча (НОВАЯ ПОЗИЦИЯ)

    MAX_SPEED           = 200,       -- Быстрый мяч (стабсов/сек)
    MAX_ZONE            = 80,        -- Зона для быстрого мяча

    PARRY_COOLDOWN      = 0.25,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,      
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

-- 1. СФЕРА
