-- 4. ПОИСК МЯЧА
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then
        if not cachedBall then cachedBall = o end
    end
end)

-- 5. ПАРИРОВАНИЕ
local lastParry = 0
local lastAction = "None"
local isArmed = true

local function executeParry()
    if not CFG.PARRY_ENABLED then return end
    if not isArmed then return end
    if tick() - lastParry < CFG.PARRY_COOLDOWN then return end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)

    lastAction = "Key F"
    lastParry = tick()
    isArmed = false
end

-- 6. ФУНКЦИЯ РАСЧЕТА 3-Х ПОЗИЦИЙ
local function getDynamicZone(speed)
    if speed <= CFG.MIN_SPEED then
        return CFG.MIN_ZONE
    elseif speed <= CFG.MID_SPEED then
        -- Плавный переход от MIN к MID
        local alpha = (speed - CFG.MIN_SPEED) / (CFG.MID_SPEED - CFG.MIN_SPEED)
        return CFG.MIN_ZONE + (CFG.MID_ZONE - CFG.MIN_ZONE) * alpha
    elseif speed <= CFG.MAX_SPEED then
        -- Плавный переход от MID к MAX
        local alpha = (speed - CFG.MID_SPEED) / (CFG.MAX_SPEED - CFG.MID_SPEED)
        return CFG.MID_ZONE + (CFG.MAX_ZONE - CFG.MID_ZONE) * alpha
    else
        return CFG.MAX_ZONE
    end
end

-- 7. ЦИКЛ
local lastBall = nil
local prevPos = nil
local currentDiameter = CFG.MIN_ZONE * 2
local currentColor = CFG.COLOR_OUTSIDE

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            sphere.Transparency = 1
            return
        end

        if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
        local ball = cachedBall
        local hrpPos = hrp.Position
        
        local dbg_ball = "NO"
        local dbg_dist = 0
        local dbg_speed = 0
        local dbg_trigger = 0
        local dbg_status = "Safe"
        local targetDiameter = CFG.MIN_ZONE * 2
        local targetColor = CFG.COLOR_OUTSIDE

        if ball then
            dbg_ball = "YES"
            local bp = ball.Position
            local dist = (hrpPos - bp).Magnitude
            dbg_dist = dist

            if lastBall ~= ball then
                prevPos = bp
                lastBall = ball
                isArmed = true 
            end

            if dist > CFG.MAX_ZONE * 1.5 then
                isArmed = true
            end

            local speed = 0
            local approachSpeed = 0
            
            if prevPos and dt > 0 then
                local moveVec = bp - prevPos
                speed = moveVec.Magnitude / dt
                
                if speed > 1 then 
                    local dirToMe = (hrpPos - bp).Unit
                    local dot = moveVec.Unit:Dot(dirToMe)
                    if dot > 0.5 then 
                        approachSpeed = speed * dot
                    end
                end
            end
            
            dbg_speed = speed

            local isTargetingMe = false
            local tVal = ball:GetAttribute("target")
            
            if tVal and (tostring(tVal):find(LocalPlayer.Name) or tVal == LocalPlayer) then 
                isTargetingMe = true 
            elseif approachSpeed > 5 or (speed > 10 and dist < 100) then
                isTargetingMe = true 
            end

            if isTargetingMe then
                -- ПОЛУЧАЕМ ЗОНУ ПО ТРЕМ ПОЗИЦИЯМ
                local dynamicTriggerDist = getDynamicZone(speed)
                dbg_trigger = dynamicTriggerDist

                dbg_status = "Incoming!"
                targetDiameter = dynamicTriggerDist * 2
                
                if dist <= dynamicTriggerDist then
                    executeParry()
                    if not isArmed then
                        dbg_status = "PARRY!"
                        targetColor = CFG.COLOR_INSIDE
                    end
                end
            end
            prevPos = bp
        else
            isArmed = true
            lastBall = nil
            prevPos = nil
        end

        debugText.Text = string.format("Ball: %s\nDist: %.1f\nSpeed: %.1f\nZone: %.1f\nArmed: %s\nStatus: %s\nMethod: %s", 
            dbg_ball, dbg_dist, dbg_speed, dbg_trigger, tostring(isArmed), dbg_status, lastAction)

        if CFG.SPHERE_VISIBLE then
            currentDiameter = currentDiameter + (targetDiameter - currentDiameter) * math.exp(-14 * dt)
            currentColor = currentColor:Lerp(targetColor, math.clamp(14 * dt, 0, 1))
            
            sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
            sphere.Size = Vector3.new(currentDiameter, currentDiameter, currentDiameter)
            sphere.Transparency = 0.7
            sphere.Color = currentColor
        else
            sphere.Transparency = 1
        end
    end)
end)
