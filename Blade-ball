ApplyTheme = function()
    Window.BackgroundColor3 = CurrentTheme.BG
    Header.BackgroundColor3 = CurrentTheme.HEADER
    HeaderMask.BackgroundColor3 = CurrentTheme.HEADER
    WinStroke.Color = CurrentTheme.ACCENT
    Title.TextColor3 = CurrentTheme.ACCENT
    BtnStroke.Color = CurrentTheme.ACCENT
    ToggleBtn.TextColor3 = CurrentTheme.ACCENT
    ThemePanel.BackgroundColor3 = CurrentTheme.BG
    PanelStroke.Color = CurrentTheme.ACCENT
    DebugFrame.BackgroundColor3 = CurrentTheme.BG
    DebugStroke.Color = CurrentTheme.ACCENT
    Pages.ScrollBarImageColor3 = CurrentTheme.ACCENT
    
    for _, t in ipairs(TabsList) do
        if t.Page.Visible then
            t.Btn.BackgroundColor3 = CurrentTheme.ACCENT
            t.Btn.TextColor3 = CurrentTheme.BG
        else
            t.Btn.BackgroundColor3 = CurrentTheme.OFF
            t.Btn.TextColor3 = CurrentTheme.TEXT
        end
    end
    
    for _, el in ipairs(UI_Elements) do
        if el.type == "label" then
            el.btn.TextColor3 = CurrentTheme.TEXT
        elseif el.type == "button" then
            el.btn.BackgroundColor3 = CurrentTheme.OFF
            el.btn.TextColor3 = CurrentTheme.TEXT
        elseif el.type == "switch" then
            el.btn.BackgroundColor3 = el.state and CurrentTheme.ACCENT or CurrentTheme.OFF
        elseif el.type == "ascii" then
            el.btn.BackgroundColor3 = el.state and CurrentTheme.ACCENT or CurrentTheme.OFF
            el.btn.TextColor3 = el.state and CurrentTheme.BG or CurrentTheme.TEXT
        end
    end
end

