print("⏳ [BB] Запуск...")

local CFG = {
    PARRY_RADIUS        = 20,        -- Увеличено (запас времени)
    MAX_RADIUS          = 30,        -- Увеличено
    PARRY_COOLDOWN      = 0.20,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
    
    PING_SAFETY         = 0.06,      -- Дополнительный запас (60 мс)
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
