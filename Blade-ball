--[[
    ╔═══════════════════════════════════════════════════════════════════════╗
    ║   BLADE BALL — STEALTH UI SPHERE (ANTI-BAN)                           ║
    ║   • Сфера рисуется в PlayerGui (сервер её НЕ ВИДИТ)                   ║
    ║   • Авто-поиск RemoteEvent для парирования (без VirtualInputManager)  ║
    ║   • Человеческая задержка реакции (имитация живого игрока)            ║
    ║   • Красивый светящийся интерфейс вместо 3D-модели                    ║
    ╚═══════════════════════════════════════════════════════════════════════╝
]]

local CFG = {
    -- ─── Настройки парирования ─────────────────────────────
    MIN_PARRY_DIAMETER  = 20,        -- Мин. диаметр (на низкой скорости мяча)
    MAX_PARRY_DIAMETER  = 35,        -- Макс. диаметр (на высокой скорости)
    MIN_SPEED_THRESH    = 50,        
    MAX_SPEED_THRESH    = 200,       
    PARRY_COOLDOWN      = 0.2,       

    -- ─── Визуал ────────────────────────────────────────────
    MAX_RADIUS          = 25,        -- Максимальный радиус сферы (50 диаметр)
    Y_OFFSET            = -0.5,      -- Высота сферы (пояс)
    PIXELS_PER_STUD     = 12,        -- Масштаб интерфейса (настрой под свое разрешение)
    
    -- ─── Безопасность ──────────────────────────────────────
    HUMAN_DELAY_MIN     = 0.04,      -- Мин. задержка реакции (сек)
    HUMAN_DELAY_MAX     = 0.12,      -- Макс. задержка реакции (сек)

    -- ─── Цвета ─────────────────────────────────────────────
    COLOR_INSIDE  = Color3.fromRGB(255, 30, 30),    -- Красный (опасность)
    COLOR_OUTSIDE = Color3.fromRGB(30, 255, 50),    -- Зеленый (безопасно)
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 10)

-- ============================================================
-- 1. БЕЗОПАСНАЯ СФЕРА (В ИНТЕРФЕЙСЕ)
-- ============================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ParryVisual"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local sphereGui = Instance.new("Frame")
sphereGui.Name = "Sphere"
sphereGui.AnchorPoint = Vector2.new(0.5, 0.5)
sphereGui.BackgroundTransparency = 0.5
sphereGui.BackgroundColor3 = CFG.COLOR_OUTSIDE
sphereGui.BorderSizePixel = 0
sphereGui.Parent = screenGui

-- Делаем круг идеально ровным
local uicorner = Instance.new("UICorner")
uicorner.CornerRadius = UDim.new(0.5, 0)
uicorner.Parent = sphereGui

-- Свечение по краям (обводка)
local uistroke = Instance.new("UIStroke")
uistroke.Color = CFG.COLOR_OUTSIDE
uistroke.Thickness = 3
uistroke.Transparency = 0.2
uistroke.Parent = sphereGui

-- ============================================================
-- 2. ПОИСК REMOTE ДЛЯ ПАРИРОВАНИЯ (Без VIM)
-- ============================================================
local parryRemote = nil
local function findParryRemote()
    local searchRoots = {ReplicatedStorage, Workspace, LocalPlayer}
    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                    return obj
                end
            end
        end
    end
end
parryRemote = findParryRemote()

local lastParry = 0
local function fireParry()
    local now = tick()
    if now - lastParry >= CFG.PARRY_COOLDOWN then
        lastParry = now
        
        -- Имитация человеческой реакции
        task.spawn(function()
            local delay = CFG.HUMAN_DELAY_MIN + math.random() * (CFG.HUMAN_DELAY_MAX - CFG.HUMAN_DELAY_MIN)
            task.wait(delay)
            
            if parryRemote then
                -- Безопасный вызов RemoteEvent
                pcall(function()
                    if parryRemote:IsA("RemoteEvent") then
                        parryRemote:FireServer()
                    else
                        parryRemote:InvokeServer()
                    end
                end)
            else
                -- Fallback: эмуляция F (если Remote не найден)
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(math.random(20, 50) / 1000)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end)
            end
        end)
    end
end

-- ============================================================
-- 3. ПОИСК МЯЧА
-- ============================================================
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o.Name:lower() == "ball" then return o end
    end
end
cachedBall = findBall()

Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then
        if not cachedBall then cachedBall = o end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ============================================================
-- 4. ГЛАВНЫЙ ЦИКЛ (RenderStepped для UI)
-- ============================================================
local currentRadius = CFG.MAX_RADIUS

RunService.RenderStepped:Connect(function()
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then 
        sphereGui.Visible = false
        return 
    end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphereGui.Visible = false
        return
    end
    sphereGui.Visible = true

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local ball = cachedBall
    local hrpPos = HRP.Position
    local cam = Workspace.CurrentCamera

    local targetRadius = CFG.MAX_RADIUS
    local targetColor = CFG.COLOR_OUTSIDE

    if ball then
        local dist = (hrpPos - ball.Position).Magnitude
        local speed = ball.AssemblyLinearVelocity.Magnitude
        
        -- Адаптивный диаметр парирования
        local speedFactor = math.clamp((speed - CFG.MIN_SPEED_THRESH) / (CFG.MAX_SPEED_THRESH - CFG.MIN_SPEED_THRESH), 0, 1)
        local parryDiameter = CFG.MIN_PARRY_DIAMETER + (CFG.MAX_PARRY_DIAMETER - CFG.MIN_PARRY_DIAMETER) * speedFactor
        local parryRadius = parryDiameter / 2

        -- Проверка цели
        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target") or ball:GetAttribute("targetPlayer")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name or tVal == LocalPlayer) then
            targeting = true
        elseif Character:FindFirstChild("Highlight") then
            targeting = true
        elseif speed > 5 and ball.AssemblyLinearVelocity:Dot((hrpPos - ball.Position).Unit) > 10 and dist < 40 then
            targeting = true
        end

        if targeting then
            targetRadius = math.clamp(dist, parryRadius, CFG.MAX_RADIUS)
            
            if dist <= parryRadius then
                targetColor = CFG.COLOR_INSIDE
                fireParry()
            end
        end
    end

    -- Плавное изменение радиуса
    currentRadius = currentRadius + (targetRadius - currentRadius) * 0.2
    
    -- Перевод 3D позиции в 2D экран
    local worldPos = hrpPos + Vector3.new(0, CFG.Y_OFFSET, 0)
    local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
    
    if onScreen then
        sphereGui.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
        
        -- Перевод стабсов в пиксели
        local pixelSize = (currentRadius * 2) * CFG.PIXELS_PER_STUD
        sphereGui.Size = UDim2.new(0, pixelSize, 0, pixelSize)
    end
    
    -- Плавная смена цвета
    sphereGui.BackgroundColor3 = sphereGui.BackgroundColor3:Lerp(targetColor, 0.2)
    uistroke.Color = sphereGui.BackgroundColor3
end)

print("[Stealth] Активировано! Сфера в UI. Метод ввода: " .. (parryRemote and ("Remote (" .. parryRemote.Name .. ")") or "F (fallback)"))
