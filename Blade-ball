--[[
    ╔═══════════════════════════════════════════════════════════╗
    ║  BLADE BALL — CLEAN PARRY SPHERE                          ║
    ║  • Динамическая сфера: сжимается / бледнеет с приближением ║
    ║  • Пульсация + покачивание для «живого» эффекта           ║
    ║  • Мгновенное парирование (радиус ×6 от визуала)          ║
    ║  • Чистый ввод: remote → UserInputService → F             ║
    ╚═══════════════════════════════════════════════════════════╝
]]

-- ============================================================
-- 1. НАСТРОЙКИ
-- ============================================================
local CFG = {
    -- Визуал сферы
    NEAR_DIAMETER       = 4,        -- диаметр когда мяч рядом
    FAR_DIAMETER        = 10,       -- диаметр когда мяч далеко
    DISTANCE_FOR_FAR    = 20,       -- дистанция максимума сферы
    NEAR_TRANSPARENCY   = 0.60,     -- 60% в близи (плотная)
    FAR_TRANSPARENCY    = 0.70,     -- 70% в далеке (прозрачная)
    Y_OFFSET            = -0.5,     -- 0 = торс, -0.5 = пояс

    -- Парирование
    PARRY_TRIGGER_MULT  = 6,        -- радиус срабатывания = NEAR_R * это
    PARRY_COOLDOWN      = 0.18,
    REARM_MULTIPLIER    = 1.5,
    EMERGENCY_MULT      = 0.5,
    PARRY_KEY           = Enum.KeyCode.F,

    -- Предиктивка
    PREDICT_FRAMES      = 2,
    MIN_AHEAD           = 0.06,
    MAX_AHEAD           = 0.25,

    -- Сглаживание
    DAMP_LAMBDA         = 14,

    -- Движение сферы
    PULSE_SPEED         = 2.2,      -- скорость пульсации (рад/сек)
    PULSE_SIZE_AMPL     = 0.06,     -- ±6% к диаметру
    PULSE_ALPHA_AMPL     = 0.04,    -- ±0.04 к прозрачности
    BOB_SPEED           = 1.8,      -- скорость покачивания
    BOB_AMPLITUDE       = 0.15,     -- ±0.15 studs
    BRIGHTNESS_PULSE    = 0.10,     -- лёгкая пульсация яркости цвета

    -- Цвета
    COLOR_NEAR = Color3.fromRGB(255, 30, 30),
    COLOR_MID  = Color3.fromRGB(255, 200, 0),
    COLOR_FAR  = Color3.fromRGB(30, 255, 50),

    DEBUG = false,
}

-- ============================================================
-- 2. СЕРВИСЫ (через cloneref — чище для античита)
-- ============================================================
local function svc(name)
    local ok, s = pcall(function() return cloneref(game:GetService(name)) end)
    return ok and s or game:GetService(name)
end

local Players          = svc("Players")
local RunService       = svc("RunService")
local UserInputService = svc("UserInputService")
local Workspace        = svc("Workspace")
local Stats            = svc("Stats")
local ReplicatedStorage = svc("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 10)

local PARRY_RADIUS   = (CFG.NEAR_DIAMETER / 2) * CFG.PARRY_TRIGGER_MULT
local MIN_RADIUS     = CFG.NEAR_DIAMETER / 2

-- ============================================================
-- 3. УТИЛИТЫ
-- ============================================================
local function log(...) if CFG.DEBUG then print("[BB]", ...) end end
local function jitter(base) return base * (0.6 + math.random() * 0.8) end
local function damp(cur, tgt, lambda, dt)
    return tgt + (cur - tgt) * math.exp(-lambda * dt)
end
local function clamp01(x) return math.clamp(x, 0, 1) end

local function gradientColor(t)
    t = clamp01(t)
    if t <= 0.5 then return CFG.COLOR_NEAR:Lerp(CFG.COLOR_MID, t * 2)
    else              return CFG.COLOR_MID:Lerp(CFG.COLOR_FAR, (t - 0.5) * 2) end
end

-- ============================================================
-- 4. ПИНГ
-- ============================================================
local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- ============================================================
-- 5. СФЕРА
-- ============================================================
local sphere = Instance.new("Part")
sphere.Name         = "ParrySphere"
sphere.Shape        = Enum.PartType.Ball
sphere.Anchored     = true
sphere.CanCollide   = false
sphere.CanTouch     = false
sphere.CanQuery     = false
sphere.CastShadow   = false
sphere.Material     = Enum.Material.ForceField
sphere.Color        = CFG.COLOR_FAR
sphere.Transparency = CFG.FAR_TRANSPARENCY
sphere.Size         = Vector3.new(CFG.FAR_DIAMETER, CFG.FAR_DIAMETER, CFG.FAR_DIAMETER)
sphere.Parent       = Workspace

-- ============================================================
-- 6. ДЕТЕКЦИЯ МЯЧА
-- ============================================================
local cachedBall = nil

local function findBall()
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if n:find("ball") or n:find("orb") or n:find("sphere") then return o end
        end
    end
end

cachedBall = findBall()

Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall then
        local n = o.Name:lower()
        if o:GetAttribute("realBall") or n:find("ball") or n:find("orb") then
            cachedBall = o
        end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ============================================================
-- 7. ДЕТЕКТ ЦЕЛИ
-- ============================================================
local TARGET_KEYS = {
    "target", "Target", "targetPlayer", "TargetPlayer",
    "player", "Player", "Targeted", "targeted",
}

local function isTargetingMe(ball)
    if not ball then return false end
    for _, k in ipairs(TARGET_KEYS) do
        local v = ball:GetAttribute(k)
        if v and (v == LocalPlayer.Name
                  or v == LocalPlayer.UserId
                  or tostring(v) == LocalPlayer.Name) then
            return true
        end
    end
    return Character and Character:FindFirstChild("Highlight") ~= nil
end

-- ============================================================
-- 8. ПАРИРОВАНИЕ (чистый ввод)
-- ============================================================
local parryRemote = nil
local function findParryRemote()
    local ok, found = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("parry") or n:find("block") or n:find("deflect") then
                    return obj
                end
            end
        end
    end)
    return ok and found or nil
end
parryRemote = findParryRemote()

local function sendParryOnce()
    if parryRemote then
        pcall(function()
            if parryRemote:IsA("RemoteEvent") then
                parryRemote:FireServer()
            else
                parryRemote:InvokeServer()
            end
        end)
        return
    end
    pcall(function()
        UserInputService:SendKeyEvent(true,  CFG.PARRY_KEY, false, game)
        task.wait(jitter(0.02))
        UserInputService:SendKeyEvent(false, CFG.PARRY_KEY, false, game)
    end)
end

local burstActive = false
local function fireParry()
    if burstActive then return end
    burstActive = true
    task.spawn(function()
        local count = math.random(1, 2)
        for i = 1, count do
            sendParryOnce()
            if i < count then task.wait(jitter(0.05)) end
        end
        task.wait(jitter(0.03))
        burstActive = false
    end)
end

-- ============================================================
-- 9. ВИЗУАЛ СФЕРЫ
-- ============================================================
local lastState = {
    pos    = Vector3.new(),
    size   = -1,
    alpha  = -1,
    color  = Color3.new(),
}

local function applySphere(center, diameter, transparency, color)
    local moved     = (center - lastState.pos).Magnitude > 0.005
    local resized   = math.abs(diameter - lastState.size) > 0.005
    local transed   = math.abs(transparency - lastState.alpha) > 0.003
    local recolored = (color.R - lastState.color.R)^2
                    + (color.G - lastState.color.G)^2
                    + (color.B - lastState.color.B)^2 > 0.0001
    if not (moved or resized or transed or recolored) then return end

    lastState.pos, lastState.size, lastState.alpha, lastState.color =
        center, diameter, transparency, color

    sphere.CFrame       = CFrame.new(center)
    sphere.Size         = Vector3.new(diameter, diameter, diameter)
    sphere.Transparency = transparency
    sphere.Color        = color
end

-- ============================================================
-- 10. ГЛАВНЫЙ ЦИКЛ
-- ============================================================
local state = {
    diameter     = CFG.FAR_DIAMETER,
    transparency = CFG.FAR_TRANSPARENCY,
    color        = CFG.COLOR_FAR,
    lastParry    = 0,
    lastFlash    = 0,
    armed        = true,
    prevDist     = math.huge,
    phase        = 0,
}

local function mainTick(dt)
    -- Ре-валидация персонажа
    if not Character or not Character.Parent then
        Character = LocalPlayer.Character
    end
    if not HRP or not HRP.Parent then
        HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    end
    if not HRP then return end

    if not cachedBall or not cachedBall.Parent then
        cachedBall = findBall()
    end

    local hrpPos = HRP.Position
    local ball   = cachedBall

    -- Значения по умолчанию (нет угрозы)
    local tgtDiameter     = CFG.FAR_DIAMETER
    local tgtTransparency = CFG.FAR_TRANSPARENCY
    local tgtColor        = CFG.COLOR_FAR
    local doParry         = false

    if ball then
        local targeting = isTargetingMe(ball)
        local dist      = (hrpPos - ball.Position).Magnitude

        -- Аварийный детект: мяч рядом, но target-атрибут не подтвердил
        if not targeting and dist < PARRY_RADIUS * CFG.EMERGENCY_MULT then
            targeting = true
        end

        if targeting then
            local u = clamp01(dist / CFG.DISTANCE_FOR_FAR)

            tgtDiameter     = CFG.NEAR_DIAMETER + (CFG.FAR_DIAMETER - CFG.NEAR_DIAMETER) * u
            tgtTransparency = CFG.NEAR_TRANSPARENCY
                            + (CFG.FAR_TRANSPARENCY - CFG.NEAR_TRANSPARENCY) * u
            tgtColor        = gradientColor(u)

            -- Перевзвод
            if dist > PARRY_RADIUS * CFG.REARM_MULTIPLIER then
                state.armed = true
            end

            if state.armed then
                if dist <= PARRY_RADIUS then
                    doParry = true
                end
                if not doParry and state.prevDist > PARRY_RADIUS and dist <= PARRY_RADIUS then
                    doParry = true
                end
                if not doParry then
                    local bv = ball.AssemblyLinearVelocity
                    if bv.Magnitude < 0.5 then bv = ball.Velocity end
                    if bv.Magnitude > 1 then
                        local dir      = (hrpPos - ball.Position).Unit
                        local approach = bv:Dot(dir)
                        if approach > 0 then
                            local horizon = math.clamp(pingCache + CFG.PREDICT_FRAMES / 60,
                                                        CFG.MIN_AHEAD, CFG.MAX_AHEAD)
                            if (dist - PARRY_RADIUS) / approach <= horizon then
                                doParry = true
                            end
                        end
                    end
                end
            end
            state.prevDist = dist
        else
            state.armed    = true
            state.prevDist = math.huge
        end
    else
        state.armed    = true
        state.prevDist = math.huge
    end

    -- Триггер парирования
    if doParry then
        local now = tick()
        if now - state.lastParry >= CFG.PARRY_COOLDOWN then
            fireParry()
            state.lastParry = now
            state.lastFlash = now
            state.armed     = false
        end
    end

    -- Сглаживание базовых параметров
    state.diameter     = damp(state.diameter,     tgtDiameter,     CFG.DAMP_LAMBDA, dt)
    state.transparency = damp(state.transparency, tgtTransparency, CFG.DAMP_LAMBDA, dt)
    state.color        = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))

    -- ─── ДВИЖЕНИЕ СФЕРЫ ────────────────────────────────
    state.phase = state.phase + dt * CFG.PULSE_SPEED
    local pulse  = math.sin(state.phase)
    local pulse2 = math.sin(state.phase * 0.7)        -- покачивание медленнее

    local finalDiameter = state.diameter * (1 + pulse * CFG.PULSE_SIZE_AMPL)
    local finalTrans    = math.clamp(
        state.transparency + pulse * CFG.PULSE_ALPHA_AMPL, 0, 0.95)

    -- Лёгкая пульсация яркости (умножаем RGB, не трогая hue)
    local brightMul = 1 + pulse * CFG.BRIGHTNESS_PULSE
    local finalColor = Color3.new(
        math.clamp(state.color.R * brightMul, 0, 1),
        math.clamp(state.color.G * brightMul, 0, 1),
        math.clamp(state.color.B * brightMul, 0, 1)
    )

    -- Белая вспышка при парировании перекрывает всё
    if tick() - state.lastFlash < 0.12 then
        finalColor = Color3.fromRGB(255, 255, 255)
    end

    -- Покачивание по Y
    local bob = math.sin(state.phase * (CFG.BOB_SPEED / CFG.PULSE_SPEED))
              * CFG.BOB_AMPLITUDE

    local center = Vector3.new(
        hrpPos.X,
        hrpPos.Y + CFG.Y_OFFSET + bob,
        hrpPos.Z
    )

    applySphere(center, finalDiameter, finalTrans, finalColor)

    log(string.format("d=%.2f a=%.2f dist=%s", finalDiameter, finalTrans,
        ball and string.format("%.1f", (hrpPos - ball.Position).Magnitude) or "-"))
end

RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(mainTick, dt)
    if not ok and CFG.DEBUG then warn("[BB] tick:", err) end
end)

-- ============================================================
-- 11. РЕСПАВН
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP       = newChar:WaitForChild("HumanoidRootPart", 10)
    state.armed    = true
    state.prevDist = math.huge
    cachedBall     = nil
    parryRemote    = nil
    task.wait(1)
    parryRemote = findParryRemote()
end)

-- ============================================================
-- 12. СТАРТ
-- ============================================================
if CFG.DEBUG then
    local platform = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
                     and "mobile" or "PC"
    print(string.format(
        "[Blade Ball] sphere mode | remote: %s | platform: %s | parry_radius: %.1f",
        parryRemote and parryRemote:GetFullName() or "none",
        platform, PARRY_RADIUS))
end
