--[[
    ╔═══════════════════════════════════════════════════════════════════════╗
    ║   BLADE BALL — STEALTH 3D SPHERE (EARLY PARRY)                        ║
    ║   • Сфера в 3D, но привязана к Camera (сервер её НЕ ВИДИТ)            ║
    ║   • Увеличенный радиус парирования (срабатывает заранее)              ║
    ║   • Высокая прозрачность (не мешает обзору)                           ║
    ╚═══════════════════════════════════════════════════════════════════════╝
]]

local CFG = {
    -- ─── Настройки парирования (УВЕЛИЧЕНЫ) ─────────────────
    MIN_PARRY_DIAMETER  = 35,        -- Мин. диаметр (срабатывает заранее)
    MAX_PARRY_DIAMETER  = 55,        -- Макс. диаметр (для очень быстрых мячей)
    MIN_SPEED_THRESH    = 50,        
    MAX_SPEED_THRESH    = 200,       
    PARRY_COOLDOWN      = 0.2,       

    -- ─── Визуал сферы ──────────────────────────────────────
    MAX_RADIUS          = 25,        -- Максимальный радиус (50 диаметр)
    NEAR_TRANSPARENCY   = 0.65,      -- Прозрачность в близи (было 0.6)
    FAR_TRANSPARENCY    = 0.85,      -- Прозрачность в далеке (было 0.7, теперь почти невидима)
    Y_OFFSET            = -0.5,      -- Высота сферы (пояс)

    -- ─── Безопасность и Предиктивка ────────────────────────
    HUMAN_DELAY_MIN     = 0.02,      -- Задержка реакции (сделали меньше, чтобы не опаздывать)
    HUMAN_DELAY_MAX     = 0.08,      
    PREDICT_FRAMES      = 3,         -- Увеличено для раннего срабатывания
    MIN_AHEAD           = 0.10,      -- Увеличено
    MAX_AHEAD           = 0.30,      -- Увеличено

    -- ─── Цвета ─────────────────────────────────────────────
    COLOR_INSIDE  = Color3.fromRGB(255, 30, 30),    -- Красный (опасность)
    COLOR_OUTSIDE = Color3.fromRGB(30, 255, 50),    -- Зеленый (безопасно)
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Stats             = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 10)

-- Кэш пинга
local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- ============================================================
-- 1. 3D СФЕРА (Привязана к Камере = Локальная)
-- ============================================================
local sphere = Instance.new("Part")
sphere.Name         = "StealthSphere"
sphere.Shape        = Enum.PartType.Ball
sphere.Anchored     = true
sphere.CanCollide   = false
sphere.CanTouch     = false
sphere.CanQuery     = false
sphere.CastShadow   = false
sphere.Material     = Enum.Material.ForceField
sphere.Color        = CFG.COLOR_OUTSIDE
sphere.Transparency = CFG.FAR_TRANSPARENCY
sphere.Size         = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
-- ВАЖНО: Родитель - Camera. Сервер и другие игроки её не видят!
sphere.Parent       = Workspace.CurrentCamera 

-- ============================================================
-- 2. ПОИСК REMOTE ДЛЯ ПАРИРОВАНИЯ
-- ============================================================
local parryRemote = nil
local function findParryRemote()
    local searchRoots = {ReplicatedStorage, Workspace, LocalPlayer}
    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                    return obj
                end
            end
        end
    end
end
parryRemote = findParryRemote()

local lastParry = 0
local function fireParry()
    local now = tick()
    if now - lastParry >= CFG.PARRY_COOLDOWN then
        lastParry = now
        task.spawn(function()
            local delay = CFG.HUMAN_DELAY_MIN + math.random() * (CFG.HUMAN_DELAY_MAX - CFG.HUMAN_DELAY_MIN)
            task.wait(delay)
            
            if parryRemote then
                pcall(function()
                    if parryRemote:IsA("RemoteEvent") then parryRemote:FireServer()
                    else parryRemote:InvokeServer() end
                end)
            else
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(math.random(20, 50) / 1000)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end)
            end
        end)
    end
end

-- ============================================================
-- 3. ПОИСК МЯЧА
-- ============================================================
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
end
cachedBall = findBall()

Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then
        if not cachedBall then cachedBall = o end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ============================================================
-- 4. ГЛАВНЫЙ ЦИКЛ (Heartbeat = максимально часто)
-- ============================================================
local currentRadius = CFG.MAX_RADIUS
local currentColor = CFG.COLOR_OUTSIDE

local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then 
        sphere.Transparency = 1
        return 
    end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local ball = cachedBall
    local hrpPos = HRP.Position

    local targetRadius = CFG.MAX_RADIUS
    local targetColor = CFG.COLOR_OUTSIDE
    local targetTransparency = CFG.FAR_TRANSPARENCY
    local doParry = false

    if ball then
        local dist = (hrpPos - ball.Position).Magnitude
        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed = bv.Magnitude
        
        local approach = 0
        if speed > 0.5 then
            approach = bv:Dot((hrpPos - ball.Position).Unit)
        end

        -- Динамический радиус парирования (35 - 55)
        local speedFactor = clamp01((speed - CFG.MIN_SPEED_THRESH) / (CFG.MAX_SPEED_THRESH - CFG.MIN_SPEED_THRESH))
        local parryDiameter = CFG.MIN_PARRY_DIAMETER + (CFG.MAX_PARRY_DIAMETER - CFG.MIN_PARRY_DIAMETER) * speedFactor
        local parryRadius = parryDiameter / 2

        -- Проверка цели
        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name or tVal == LocalPlayer) then
            targeting = true
        elseif Character:FindFirstChild("Highlight") then
            targeting = true
        elseif speed > 5 and approach > 10 and dist < 50 then
            targeting = true
        end

        if targeting then
            targetRadius = math.clamp(dist, parryRadius, CFG.MAX_RADIUS)
            
            -- Прозрачность: ближе = плотнее, дальше = прозрачнее
            local u = clamp01((dist - parryRadius) / (CFG.MAX_RADIUS - parryRadius))
            targetTransparency = CFG.NEAR_TRANSPARENCY + (CFG.FAR_TRANSPARENCY - CFG.NEAR_TRANSPARENCY) * u

            if dist <= parryRadius then
                targetColor = CFG.COLOR_INSIDE
                targetTransparency = CFG.NEAR_TRANSPARENCY -- Вспышка плотности при опасности
                doParry = true
            end
            
            -- Предиктивка (срабатывает еще ДО того, как мяч зайдет в зону)
            if not doParry and approach > 0 then
                local horizon = math.clamp(pingCache + CFG.PREDICT_FRAMES / 60, CFG.MIN_AHEAD, CFG.MAX_AHEAD)
                if (dist - parryRadius) / approach <= horizon then 
                    doParry = true 
                    targetColor = CFG.COLOR_INSIDE
                end
            end
        end
    end

    if doParry then
        fireParry()
    end

    -- Сглаживание визуала
    currentRadius = damp(currentRadius, targetRadius, 14, dt)
    currentColor = currentColor:Lerp(targetColor, 0.2)
    
    -- Применяем к 3D-сфере
    sphere.Size = Vector3.new(currentRadius * 2, currentRadius * 2, currentRadius * 2)
    sphere.Color = currentColor
    sphere.Transparency = damp(sphere.Transparency, targetTransparency, 10, dt)
    sphere.CFrame = CFrame.new(hrpPos + Vector3.new(0, CFG.Y_OFFSET, 0))
end)

print("[Stealth 3D] Активировано! Радиус парирования: 17.5 - 27.5 studs.")
