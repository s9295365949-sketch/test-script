    Container.Size = UDim2.new(1, 0, 0, 85)
    Container.BackgroundTransparency = 1
    Container.Parent = parent
    
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundColor3 = initialState and CurrentTheme.ACCENT or CurrentTheme.OFF
    Btn.BackgroundTransparency = initialState and 0.2 or 0.4
    Btn.Text = asciiText
    Btn.TextColor3 = initialState and CurrentTheme.BG or CurrentTheme.TEXT
    Btn.Font = Enum.Font.Code
    Btn.TextSize = 8
    Btn.Parent = Container
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
    
    table.insert(UI_Elements, {btn = Btn, type = "ascii", state = initialState})

    local isClicking = false
    Btn.Activated:Connect(function()
        if isClicking then return end
        isClicking = true; PlayClick()
        initialState = not initialState
        callback(initialState)
        for _, el in ipairs(UI_Elements) do
            if el.btn == Btn then el.state = initialState end
        end
        TweenService:Create(Btn, TweenInfo.new(0.2), {
            BackgroundColor3 = initialState and CurrentTheme.ACCENT or CurrentTheme.OFF,
            BackgroundTransparency = initialState and 0.2 or 0.4,
            TextColor3 = initialState and CurrentTheme.BG or CurrentTheme.TEXT
        }):Play()
        task.wait(0.2); isClicking = false
    end)
end

