-- ============================================================
-- 5. ПОИСК МЯЧА
-- ============================================================
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall and (o:GetAttribute("realBall") or o.Name:lower() == "ball") then cachedBall = o end
end)
Workspace.ChildRemoved:Connect(function(o) if o == cachedBall then cachedBall = nil end end)

-- ============================================================
-- 6. ПАРИРОВАНИЕ
-- ============================================================
local lastParry = 0
local burstActive = false

local function executeParry()
    if burstActive or not CFG.PARRY_ENABLED then return end
    burstActive = true
    task.spawn(function()
        task.wait(CFG.HUMAN_DELAY_MIN + math.random() * (CFG.HUMAN_DELAY_MAX - CFG.HUMAN_DELAY_MIN))
        if parryRemote then
            pcall(function() parryRemote:FireServer() end)
        else
            if not cachedButton or not cachedButton.Parent then cachedButton = findParryButton() end
            if cachedButton then
                local pos = cachedButton.AbsolutePosition
                local size = cachedButton.AbsoluteSize
                local x = pos.X + (size.X / 2)
                local y = pos.Y + (size.Y / 2)
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                end)
            end
        end
        task.wait(0.1)
        burstActive = false
    end)
end

-- ============================================================
-- 7. ГЛАВНЫЙ ЦИКЛ
-- ============================================================
local state = {
    diameter = CFG.MAX_RADIUS * 2,
    transparency = CFG.FAR_TRANSPARENCY,
    color = CFG.COLOR_OUTSIDE,
    lastFlash = 0,
    phase = 0,
}

local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or not CFG.SPHERE_VISIBLE then
        sphere.Transparency = 1
        if not humanoid or humanoid.Health <= 0 then return end
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtTransparency = CFG.FAR_TRANSPARENCY
    local tgtColor = CFG.COLOR_OUTSIDE
    local doParry = false

    if ball then
        local dist = (hrpPos - ball.Position).Magnitude
        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed = bv.Magnitude
        local approach = 0
        if speed > 0.5 then approach = bv:Dot((hrpPos - ball.Position).Unit) end

        local speedFactor = clamp01((speed - CFG.MIN_SPEED_THRESH) / (CFG.MAX_SPEED_THRESH - CFG.MIN_SPEED_THRESH))
        local currentParryDiameter = CFG.MIN_PARRY_DIAMETER + (CFG.MAX_PARRY_DIAMETER - CFG.MIN_PARRY_DIAMETER) * speedFactor
        local currentParryRadius = currentParryDiameter / 2

        local targeting = false
        local tVal = ball:GetAttribute("target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then targeting = true
        elseif Character:FindFirstChild("Highlight") then targeting = true
        elseif speed > 5 and approach > 10 and dist < 40 then targeting = true end

        if targeting then
            local targetRadius = math.clamp(dist, currentParryRadius, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (dist <= currentParryRadius) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE
            local u = clamp01((dist - currentParryRadius) / (CFG.MAX_RADIUS - currentParryRadius))
            tgtTransparency = CFG.NEAR_TRANSPARENCY + (CFG.FAR_TRANSPARENCY - CFG.NEAR_TRANSPARENCY) * u

            if dist <= currentParryRadius then doParry = true end
            if not doParry and approach > 0 then
                local horizon = math.clamp(0.05 + CFG.PREDICT_FRAMES / 60, CFG.MIN_AHEAD, CFG.MAX_AHEAD)
                if (dist - currentParryRadius) / approach <= horizon then doParry = true end
            end
        end
    end

    if doParry then
        local now = tick()
        if now - lastParry >= CFG.PARRY_COOLDOWN then
            executeParry(); lastParry = now; state.lastFlash = now
        end
    end

    state.diameter = damp(state.diameter, tgtDiameter, CFG.DAMP_LAMBDA, dt)
    state.transparency = damp(state.transparency, tgtTransparency, CFG.DAMP_LAMBDA, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))
    state.phase = state.phase + dt * CFG.PULSE_SPEED
    local pulse = math.sin(state.phase)

    if CFG.SPHERE_VISIBLE then
        local finalDiameter = state.diameter * (1 + pulse * CFG.PULSE_SIZE_AMPL)
        local finalTrans = math.clamp(state.transparency + pulse * CFG.PULSE_ALPHA_AMPL, 0, 0.95)
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        local bob = math.sin(state.phase * (CFG.BOB_SPEED / CFG.PULSE_SPEED)) * CFG.BOB_AMPLITUDE
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET + bob, hrpPos.Z)
        sphere.Size = Vector3.new(finalDiameter, finalDiameter, finalDiameter)
        sphere.Transparency = finalTrans
        sphere.Color = finalColor
    end
end)

