if PlayerGui:FindFirstChild("BBMenu") then PlayerGui.BBMenu:Destroy() end

local CFG = {
    PARRY_RADIUS        = 15,        -- Радиус парирования
    MAX_RADIUS          = 25,        -- Максимальный размер сферы
    PARRY_COOLDOWN      = 0.2,       
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,      
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

-- 1. ПОИСК REMOTE И КНОПКИ
local parryRemote = nil
local parryButton = nil

task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name:lower():find("parry") then
            parryRemote = obj
            print("✅ Найден Remote: " .. obj.Name)
            break
        end
    end
end)

local function findButton()
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible then
            local n = obj.Name:lower()
            if n:find("block") or n:find("parry") or n:find("deflect") then
                return obj
            end
        end
    end
end

