-- ==========================================
-- ===== НАСТРОЙКИ ==========================
-- ==========================================
local PARRY_KEY        = Enum.KeyCode.F
local NEAR_DIAMETER    = 5
local FAR_DIAMETER     = 5
local DISTANCE_FOR_FAR = 20
local TRANSPARENCY     = 0.7
local PARRY_COOLDOWN   = 0.15
local BURST_COUNT      = 3
local BURST_INTERVAL   = 0.04
local REARM_MULTIPLIER = 1.5
local DAMP_LAMBDA      = 14       -- плавность (больше = резче)
local PREDICT_FRAMES   = 2
local MIN_AHEAD        = 0.06
local MAX_AHEAD        = 0.25
local EMERGENCY_MULT   = 1.2
local DEBUG_MODE       = true     -- первое время печатает диагностику

local COLOR_NEAR = Color3.fromRGB(255, 30, 30)
local COLOR_MID  = Color3.fromRGB(255, 200, 0)
local COLOR_FAR  = Color3.fromRGB(30, 255, 50)

-- ==========================================
-- ===== СЕРВИСЫ ============================
-- ==========================================
local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService    = game:GetService("UserInputService")
local Workspace           = game:GetService("Workspace")
local Stats               = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local Character, HumanoidRootPart
do
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10)
end

local IS_MOBILE     = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local SEGMENTS      = IS_MOBILE and 18 or 24

-- ==========================================
-- ===== PING ===============================
-- ==========================================
local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- ==========================================
-- ===== КОЛЬЦО =============================
-- ==========================================
local ringFolder = Instance.new("Folder")
ringFolder.Name = "ParryRing"
ringFolder.Parent = Workspace

local segments = table.create(SEGMENTS)
for i = 1, SEGMENTS do
    local p = Instance.new("Part")
    p.Name          = "RingSeg"
    p.Anchored      = true
    p.CanCollide    = false
    p.CanTouch      = false
    p.CanQuery      = false
    p.CastShadow    = false
    p.Material      = Enum.Material.Neon
    p.Color         = COLOR_FAR
    p.Transparency  = TRANSPARENCY
    p.Size          = Vector3.new(0.1, 0.1, 0.2)
    p.Parent        = ringFolder
    segments[i]     = p
end

-- ==========================================
-- ===== RAYCAST ============================
-- ==========================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = {Character, ringFolder}

-- ==========================================
-- ===== ДЕТЕКЦИЯ МЯЧА (3 способа) ==========
-- ==========================================
local cachedBall = nil

local function findBall()
    -- 1) атрибут realBall
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
    -- 2) папка Balls
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    -- 3) имя содержит ball/orb/sphere
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if n:find("ball") or n:find("orb") or n:find("sphere") then
                return o
            end
        end
    end
    return nil
end

cachedBall = findBall()

Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall then
        local n = o.Name:lower()
        if o:GetAttribute("realBall") or n:find("ball") or n:find("orb") then
            cachedBall = o
        end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ==========================================
-- ===== ДЕТЕКТ ЦЕЛИ (несколько имён) ========
-- ==========================================
local TARGET_KEYS = {"target","Target","targetPlayer","TargetPlayer",
                     "player","Player","Targeted","targeted"}

local function getTargetValue(ball)
    if not ball then return nil end
    for _, k in ipairs(TARGET_KEYS) do
        local v = ball:GetAttribute(k)
        if v ~= nil then return v, k end
    end
    return nil, nil
end

local function isTargetingMe(ball)
    if not ball then return false, nil end
    local v, key = getTargetValue(ball)
    if v then
        if v == LocalPlayer.Name or v == LocalPlayer.UserId
           or tostring(v) == LocalPlayer.Name then
            return true, key
        end
    end
    if Character and Character:FindFirstChild("Highlight") then
        return true, "Highlight"
    end
    return false, key
end

-- ==========================================
-- ===== ВВОД (F + кнопка) ==================
-- ==========================================
local function sendKeyF(state)
    pcall(function()
        VirtualInputManager:SendKeyEvent(state, PARRY_KEY, false, game)
    end)
end

local BUTTON_KEYWORDS = {"parry","block","deflect","guard","ability"}
local cachedButton, buttonLastScan = nil, 0

local function findParryButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize
               or Vector2.new(1920, 1080)
    local best, bestScore = nil, 0
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Active and obj.Visible then
            local n = obj.Name:lower()
            local score = 0
            for _, kw in ipairs(BUTTON_KEYWORDS) do
                if n:find(kw, 1, true) then score = score + 10 break end
            end
            if score > 0 then
                local ap = obj.AbsolutePosition
                if ap.X > vp.X * 0.5 and ap.Y > vp.Y * 0.4 then score = score + 3 end
            end
            if score > bestScore then best, bestScore = obj, score end
        end
    end
    return best
end

local function clickButton(btn)
    if not btn or not btn.Parent then return end
    local ap, sz = btn.AbsolutePosition, btn.AbsoluteSize
    local x, y = ap.X + sz.X/2, ap.Y + sz.Y/2
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true,  game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    pcall(function()
        UserInputService:SendMouseButtonEvent(x, y, 0, true,  game, 0)
        task.wait(0.02)
        UserInputService:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function getButton()
    if cachedButton and cachedButton.Parent then return cachedButton end
    local now = tick()
    if now - buttonLastScan < 3 then return nil end
    buttonLastScan = now
    cachedButton = findParryButton()
    if cachedButton and DEBUG_MODE then
        print("[BB] Кнопка парирования:", cachedButton:GetFullName())
    end
    return cachedButton
end

-- ==========================================
-- ===== ПАРИРОВАНИЕ ========================
-- ==========================================
local burstActive = false
local function fireParry()
    if burstActive then return end
    burstActive = true
    task.spawn(function()
        for i = 1, BURST_COUNT do
            local btn = getButton()
            if btn then clickButton(btn) end
            sendKeyF(true)
            task.wait(BURST_INTERVAL * 0.4)
            sendKeyF(false)
            if i < BURST_COUNT then task.wait(BURST_INTERVAL * 0.6) end
        end
        burstActive = false
    end)
end

-- ==========================================
-- ===== ВИЗУАЛ =============================
-- ==========================================
local function gradientColor(t)
    t = math.clamp(t, 0, 1)
    if t <= 0.5 then return COLOR_NEAR:Lerp(COLOR_MID, t*2)
    else              return COLOR_MID:Lerp(COLOR_FAR, (t-0.5)*2) end
end

local function damp(current, target, lambda, dt)
    return target + (current - target) * math.exp(-lambda * dt)
end

local function findGround(hrpPos)
    local res = Workspace:Raycast(hrpPos + Vector3.new(0, 3, 0),
                                   Vector3.new(0, -50, 0), rayParams)
    if res then return Vector3.new(hrpPos.X, res.Position.Y + 0.1, hrpPos.Z) end
    return Vector3.new(hrpPos.X, hrpPos.Y - 2.5, hrpPos.Z)
end

local lastRingPos, lastRadius, lastColor = Vector3.new(), -1, Color3.new()
local function updateRing(center, radius, color)
    local moved  = (center - lastRingPos).Magnitude > 0.01
    local resized = math.abs(radius - lastRadius) > 0.01
    local recolored = (color.R-lastColor.R)^2 + (color.G-lastColor.G)^2
                    + (color.B-lastColor.B)^2 > 0.0002
    if not (moved or resized or recolored) then return end
    lastRingPos, lastRadius, lastColor = center, radius, color

    local arcLen    = (2 * math.pi * radius) / SEGMENTS
    local thickness = math.clamp(radius * 0.22, 0.08, 0.35)
    for i = 1, SEGMENTS do
        local angle = (i - 1) / SEGMENTS * math.pi * 2
        local pos = center + Vector3.new(math.cos(angle)*radius, 0, math.sin(angle)*radius)
        local tan = Vector3.new(-math.sin(angle), 0, math.cos(angle))
        local p = segments[i]
        p.CFrame = CFrame.lookAt(pos, pos + tan)
        p.Size   = Vector3.new(thickness, 0.1, arcLen * 1.2)
        p.Color  = color
    end
end

-- ==========================================
-- ===== ГЛАВНЫЙ ЦИКЛ =======================
-- ==========================================
local MIN_RADIUS    = NEAR_DIAMETER / 2
local currentRadius = FAR_DIAMETER / 2
local currentColor  = COLOR_FAR
local lastParry     = 0
local armed         = true
local prevDist      = math.huge
local lastFlash     = 0

local debugClock = 0
local function debugPrint(dt)
    if not DEBUG_MODE then return end
    debugClock = debugClock + dt
    if debugClock < 3 then return end
    debugClock = 0
    print("─── [BB] debug ───")
    print("HRP:", HumanoidRootPart and HumanoidRootPart.Position)
    print("Ball:", cachedBall and cachedBall:GetFullName() or "nil")
    if cachedBall then
        local attrs = cachedBall:GetAttributes()
        local list = {}
        for k, v in pairs(attrs) do list[#list+1] = k .. "=" .. tostring(v) end
        print("Attrs:", table.concat(list, ", "))
        print("Pos:", cachedBall.Position,
              "Vel:", cachedBall.AssemblyLinearVelocity.Magnitude)
    end
    print("Button:", cachedButton and cachedButton.Name or "nil")
end

local function mainTick(dt)
    if not Character or not Character.Parent then
        Character = LocalPlayer.Character
    end
    if not HumanoidRootPart or not HumanoidRootPart.Parent then
        HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    end
    if not HumanoidRootPart then return end

    -- Периодический ре-скан мяча
    if not cachedBall or not cachedBall.Parent then
        cachedBall = findBall()
    end

    local hrpPos = HumanoidRootPart.Position
    local ball   = cachedBall

    local targetRadius = FAR_DIAMETER / 2
    local targetColor  = COLOR_FAR
    local doParry      = false

    if ball then
        local targeting = isTargetingMe(ball)
        local dist = (hrpPos - ball.Position).Magnitude

        if not targeting and dist < MIN_RADIUS * EMERGENCY_MULT then
            targeting = true
        end

        if targeting then
            local u = math.clamp(dist / DISTANCE_FOR_FAR, 0, 1)
            targetRadius = (NEAR_DIAMETER + (FAR_DIAMETER - NEAR_DIAMETER) * u) / 2
            targetColor  = gradientColor(u)

            if dist > MIN_RADIUS * REARM_MULTIPLIER then armed = true end

            if armed then
                if dist <= MIN_RADIUS then
                    doParry = true
                end
                if not doParry and prevDist > MIN_RADIUS and dist <= MIN_RADIUS then
                    doParry = true
                end
                if not doParry then
                    local bv = ball.AssemblyLinearVelocity
                    if bv.Magnitude < 0.5 then bv = ball.Velocity end
                    if bv.Magnitude > 1 then
                        local dir = (hrpPos - ball.Position).Unit
                        local approach = bv:Dot(dir)
                        if approach > 0 then
                            local horizon = math.clamp(pingCache + PREDICT_FRAMES/60,
                                                       MIN_AHEAD, MAX_AHEAD)
                            if (dist - MIN_RADIUS) / approach <= horizon then
                                doParry = true
                            end
                        end
                    end
                end
            end
            prevDist = dist
        else
            armed = true
            prevDist = math.huge
        end
    else
        armed = true
        prevDist = math.huge
    end

    if doParry then
        local now = tick()
        if now - lastParry >= PARRY_COOLDOWN then
            fireParry()
            lastParry = now
            lastFlash = now
            armed = false
        end
    end

    -- Плавное сглаживание (frame-rate независимо)
    currentRadius = damp(currentRadius, targetRadius, DAMP_LAMBDA, dt)
    currentColor  = currentColor:Lerp(targetColor,
                        math.clamp(DAMP_LAMBDA * dt, 0, 1))
    if tick() - lastFlash < 0.12 then
        currentColor = Color3.fromRGB(255, 255, 255)
    end

    -- Кольцо следует за игроком КАЖДЫЙ кадр
    local ringPos = findGround(hrpPos)
    updateRing(ringPos, currentRadius, currentColor)

    debugPrint(dt)
end

RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(mainTick, dt)
    if not ok then
        warn("[BB] Ошибка в цикле:", err)
    end
end)

