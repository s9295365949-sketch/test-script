    Instance.new("UICorner", SwitchBg).CornerRadius = UDim.new(1, 0)
    table.insert(UI_Elements, {btn = SwitchBg, type = "switch", state = initialState})
    
    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 18, 0, 18)
    Circle.Position = initialState and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
    Circle.BackgroundColor3 = Color3.new(1,1,1)
    Circle.Parent = SwitchBg
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)
    
    local isClicking = false
    local ClickArea = Instance.new("TextButton")
    ClickArea.Size = UDim2.new(1, 0, 1, 0)
    ClickArea.BackgroundTransparency = 1
    ClickArea.Text = ""
    ClickArea.Parent = Container
    
    ClickArea.Activated:Connect(function()
        if isClicking then return end
        isClicking = true
        PlayClick()
        
        initialState = not initialState
        callback(initialState)
        
        for _, el in ipairs(UI_Elements) do
            if el.btn == SwitchBg then el.state = initialState end
        end
        
        TweenService:Create(SwitchBg, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            BackgroundColor3 = initialState and CurrentTheme.ACCENT or CurrentTheme.OFF
        }):Play()
        TweenService:Create(Circle, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Position = initialState and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
