-- Главный цикл
local state = { diameter = CFG.MAX_RADIUS * 2, transparency = CFG.FAR_TRANSPARENCY, color = CFG.COLOR_OUTSIDE, lastFlash = 0, phase = 0 }
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtColor = CFG.COLOR_OUTSIDE
    local doParry = false
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_target = "NO"

    if ball then
        dbg_ball = "YES"
        local dist = (hrpPos - ball.Position).Magnitude
        dbg_dist = dist
        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed = bv.Magnitude
        local approach = 0
        if speed > 0.5 then approach = bv:Dot((hrpPos - ball.Position).Unit) end

        local currentParryRadius = CFG.MIN_PARRY_DIAMETER / 2

        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then 
            dbg_target = "ATTR"
            doParry = true 
        elseif Character:FindFirstChild("Highlight") then 
            dbg_target = "HL"
            doParry = true 
        elseif speed > 5 and approach > 5 and dist < 80 then 
            dbg_target = "FLYING"
            doParry = true 
        end

        if doParry then
            local targetRadius = math.clamp(dist, currentParryRadius, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (dist <= currentParryRadius) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            if dist <= currentParryRadius then 
                if tick() - lastParry >= CFG.PARRY_COOLDOWN then
                    executeParry()
                    lastParry = tick()
                    state.lastFlash = tick()
                end
            end
        end
    end

    debugText.Text = string.format("Ball: %s\nDist: %.1f\nTarget: %s\nMethod: %s", 
        dbg_ball, dbg_dist, dbg_target, lastAction)

    state.diameter = damp(state.diameter, tgtDiameter, CFG.DAMP_LAMBDA, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))
    state.phase = state.phase + dt * CFG.PULSE_SPEED

    if CFG.SPHERE_VISIBLE then
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
        sphere.Transparency = 0.7
        sphere.Color = finalColor
    end
end)

