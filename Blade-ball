print("▶️ 1. Скрипт запущен...")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)

-- Удаляем старые версии
if PlayerGui:FindFirstChild("BBDebug") then PlayerGui.BBDebug:Destroy() end
if PlayerGui:FindFirstChild("BBMenu") then PlayerGui.BBMenu:Destroy() end

local CFG = {
    PARRY_RADIUS        = 15,        -- Радиус (15 стабсов - идеально для сервера)
    PARRY_COOLDOWN      = 0.2,       
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,      
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

-- 1. ПОИСК REMOTE И КНОПКИ
local parryRemote = nil
local parryButton = nil

task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name:lower():find("parry") then
            parryRemote = obj
            print("✅ Найден Remote: " .. obj.Name)
            break
        end
    end
end)

local function findButton()
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible then
            local n = obj.Name:lower()
            -- Ищем кнопку с именем Block, Parry или Deflect
            if n:find("block") or n:find("parry") or n:find("deflect") then
                return obj
            end
        end
    end
end

