local originalLighting = {}
local createdAtmosphere = nil

local function SetNightMap(enabled)
    if enabled then
        -- Сохраняем оригинальные настройки
        originalLighting = {
            ClockTime = Lighting.ClockTime,
            Brightness = Lighting.Brightness,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            FogEnd = Lighting.FogEnd,
            FogColor = Lighting.FogColor,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        }
        
        -- Ставим ночь
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.5
        Lighting.Ambient = Color3.fromRGB(20, 20, 30)
        Lighting.OutdoorAmbient = Color3.fromRGB(30, 30, 40)
        Lighting.FogEnd = 500
        Lighting.FogColor = Color3.fromRGB(10, 10, 20)
        Lighting.EnvironmentDiffuseScale = 0.1
        Lighting.EnvironmentSpecularScale = 0.1
        
        -- Добавляем атмосферу (туман), если её нет
        if not Lighting:FindFirstChildOfClass("Atmosphere") then
            local atm = Instance.new("Atmosphere")
            atm.Density = 0.4
            atm.Offset = 0.1
            atm.Color = Color3.fromRGB(50, 50, 80)
            atm.Decay = Color3.fromRGB(20, 20, 40)
            atm.Glare = 0
            atm.Haze = 1
            atm.Parent = Lighting
            createdAtmosphere = atm
        end
    else
        -- Возвращаем день
        if originalLighting.ClockTime then
            Lighting.ClockTime = originalLighting.ClockTime
            Lighting.Brightness = originalLighting.Brightness
            Lighting.Ambient = originalLighting.Ambient
            Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
            Lighting.FogEnd = originalLighting.FogEnd
            Lighting.FogColor = originalLighting.FogColor
            Lighting.EnvironmentDiffuseScale = originalLighting.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = originalLighting.EnvironmentSpecularScale
        end
        if createdAtmosphere then
            createdAtmosphere:Destroy()
            createdAtmosphere = nil
        end
    end
end

