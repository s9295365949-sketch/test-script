-- 5. ПОИСК МЯЧА
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then
        if not cachedBall then cachedBall = o end
    end
end)

-- 6. ПАРИРОВАНИЕ
local lastParry = 0
local lastAction = "None"

local function executeParry()
    if not CFG.PARRY_ENABLED then return end
    if tick() - lastParry < CFG.PARRY_COOLDOWN then return end

    -- Пытаемся нажать кнопку на экране
    if not parryButton then parryButton = findButton() end
    
    if parryButton then
        local pos = parryButton.AbsolutePosition
        local size = parryButton.AbsoluteSize
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 0)
        end)
        lastAction = "Button"
    elseif parryRemote then
        -- Если кнопки нет, шлем Remote
        pcall(function() parryRemote:FireServer() end)
        lastAction = "Remote"
    end
    
    lastParry = tick()
end

-- 7. ЦИКЛ
local lastBall = nil
local prevPos = nil

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local ball = cachedBall
    local hrpPos = hrp.Position
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_status = "Safe"

    if ball then
        dbg_ball = "YES"
        local bp = ball.Position
        local dist = (hrpPos - bp).Magnitude
        dbg_dist = dist

        if lastBall ~= ball then
            prevPos = bp
            lastBall = ball
        end

        -- Простой детект: летит ли в нас
        local isMoving = prevPos and (bp - prevPos).Magnitude > 0.5
        local isTargetingMe = false
        
        local tVal = ball:GetAttribute("target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then 
            isTargetingMe = true 
        elseif isMoving and dist < 50 then
            isTargetingMe = true 
        end

        if isTargetingMe then
            dbg_status = "Incoming!"
            if dist <= CFG.PARRY_RADIUS then
                executeParry()
                dbg_status = "PARRY!"
            end
        end
        prevPos = bp
    end

    debugText.Text = string.Format("Ball: %s\nDist: %.1f\nStatus: %s\nMethod: %s", 
        dbg_ball, dbg_dist, dbg_status, lastAction)

    -- Визуал
    if CFG.SPHERE_VISIBLE then
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(CFG.PARRY_RADIUS * 2, CFG.PARRY_RADIUS * 2, CFG.PARRY_RADIUS * 2)
        sphere.Transparency = (dbg_status == "PARRY!") and 0.3 or 0.7
        sphere.Color = (dbg_status == "PARRY!") and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE
    else
        sphere.Transparency = 1
    end
end)
