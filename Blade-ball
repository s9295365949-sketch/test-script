-- Получение HWID (уникального ID устройства)
local function GetHWID()
    local hwid = "UNKNOWN_HWID"
    pcall(function()
        if gethwid then hwid = gethwid() 
        elseif syn and syn.get_hwid then hwid = syn.get_hwid() 
        elseif game.GetService and game:GetService("RbxAnalyticsService") then 
            hwid = game:GetService("RbxAnalyticsService"):GetClientId() 
        elseif identifyexecutor then hwid = identifyexecutor() .. "_" .. tostring(os.time()) end
    end)
    return hwid
end

