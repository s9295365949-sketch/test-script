    ToggleBtn.TextSize = 24
    ToggleBtn.TextColor3 = CFG.UI_THEME.ACCENT
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Parent = ScreenGui
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)
    
    local UIStroke = Instance.new("UIStroke", ToggleBtn)
    UIStroke.Color = CFG.UI_THEME.ACCENT
    UIStroke.Thickness = 2

    -- === Окно меню ===
    local Menu = Instance.new("Frame")
    Menu.Size = UDim2.new(0, 220, 0, 250)
    Menu.Position = UDim2.new(1, -240, 0.5, -125)
    Menu.BackgroundColor3 = CFG.UI_THEME.BG
    Menu.Visible = false
    Menu.Parent = ScreenGui
    Instance.new("UICorner", Menu).CornerRadius = UDim.new(0, 12)
    
    local MenuStroke = Instance.new("UIStroke", Menu)
    MenuStroke.Color = CFG.UI_THEME.ACCENT
    MenuStroke.Thickness = 1
    MenuStroke.Transparency = 0.5

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.BackgroundTransparency = 1
    Title.Text = "BLADE BALL"
    Title.TextColor3 = CFG.UI_THEME.ACCENT
    Title.Font = Enum.Font.GothamBlack
    Title.TextSize = 18
    Title.Parent = Menu

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 10)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Menu

    local Padding = Instance.new("UIPadding")
    Padding.PaddingTop = UDim.new(0, 45)
    Padding.Parent = Menu

    -- Функция создания стильных кнопок
    local function CreateToggle(text, initialState, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, -30, 0, 40)
        Btn.BackgroundColor3 = initialState and CFG.UI_THEME.ACCENT or CFG.UI_THEME.OFF
        Btn.Text = text
        Btn.TextColor3 = initialState and CFG.UI_THEME.BG or CFG.UI_THEME.TEXT
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 14
        Btn.Parent = Menu
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

        local isClicking = false
        Btn.Activated:Connect(function()
            if isClicking then return end
            isClicking = true
            
            initialState = not initialState
            callback(initialState)
            
            -- Плавная анимация цвета
            TweenService:Create(Btn, TweenInfo.new(0.2), {
                BackgroundColor3 = initialState and CFG.UI_THEME.ACCENT or CFG.UI_THEME.OFF,
                TextColor3 = initialState and CFG.UI_THEME.BG or CFG.UI_THEME.TEXT
            }):Play()
            
            task.wait(0.2)
            isClicking = false
        end)
    end

    CreateToggle("Авто-парирование", State.Enabled, function(v) State.Enabled = v end)
    CreateToggle("3D Сфера", State.ShowSphere, function(v) 
        State.ShowSphere = v
        Sphere.Transparency = v and 0.8 or 1
        InnerSphere.Transparency = v and 0.9 or 1
    end)

    -- Анимация открытия
    ToggleBtn.Activated:Connect(function()
        Menu.Visible = not Menu.Visible
        if Menu.Visible then
            Menu.Size = UDim2.new(0, 0, 0, 250)
            TweenService:Create(Menu, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 220, 0, 250)
            }):Play()
        end
    end)
    
    -- === Отладчик ===
    if CFG.DEBUG_MODE then
        local DebugGui = Instance.new("ScreenGui")
        DebugGui.Name = "BB_Debug"
        DebugGui.ResetOnSpawn = false
        DebugGui.Parent = PlayerGui

        local DebugFrame = Instance.new("Frame")
