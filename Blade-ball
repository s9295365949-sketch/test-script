-- ============================================================
-- 1. НАСТРОЙКИ
-- ============================================================
local CFG = {
    -- ─── Парирование (ИДЕАЛЬНЫЙ БАЛАНС) ────────────────────
    MIN_PARRY_DIAMETER  = 25,        -- Мин. диаметр (радиус 12.5) при медленном мяче
    MAX_PARRY_DIAMETER  = 40,        -- Макс. диаметр (радиус 20) при быстром мяче
    MIN_SPEED_THRESH    = 50,        
    MAX_SPEED_THRESH    = 200,       
    PARRY_COOLDOWN      = 0.15,      

    -- ─── Визуал сферы ──────────────────────────────────────
    MAX_RADIUS          = 30,        -- Максимальный радиус сферы
    NEAR_TRANSPARENCY   = 0.60,      
    FAR_TRANSPARENCY    = 0.80,      
    Y_OFFSET            = -0.5,      

    -- ─── Человеческая реакция (АНТИ-БАН) ───────────────────
    HUMAN_DELAY_MIN     = 0.01,      -- Минимальная задержка
    HUMAN_DELAY_MAX     = 0.03,      -- Максимальная задержка
    PREDICT_FRAMES      = 2,         
    MIN_AHEAD           = 0.02,      -- Предсказание за 0.02 сек
    MAX_AHEAD           = 0.10,      -- Максимум за 0.10 сек (чтобы не промахнуться мимо окна)
    
    -- ─── Сглаживание ───────────────────────────────────────
    DAMP_LAMBDA         = 14,
    PULSE_SPEED         = 2.2,       
    PULSE_SIZE_AMPL     = 0.04,      
    PULSE_ALPHA_AMPL    = 0.04,      
    BOB_SPEED           = 1.8,       
    BOB_AMPLITUDE       = 0.15,      

    -- ─── Цвета ─────────────────────────────────────────────
    COLOR_INSIDE  = Color3.fromRGB(255, 30, 30),    
    COLOR_OUTSIDE = Color3.fromRGB(30, 255, 50),    

    DEBUG = false,                   -- Поставь true, чтобы видеть логи в консоли
}

-- ============================================================
-- 2. СЕРВИСЫ
-- ============================================================
local function svc(name)
    local ok, s = pcall(function() return cloneref(game:GetService(name)) end)
    return ok and s or game:GetService(name)
end

local Players           = svc("Players")
local RunService        = svc("RunService")
local Workspace         = svc("Workspace")
local Stats             = svc("Stats")
local ReplicatedStorage = svc("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 10)

-- ============================================================
-- 3. УТИЛИТЫ
-- ============================================================
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

local pingCache = 0.05
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- ============================================================
-- 4. СФЕРА
-- ============================================================
local sphere = Instance.new("Part")
sphere.Name         = "AuraVisual"   
sphere.Shape        = Enum.PartType.Ball
sphere.Anchored     = true
sphere.CanCollide   = false
sphere.CanTouch     = false
sphere.CanQuery     = false
sphere.CastShadow   = false
sphere.Massless     = true
sphere.Material     = Enum.Material.ForceField
sphere.Color        = CFG.COLOR_OUTSIDE
sphere.Transparency = CFG.FAR_TRANSPARENCY
sphere.Size         = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent       = Workspace

-- ============================================================
-- 5. ПОИСК МЯЧА
-- ============================================================
local cachedBall = nil

local function findBall()
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") and o:GetAttribute("realBall") then return o end
    end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then return o end
        end
    end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (n == "ball" or n == "energyball" or n == "fireball" or n == "iceball" or n == "snowball") 
               and not n:find("explosion") then
                return o
            end
        end
    end
    return nil
end

cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall then
        local n = o.Name:lower()
        if o:GetAttribute("realBall") or n == "ball" then cachedBall = o end
    end
end)
Workspace.ChildRemoved:Connect(function(o)
    if o == cachedBall then cachedBall = nil end
end)

-- ============================================================
-- 6. ПОИСК REMOTE (Event или Function)
-- ============================================================
local parryRemote = nil
local function findParryRemote()
    local ok, found = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                    return obj
                end
            end
        end
    end)
    return ok and found or nil
end
parryRemote = findParryRemote()

if CFG.DEBUG then
    print("[BB] Найден Remote для парира:", parryRemote and parryRemote:GetFullName() or "НЕ НАЙДЕН (используется VIM)")
end

-- ============================================================
-- 7. ПАРИРОВАНИЕ
-- ============================================================
local lastParry = 0
local burstActive = false

local function fireParry(dist)
    if burstActive then return end
    burstActive = true
    
    task.spawn(function()
        local delay = CFG.HUMAN_DELAY_MIN + math.random() * (CFG.HUMAN_DELAY_MAX - CFG.HUMAN_DELAY_MIN)
        task.wait(delay)
        
        if CFG.DEBUG then
            print(string.format("[BB] ПАРИР! Дистанция: %.1f стабсов", dist))
        end

        if parryRemote then
            pcall(function() 
                if parryRemote:IsA("RemoteEvent") then
                    parryRemote:FireServer() 
                else
                    parryRemote:InvokeServer()
                end
            end)
        else
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.02)
                vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end)
        end
        
        task.wait(0.05)
        burstActive = false
    end)
end

-- ============================================================
-- 8. ВИЗУАЛ
-- ============================================================
local lastState = { pos = Vector3.new(), size = -1, alpha = -1, color = Color3.new() }

local function applySphere(center, diameter, transparency, color)
    if (center - lastState.pos).Magnitude < 0.005 and math.abs(diameter - lastState.size) < 0.005 
       and math.abs(transparency - lastState.alpha) < 0.003 
       and (color.R - lastState.color.R)^2 + (color.G - lastState.color.G)^2 + (color.B - lastState.color.B)^2 < 0.0001 then
        return 
    end

    lastState.pos, lastState.size, lastState.alpha, lastState.color = center, diameter, transparency, color

    sphere.CFrame       = CFrame.new(center)
    sphere.Size         = Vector3.new(diameter, diameter, diameter)
    sphere.Transparency = transparency
    sphere.Color        = color
end

-- ============================================================
-- 9. СОСТОЯНИЕ
-- ============================================================
local state = {
    diameter     = CFG.MAX_RADIUS * 2,
    transparency = CFG.FAR_TRANSPARENCY,
    color        = CFG.COLOR_OUTSIDE,
    lastFlash    = 0,
    phase        = 0,
}

-- ============================================================
-- 10. ГЛАВНЫЙ ЦИКЛ
-- ============================================================
local function mainTick(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end

    local hrpPos = HRP.Position
    local ball   = cachedBall

    local tgtDiameter     = CFG.MAX_RADIUS * 2
    local tgtTransparency = CFG.FAR_TRANSPARENCY
    local tgtColor        = CFG.COLOR_OUTSIDE
    local doParry         = false
    local currentDist     = 0

    if ball then
        local dist = (hrpPos - ball.Position).Magnitude
        currentDist = dist
        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed = bv.Magnitude
        
        local approach = 0
        if speed > 0.5 then
            approach = bv:Dot((hrpPos - ball.Position).Unit)
        end

        local speedFactor = clamp01((speed - CFG.MIN_SPEED_THRESH) / (CFG.MAX_SPEED_THRESH - CFG.MIN_SPEED_THRESH))
        local currentParryDiameter = CFG.MIN_PARRY_DIAMETER + (CFG.MAX_PARRY_DIAMETER - CFG.MIN_PARRY_DIAMETER) * speedFactor
        local currentParryRadius = currentParryDiameter / 2

        local targeting = false
        local isOther = false

        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
                  or ball:GetAttribute("targetPlayer") or ball:GetAttribute("TargetPlayer")
        if tVal then
            if tVal == LocalPlayer.Name or tVal == LocalPlayer.UserId or tostring(tVal) == LocalPlayer.Name
               or tVal == LocalPlayer or tVal == Character then
                targeting = true
            else
                isOther = true
            end
        end

        if not targeting and not isOther then
            local hl = Character and Character:FindFirstChild("Highlight")
            if hl and hl.Enabled then targeting = true end
        end

        if not targeting and not isOther and speed > 5 and approach > 10 and dist < 40 then
            targeting = true
        end

        if targeting then
            local targetRadius = math.clamp(dist, currentParryRadius, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2

            local isInside = (dist <= (targetRadius - 0.5)) or (dist <= currentParryRadius)
            tgtColor = isInside and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            local u = clamp01((dist - currentParryRadius) / (CFG.MAX_RADIUS - currentParryRadius))
            tgtTransparency = CFG.NEAR_TRANSPARENCY + (CFG.FAR_TRANSPARENCY - CFG.NEAR_TRANSPARENCY) * u

            -- Срабатывание парирования
            if dist <= currentParryRadius then
                doParry = true
            end
            
            -- Предиктивка
            if not doParry and approach > 0 then
                local horizon = math.clamp(pingCache + CFG.PREDICT_FRAMES / 60, CFG.MIN_AHEAD, CFG.MAX_AHEAD)
                if (dist - currentParryRadius) / approach <= horizon then 
                    doParry = true 
                end
            end
        end
    end

    if doParry then
        local now = tick()
        if now - lastParry >= CFG.PARRY_COOLDOWN then
            fireParry(currentDist)
            lastParry = now
            state.lastFlash = now
        end
    end

    state.diameter     = damp(state.diameter,     tgtDiameter,     CFG.DAMP_LAMBDA, dt)
    state.transparency = damp(state.transparency, tgtTransparency, CFG.DAMP_LAMBDA, dt)
    state.color        = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))

    state.phase = state.phase + dt * CFG.PULSE_SPEED
    local pulse = math.sin(state.phase)

    local finalDiameter = state.diameter * (1 + pulse * CFG.PULSE_SIZE_AMPL)
    local finalTrans    = math.clamp(state.transparency + pulse * CFG.PULSE_ALPHA_AMPL, 0, 0.95)
    local finalColor    = state.color

    if tick() - state.lastFlash < 0.12 then
        finalColor = Color3.fromRGB(255, 255, 255)
    end

    local bob = math.sin(state.phase * (CFG.BOB_SPEED / CFG.PULSE_SPEED)) * CFG.BOB_AMPLITUDE
    local center = Vector3.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET + bob, hrpPos.Z)

    applySphere(center, finalDiameter, finalTrans, finalColor)
    sphere.Transparency = finalTrans
end

RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(mainTick, dt)
    if not ok and CFG.DEBUG then warn("[BB] tick:", err) end
end)

-- ============================================================
-- 11. РЕСПАВН И СТАРТ
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP       = newChar:WaitForChild("HumanoidRootPart", 10)
    state.diameter    = CFG.MAX_RADIUS * 2
    state.transparency = CFG.FAR_TRANSPARENCY
    state.color       = CFG.COLOR_OUTSIDE
    cachedBall  = nil
    parryRemote = nil
    task.wait(1)
    parryRemote = findParryRemote()
end)

print("[Blade Ball] Сбалансированная зона парирования (25-40).")
