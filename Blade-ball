local function TriggerParry()
    local now = tick()
    if now - STATE.LastParry < CONFIG.COOLDOWN then return end
    STATE.LastParry = now

    if not STATE.BlockButton or not STATE.BlockButton.Parent then
        STATE.BlockButton = FindBlockButton()
    end

    if STATE.BlockButton and getconnections then
        local success = pcall(function()
            local connections = getconnections(STATE.BlockButton.Activated)
            for _, c in ipairs(connections) do
                if c.Fire then c:Fire() end
            end
        end)
        if success then return end
    end

    if STATE.Remote then
        pcall(function() STATE.Remote:FireServer() end)
        return
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)
end

local function GetBall()
    if STATE.Ball and STATE.Ball.Parent then return STATE.Ball end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then STATE.Ball = o; return o end
        end
    end
    return nil
end

local function IsTargetingMe(ball)
    if not ball then return false end
    local attrs = {"target", "Target", "targetPlayer", "TargetPlayer"}
    for _, a in ipairs(attrs) do
        local v = ball:GetAttribute(a)
        if v then
            if v == LP or v == LP.Name or v == LP.UserId or v == LP.Character or tostring(v) == LP.Name then
                return true
            else return false end
        end
    end
    return LP.Character and LP.Character:FindFirstChild("Highlight") ~= nil
end

local PulseTime = 0

-- ЛОК КАМЕРЫ
RunService.RenderStepped:Connect(function()
    if STATE.CameraLock and STATE.Ball and STATE.Ball.Parent then
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, STATE.Ball.Position)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        STATE.Frames = STATE.Frames + 1
        local render = true
        if STATE.AntiLag and (STATE.Frames % 3 ~= 0) then render = false end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0) then
            if OuterSphere then OuterSphere.Transparency = 1 end
            return
        end

        local ball = GetBall()
        local dist = 0
        local speed = 0
        local timeToImpact = 999
        local targetColor = STATE.OuterColor

        if ball then
            local bp = ball.Position
            dist = (hrp.Position - bp).Magnitude

            if STATE.Ball ~= ball then
                STATE.Ball = ball
                STATE.PrevBallPos = bp
                STATE.IsArmed = true
            end

            if dist > 80 then STATE.IsArmed = true end

            local bv = ball.AssemblyLinearVelocity
            if bv.Magnitude > 1 then
                speed = bv.Magnitude
                local dirToMe = (hrp.Position - bp).Unit
                local approachSpeed = bv:Dot(dirToMe)
                if approachSpeed > 1 then timeToImpact = dist / approachSpeed end
            elseif STATE.PrevBallPos and dt > 0 then
                local moveVec = bp - STATE.PrevBallPos
                speed = moveVec.Magnitude / dt
                if speed > 1 then
                    local dirToMe = (hrp.Position - bp).Unit
                    local approachSpeed = moveVec.Unit:Dot(dirToMe) * speed
                    if approachSpeed > 1 then timeToImpact = dist / approachSpeed end
                end
            end

            if IsTargetingMe(ball) then
                if dist <= CONFIG.CLOSE_DIST or timeToImpact <= CONFIG.PING_SAFE then
                    targetColor = Color3.fromRGB(255, 50, 50)
                    if STATE.Enabled then
                        TriggerParry()
                        STATE.IsArmed = false
                    end
                else
                    targetColor = Color3.fromRGB(255, 200, 0)
                end
            else
                targetColor = Color3.fromRGB(0, 255, 100)
            end
            STATE.PrevBallPos = bp
        else
            STATE.IsArmed = true
            STATE.PrevBallPos = nil
        end

        if render and STATE.ShowVisuals and OuterSphere and InnerSphere then
            PulseTime = PulseTime + (dt * 2.5)
            
            local targetSize = math.max(dist * 1.5, 40)
            local currentSize = OuterSphere.Size.X
            local newSize = currentSize + (targetSize - currentSize) * math.exp(-10 * dt)
            local finalSize = STATE.StaticSphere and newSize or (newSize * (1 + math.sin(PulseTime) * 0.02))

            OuterSphere.Size = Vector3.new(finalSize, finalSize, finalSize)
            OuterSphere.CFrame = CFrame.new(hrp.Position + Vector3.new(0, -0.5, 0))
            
            if STATE.NightModeSphere then
                OuterSphere.Material = Enum.Material.Neon
                OuterSphere.Transparency = 0.5
                InnerSphere.Transparency = 0.2
                if targetColor ~= Color3.fromRGB(255, 50, 50) then
                    targetColor = Color3.fromRGB(20, 0, 30)
                end
            else
                OuterSphere.Material = Enum.Material.ForceField
                OuterSphere.Transparency = 0.65
                InnerSphere.Transparency = STATE.HideInner and 1 or 0.7
            end

            OuterSphere.Color = OuterSphere.Color:Lerp(targetColor, math.clamp(10 * dt, 0, 1))
            
            if targetColor == Color3.fromRGB(255, 50, 50) then
                InnerSphere.Color = InnerSphere.Color:Lerp(Color3.fromRGB(255, 50, 50), math.clamp(10 * dt, 0, 1))
            else
                local finalInner = STATE.NightModeSphere and Color3.fromRGB(255, 0, 255) or STATE.InnerColor
                InnerSphere.Color = InnerSphere.Color:Lerp(finalInner, math.clamp(10 * dt, 0, 1))
            end
            
            InnerSphere.CFrame = OuterSphere.CFrame * CFrame.Angles(PulseTime, PulseTime, 0)
            -- УВЕЛИЧЕНО НА 15% (0.2 * 1.15 = 0.23)
            InnerSphere.Size = Vector3.new(finalSize * 0.23, finalSize * 0.23, finalSize * 0.23)
        end
    end)
end)

