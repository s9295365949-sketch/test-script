local function GetBall()
    if STATE.Ball and STATE.Ball.Parent then return STATE.Ball end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then STATE.Ball = o; return o end
        end
    end
    return nil
end

local function IsTargetingMe(ball)
    if not ball then return false end
    local attrs = {"target", "Target", "targetPlayer", "TargetPlayer"}
    for _, a in ipairs(attrs) do
        local v = ball:GetAttribute(a)
        if v then
            if v == LP or v == LP.Name or v == LP.UserId or v == LP.Character or tostring(v) == LP.Name then
                return true
            else
                return false 
            end
        end
    end
    return LP.Character and LP.Character:FindFirstChild("Highlight") ~= nil
end

local function GetZone(speed)
    local Z = CONFIG.ZONE
    if speed <= Z.MIN_SPEED then return Z.MIN_DIST end
    if speed <= Z.MID_SPEED then
        local a = (speed - Z.MIN_SPEED) / (Z.MID_SPEED - Z.MIN_SPEED)
        return Z.MIN_DIST + (Z.MID_DIST - Z.MIN_DIST) * a
    end
    if speed <= Z.MAX_SPEED then
        local a = (speed - Z.MID_SPEED) / (Z.MAX_SPEED - Z.MID_SPEED)
        return Z.MID_DIST + (Z.MAX_DIST - Z.MID_DIST) * a
    end
    return Z.MAX_DIST
end

local function getDistanceToSegment(p, a, b)
    local ab = b - a
    local ap = p - a
    local abLenSq = ab:Dot(ab)
    if abLenSq == 0 then return (p - a).Magnitude end
    local t = math.clamp(ap:Dot(ab) / abLenSq, 0, 1)
    local closest = a + ab * t
    return (p - closest).Magnitude
end

local PulseTime = 0

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        STATE.Frames = STATE.Frames + 1
        local render = true
        if STATE.AntiLag and (STATE.Frames % 3 ~= 0) then render = false end
        
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0) then
            if OuterSphere then OuterSphere.Transparency = 1 end
            return
        end

        local ball = GetBall()
        local dist, zone, speed = 0, CONFIG.ZONE.MIN_DIST, 0
        local timeToImpact = 999
        local targetColor = STATE.OuterColor
        local status = "Safe"

        if ball then
            local bp = ball.Position
            dist = (hrp.Position - bp).Magnitude
            
            if STATE.Ball ~= ball then
                STATE.Ball = ball
                STATE.PrevBallPos = bp
                STATE.IsArmed = true
            end
            
            if dist > CONFIG.ZONE.MAX_DIST * 1.5 then STATE.IsArmed = true end
            
            local approachSpeed = 0
            if STATE.PrevBallPos and dt > 0 then
                local moveVec = bp - STATE.PrevBallPos
                speed = moveVec.Magnitude / dt
                
                if speed > 1 then
                    local dirToMe = (hrp.Position - bp).Unit
                    approachSpeed = moveVec.Unit:Dot(dirToMe) * speed
                end
            end
            
            if approachSpeed > 1 then
                timeToImpact = dist / approachSpeed
            end

            if IsTargetingMe(ball) then
                zone = GetZone(speed)
                
                local inZone = dist <= zone
                local hitTrajectory = false
                if STATE.PrevBallPos then
                    hitTrajectory = getDistanceToSegment(hrp.Position, STATE.PrevBallPos, bp) <= zone
                end
                local predictHit = timeToImpact <= CONFIG.SYSTEM.PING_BUFFER
                
                if inZone or hitTrajectory or predictHit then
                    status = "DANGER!"
                    targetColor = CONFIG.VISUALS.DANGER_COLOR
                    
                    if STATE.Enabled and STATE.IsArmed and (tick() - STATE.LastParry > CONFIG.SYSTEM.PARRY_COOLDOWN) then
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                        end)
                        
                        if STATE.Remote then
                            pcall(function() STATE.Remote:FireServer() end)
                        end
                        
                        STATE.LastParry = tick()
                        STATE.IsArmed = false
                    end
                else
                    status = "Incoming"
                end
            else
                status = "Other Target"
            end
            STATE.PrevBallPos = bp
        else
            STATE.IsArmed = true
            STATE.PrevBallPos = nil
        end

        if render and STATE.ShowVisuals and OuterSphere and InnerSphere then
            if not STATE.StaticSphere then
                PulseTime = PulseTime + (dt * CONFIG.VISUALS.PULSE_SPEED)
            end
            local targetSize = zone * 2
            local currentSize = OuterSphere.Size.X
            local newSize = currentSize + (targetSize - currentSize) * math.exp(-10 * dt)
            local finalSize = STATE.StaticSphere and newSize or (newSize * (1 + math.sin(PulseTime) * 0.02))
            
            OuterSphere.Size = Vector3.new(finalSize, finalSize, finalSize)
            OuterSphere.CFrame = CFrame.new(hrp.Position + Vector3.new(0, CONFIG.VISUALS.Y_OFFSET, 0))
            
            if STATE.NightModeSphere then
                OuterSphere.Material = Enum.Material.Neon
                OuterSphere.Transparency = 0.5
                InnerSphere.Transparency = 0.2
                if targetColor ~= CONFIG.VISUALS.DANGER_COLOR then
                    targetColor = Color3.fromRGB(20, 0, 30)
                end
            else
                OuterSphere.Material = Enum.Material.ForceField
                OuterSphere.Transparency = 0.65
                InnerSphere.Transparency = STATE.HideInner and 1 or 0.8
            end

            OuterSphere.Color = OuterSphere.Color:Lerp(targetColor, math.clamp(10 * dt, 0, 1))
            
            if targetColor == CONFIG.VISUALS.DANGER_COLOR then
                InnerSphere.Color = InnerSphere.Color:Lerp(CONFIG.VISUALS.DANGER_COLOR, math.clamp(10 * dt, 0, 1))
            else
                local finalInner = STATE.NightModeSphere and Color3.fromRGB(255, 0, 255) or STATE.InnerColor
                InnerSphere.Color = InnerSphere.Color:Lerp(finalInner, math.clamp(10 * dt, 0, 1))
            end
            
            InnerSphere.CFrame = OuterSphere.CFrame * CFrame.Angles(PulseTime, PulseTime, 0)
            InnerSphere.Size = Vector3.new(finalSize * 0.2, finalSize * 0.2, finalSize * 0.2)
        end
        
        if DebugLabel and DebugLabel.Parent then
            DebugLabel.Text = string.format(
                "⚡ Speed: %.0f\n⏱️ Time: %s\n🎯 Status: %s\n📏 Dist: %.1f\n🛡️ Armed: %s",
                speed, (timeToImpact > 900 and "N/A" or string.format("%.2fs", timeToImpact)), status, dist, tostring(STATE.IsArmed)
            )
            if status == "DANGER!" then
                DebugLabel.TextColor3 = CONFIG.VISUALS.DANGER_COLOR
            else
                DebugLabel.TextColor3 = STATE.InnerColor
            end
        end
    end)
end)

