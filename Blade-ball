_G.BB_RefreshProfiles = function()
    for _, child in ipairs(ProfileListFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    local autoName = ""
    pcall(function() if isfile and isfile("BB_AutoLoad.txt") then autoName = readfile("BB_AutoLoad.txt") end end)

    local files = {}
    pcall(function()
        if listfiles then
            for _, f in ipairs(listfiles(PROFILE_FOLDER)) do
                local match = f:match("(.+)%.json")
                if match then table.insert(files, match) end
            end
        end
    end)
    
    if #files == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 25)
        empty.BackgroundTransparency = 1
        empty.Text = "No profiles saved"
        empty.TextColor3 = CurrentTheme.TEXT
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.Parent = ProfileListFrame
        return
    end

    table.sort(files)
    if autoName ~= "" then
        for i, v in ipairs(files) do
            if v == autoName then
                table.remove(files, i)
                table.insert(files, 1, v)
                break
            end
        end
    end

    for _, name in ipairs(files) do
        local isAuto = (name == autoName)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 25)
        row.BackgroundTransparency = 1
        row.Parent = ProfileListFrame

        local loadBtn = Instance.new("TextButton")
        loadBtn.Size = UDim2.new(0.6, -2, 1, 0)
        loadBtn.BackgroundColor3 = isAuto and CurrentTheme.ACCENT or CurrentTheme.OFF
        loadBtn.Text = (isAuto and "★ " or "") .. name
        loadBtn.TextColor3 = isAuto and CurrentTheme.BG or CurrentTheme.TEXT
        loadBtn.Font = Enum.Font.GothamBold
        loadBtn.TextSize = 10
        loadBtn.Parent = row
        Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0, 4)
        loadBtn.MouseButton1Click:Connect(function() PlayClick(); LoadProfile(name) end)

        local autoBtn = Instance.new("TextButton")
        autoBtn.Size = UDim2.new(0.4, -2, 1, 0)
        autoBtn.Position = UDim2.new(0.6, 2, 0, 0)
        autoBtn.BackgroundColor3 = isAuto and Color3.fromRGB(60, 180, 100) or CurrentTheme.OFF
        autoBtn.Text = isAuto and "✓ AUTO" or "SET AUTO"
        autoBtn.TextColor3 = isAuto and Color3.new(0,0,0) or CurrentTheme.TEXT
        autoBtn.Font = Enum.Font.GothamBold
        autoBtn.TextSize = 9
        autoBtn.Parent = row
        Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0, 4)
        autoBtn.MouseButton1Click:Connect(function()
            PlayClick()
            if isAuto then pcall(function() delfile("BB_AutoLoad.txt") end)
            else pcall(function() writefile("BB_AutoLoad.txt", name) end) end
            _G.BB_RefreshProfiles()
        end)
    end
end

