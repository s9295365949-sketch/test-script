local function CreateTab(name, icon)
    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1, 0, 0, 0)
    Page.AutomaticSize = Enum.AutomaticSize.Y
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.Parent = Pages
    
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 12)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Page
    
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.5, -4, 1, 0) -- Теперь ровно 50% на 50%
    TabBtn.BackgroundColor3 = CurrentTheme.OFF
    TabBtn.BackgroundTransparency = 0.3
    TabBtn.Text = icon .. " " .. name
    TabBtn.TextColor3 = CurrentTheme.TEXT
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 12
    TabBtn.Parent = TabContainer
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
    
    table.insert(PagesList, Page)
    table.insert(TabsList, {Btn = TabBtn, Page = Page})
    
    TabBtn.Activated:Connect(function()
        PlayClick()
        for _, t in ipairs(TabsList) do
            t.Page.Visible = false
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.OFF, TextColor3 = CurrentTheme.TEXT}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.ACCENT, TextColor3 = CurrentTheme.BG}):Play()
    end)
    
    return Page
end

local function CreateAsciiButton(parent, asciiText, initialState, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 85)
    Container.BackgroundTransparency = 1
    Container.Parent = parent
    
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundColor3 = initialState and CurrentTheme.ACCENT or CurrentTheme.OFF
    Btn.BackgroundTransparency = initialState and 0.2 or 0.4
    Btn.Text = asciiText
    Btn.TextColor3 = initialState and CurrentTheme.BG or CurrentTheme.TEXT
    Btn.Font = Enum.Font.Code
    Btn.TextSize = 8
    Btn.Parent = Container
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
    
    table.insert(UI_Elements, {btn = Btn, type = "ascii", state = initialState})

    local isClicking = false
    Btn.Activated:Connect(function()
        if isClicking then return end
        isClicking = true
        PlayClick()
        
        initialState = not initialState
        callback(initialState)
        
        for _, el in ipairs(UI_Elements) do
            if el.btn == Btn then el.state = initialState end
        end
        
        TweenService:Create(Btn, TweenInfo.new(0.2), {
            BackgroundColor3 = initialState and CurrentTheme.ACCENT or CurrentTheme.OFF,
            BackgroundTransparency = initialState and 0.2 or 0.4,
            TextColor3 = initialState and CurrentTheme.BG or CurrentTheme.TEXT
        }):Play()
        
        task.wait(0.2)
        isClicking = false
    end)
end

