local function createToggle(yPos, text, cfKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = menuFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local function updateUI()
        local state = CFG[cfKey]
        btn.Text = text .. (state and " ВКЛ" or " ВЫКЛ")
        btn.BackgroundColor3 = state and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
        btn.TextColor3 = Color3.new(1,1,1)
    end
    
    updateUI()

    local function toggle()
        CFG[cfKey] = not CFG[cfKey]
        updateUI()
    end

    -- Привязываем все возможные события нажатия для надежности
    btn.MouseButton1Click:Connect(toggle)
    btn.TouchTap:Connect(toggle)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            toggle()
        end
    end)
end

