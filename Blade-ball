    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Page
    
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.5, -3, 1, 0)
    TabBtn.BackgroundColor3 = CurrentTheme.OFF
    TabBtn.BackgroundTransparency = 0.3
    TabBtn.Text = name
    TabBtn.TextColor3 = CurrentTheme.TEXT
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 11
    TabBtn.Parent = TabContainer
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
    
    table.insert(PagesList, Page)
    table.insert(TabsList, {Btn = TabBtn, Page = Page})
    
    TabBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(TabsList) do
            t.Page.Visible = false
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.OFF, TextColor3 = CurrentTheme.TEXT}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.ACCENT, TextColor3 = CurrentTheme.BG}):Play()
    end)
    
    return Page
end

