sphere.Color = CFG.COLOR_OUTSIDE
sphere.Transparency = 1
sphere.Size = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent = Workspace

