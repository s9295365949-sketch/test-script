-- 4. ПОИСК REMOTE
local parryRemote = nil
local remoteName = "None"
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        local n = obj.Name:lower()
        if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") or n:find("attempt") then
            parryRemote = obj
            remoteName = obj.Name
            break
        end
    end
end

-- 5. ПОИСК МЯЧА
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (o:GetAttribute("realBall") or n:find("ball")) and not n:find("explosion") then return o end
        end
    end
end
cachedBall = findBall()

-- 6. ПАРИРОВАНИЕ
local lastParry = 0
local lastAction = "None"

local function executeParry()
    if not CFG.PARRY_ENABLED then return end
    if tick() - lastParry < CFG.PARRY_COOLDOWN then return end

    local fired = false
    if CFG.USE_REMOTE and parryRemote then
        pcall(function() parryRemote:FireServer() end)
        fired = true
    end
    if CFG.USE_F_KEY then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        fired = true
    end

    lastAction = fired and "Fired" or "None"
    lastParry = tick()
end

-- 7. ГЛАВНЫЙ ЦИКЛ
local state = { diameter = CFG.MAX_RADIUS * 2, color = CFG.COLOR_OUTSIDE }
local lastBall = nil
local prevBallPos = nil

RunService.Heartbeat:Connect(function(dt)
    local Character = LocalPlayer.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local ball = cachedBall
    local hrpPos = HRP.Position

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtColor = CFG.COLOR_OUTSIDE
    local dbg_status = "Safe"
    local dbg_dist = 0
    local dbg_ball = "NO"

    if ball then
        dbg_ball = "YES"
        local ballPos = ball.Position
        local dist = (hrpPos - ballPos).Magnitude
        dbg_dist = dist
        
        if lastBall ~= ball then
            prevBallPos = ballPos
            lastBall = ball
        end

        -- Проверка траектории (Swept Collision)
        local hitTrajectory = false
        if prevBallPos then
            local ab = ballPos - prevBallPos
            local ap = hrpPos - prevBallPos
            local abLenSq = ab:Dot(ab)
            if abLenSq > 0 then
                local t = math.clamp(ap:Dot(ab) / abLenSq, 0, 1)
                local closest = prevBallPos + ab * t
                if (hrpPos - closest).Magnitude <= CFG.PARRY_RADIUS then
                    hitTrajectory = true
                end
            end
        end

        local hitInside = (dist <= CFG.PARRY_RADIUS)

        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then targeting = true
        elseif Character:FindFirstChild("Highlight") then targeting = true
        elseif (ballPos - (prevBallPos or ballPos)).Magnitude > 1 and dist < 100 then targeting = true end

        if targeting then
            local targetRadius = math.clamp(dist, CFG.PARRY_RADIUS, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (hitInside or hitTrajectory) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            if hitTrajectory or hitInside then
                executeParry()
                dbg_status = hitTrajectory and "Hit Path!" or "Hit Inside!"
            end
        end
        prevBallPos = ballPos
    else
        lastBall = nil
        prevBallPos = nil
    end

    if debugText and debugText.Parent then
        debugText.Text = string.format("Ball: %s\nDist: %.1f\nStatus: %s\nMethod: %s\nRemote: %s", 
            dbg_ball, dbg_dist, dbg_status, lastAction, remoteName)
    end

    -- Визуал
    if sphere and sphere.Parent then
        if CFG.SPHERE_VISIBLE then
            state.diameter = state.diameter + (tgtDiameter - state.diameter) * math.exp(-14 * dt)
            state.color = state.color:Lerp(tgtColor, math.clamp(14 * dt, 0, 1))
            sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
            sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
            sphere.Transparency = 0.7
            sphere.Color = state.color
        else
            sphere.Transparency = 1 
        end
    end
end)

