local function createToggle(yPos, text, cfKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = menuFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local function updateUI()
        local state = CFG[cfKey]
        btn.Text = text .. (state and " ВКЛ" or " ВЫКЛ")
        btn.BackgroundColor3 = state and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
        btn.TextColor3 = Color3.new(1,1,1)
    end
    
    updateUI()

    -- Используем Activated вместо MouseButton1Click (лучше для мобилок)
    btn.Activated:Connect(function()
        CFG[cfKey] = not CFG[cfKey]
        updateUI()
    end)
end

createToggle(20, "Парирование", "PARRY_ENABLED")
