print("▶️ 1. Запуск скрипта...")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)

if PlayerGui:FindFirstChild("BBDebug") then PlayerGui.BBDebug:Destroy() end
if PlayerGui:FindFirstChild("BBMenu") then PlayerGui.BBMenu:Destroy() end
if Workspace:FindFirstChild("VisualEffect") then Workspace.VisualEffect:Destroy() end

local CFG = {
    PARRY_RADIUS        = 25,        -- Радиус срабатывания
    MAX_RADIUS          = 35,        -- Размер сферы
    PARRY_COOLDOWN      = 0.25,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,      
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
    
    -- НАЖИМАЕМ ЗА 0.35 СЕК ДО УДАРА (запас на пинг и анимацию)
    PREDICT_TIME        = 0.35,      
}

-- 1. REMOTE
local parryRemote = nil
task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:lower():find("parry") or obj.Name:lower():find("attempt") or obj.Name:lower():find("block")) then
            parryRemote = obj
            print("✅ Найден Remote: " .. obj.Name)
            break
        end
    end
end)

-- 2. СФЕРА В WORKSPACE (3D)
local sphere = Instance.new("Part")
sphere.Name = "VisualEffect" 
sphere.Shape = Enum.PartType.Ball
sphere.Anchored = true
sphere.CanCollide = false
sphere.CanTouch = false
sphere.CanQuery = false
sphere.CastShadow = false
sphere.Massless = true
sphere.Material = Enum.Material.ForceField
sphere.Color = CFG.COLOR_OUTSIDE
sphere.Transparency = 1
sphere.Size = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent = Workspace

