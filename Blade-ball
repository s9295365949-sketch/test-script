print("▶️ 1. Скрипт запущен...")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)

-- Удаляем старые GUI
if PlayerGui:FindFirstChild("BBDebug") then PlayerGui.BBDebug:Destroy() end
if PlayerGui:FindFirstChild("BBMenu") then PlayerGui.BBMenu:Destroy() end

local CFG = {
    PARRY_RADIUS        = 30,        -- Радиус парирования
    MAX_RADIUS          = 40,        -- Размер сферы
    PARRY_COOLDOWN      = 0.25,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,      
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

-- 1. ПИНГ
local pingCache = 0.1 
task.spawn(function()
    while task.wait(1) do
        local ok, p = pcall(function() 
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 
        end)
        if ok and p and p > 0 and p < 1 then pingCache = p end
    end
end)

-- 2. REMOTE
local parryRemote = nil
task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name:lower():find("parry") or obj.Name:lower():find("attempt")) then
            parryRemote = obj
            print("✅ Найден Remote: " .. obj.Name)
            break
        end
    end
end)

