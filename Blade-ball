local function SaveConfig()
    local data = {
        Theme = CurrentThemeName,
        Enabled = STATE.Enabled,
        ShowVisuals = STATE.ShowVisuals,
        AntiLag = STATE.AntiLag,
        HideInner = STATE.HideInner,
        StaticSphere = STATE.StaticSphere,
        NightModeSphere = STATE.NightModeSphere,
        NightMap = STATE.NightMap,
        OuterColor = tostring(STATE.OuterColor),
        InnerColor = tostring(STATE.InnerColor)
    }
    local success, err = pcall(function()
        writefile("BB_Premium_Config.json", HttpService:JSONEncode(data))
    end)
    if success then
        print("✅ [BB] Настройки успешно сохранены!")
    else
        print("❌ [BB] Ошибка сохранения (экзекутор не поддерживает writefile).")
    end
end

local function LoadConfig()
    local success, data = pcall(function()
        if isfile and isfile("BB_Premium_Config.json") then
            return HttpService:JSONDecode(readfile("BB_Premium_Config.json"))
        end
    end)
    if success and data then
        CurrentThemeName = data.Theme or "Dark Metal"
        CurrentTheme = THEMES[CurrentThemeName] or THEMES["Dark Metal"]
        
        STATE.Enabled = data.Enabled ~= false
        STATE.ShowVisuals = data.ShowVisuals ~= false
        STATE.AntiLag = data.AntiLag == true
        STATE.HideInner = data.HideInner == true
        STATE.StaticSphere = data.StaticSphere == true
        STATE.NightModeSphere = data.NightModeSphere == true
        STATE.NightMap = data.NightMap == true
        
        if ApplyTheme then ApplyTheme() end
        print("✅ [BB] Настройки успешно загружены! (Требуется перезапуск для полного применения)")
    else
        print("❌ [BB] Файл конфигурации не найден.")
    end
end

