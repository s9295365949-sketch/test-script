-- [ CORE LOGIC & MAIN LOOP ]
-- ============================================================
local function GetBall()
    if STATE.Ball and STATE.Ball.Parent then return STATE.Ball end
    local bf = Workspace:FindFirstChild("Balls")
    if bf then
        for _, o in ipairs(bf:GetChildren()) do
            if o:IsA("BasePart") then STATE.Ball = o; return o end
        end
    end
    return nil
end

local function IsTargetingMe(ball)
    if not ball then return false end
    local attrs = {"target", "Target", "targetPlayer", "TargetPlayer"}
    for _, a in ipairs(attrs) do
        local v = ball:GetAttribute(a)
        if v then
            if v == LP or v == LP.Name or v == LP.UserId or v == LP.Character or tostring(v) == LP.Name then
                return true
            else
                return false 
            end
        end
    end
    return LP.Character and LP.Character:FindFirstChild("Highlight") ~= nil
end

local function GetZone(speed)
    local Z = CONFIG.ZONE
    if speed <= Z.MIN_SPEED then return Z.MIN_DIST end
    if speed <= Z.MID_SPEED then
        local a = (speed - Z.MIN_SPEED) / (Z.MID_SPEED - Z.MIN_SPEED)
        return Z.MIN_DIST + (Z.MID_DIST - Z.MIN_DIST) * a
    end
    if speed <= Z.MAX_SPEED then
        local a = (speed - Z.MID_SPEED) / (Z.MAX_SPEED - Z.MID_SPEED)
        return Z.MID_DIST + (Z.MAX_DIST - Z.MID_DIST) * a
    end
    return Z.MAX_DIST
end

local PulseTime = 0

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        -- Anti-Lag Check
        STATE.Frames = STATE.Frames + 1
        local render = true
        if STATE.AntiLag and (STATE.Frames % 3 ~= 0) then render = false end
        
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0) then
            if OuterSphere then OuterSphere.Transparency = 1 end
            return
        end

        local ball = GetBall()
        local dist, zone, speed = 0, CONFIG.ZONE.MIN_DIST, 0
        local targetColor = CONFIG.VISUALS.SAFE_COLOR

        if ball then
            local bp = ball.Position
            dist = (hrp.Position - bp).Magnitude
            
            if STATE.Ball ~= ball then
                STATE.Ball = ball
                STATE.PrevBallPos = bp
                STATE.IsArmed = true
            end
            
            if dist > CONFIG.ZONE.MAX_DIST * 1.5 then STATE.IsArmed = true end
            
            if STATE.PrevBallPos and dt > 0 then
                speed = (bp - STATE.PrevBallPos).Magnitude / dt
            end

            if IsTargetingMe(ball) then
                zone = GetZone(speed)
                if dist <= zone then
                    targetColor = CONFIG.VISUALS.DANGER_COLOR
                    if STATE.Enabled and STATE.IsArmed and (tick() - STATE.LastParry > CONFIG.SYSTEM.PARRY_COOLDOWN) then
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                        end)
                        STATE.LastParry = tick()
                        STATE.IsArmed = false
                    end
                end
            end
            STATE.PrevBallPos = bp
        else
            STATE.IsArmed = true
            STATE.PrevBallPos = nil
        end

        -- Visual Update
        if render and STATE.ShowVisuals and OuterSphere and InnerSphere then
            PulseTime = PulseTime + (dt * CONFIG.VISUALS.PULSE_SPEED)
            local targetSize = zone * 2
            local currentSize = OuterSphere.Size.X
            -- Smooth Lerp
            local newSize = currentSize + (targetSize - currentSize) * math.exp(-10 * dt)
            
            -- Pulse effect
            local finalSize = newSize * (1 + math.sin(PulseTime) * 0.03)
            
            OuterSphere.Size = Vector3.new(finalSize, finalSize, finalSize)
            OuterSphere.CFrame = CFrame.new(hrp.Position + Vector3.new(0, CONFIG.VISUALS.Y_OFFSET, 0))
            OuterSphere.Color = OuterSphere.Color:Lerp(targetColor, math.clamp(10 * dt, 0, 1))
            InnerSphere.Color = OuterSphere.Color
            
            InnerSphere.CFrame = OuterSphere.CFrame * CFrame.Angles(PulseTime, PulseTime, 0)
            InnerSphere.Size = Vector3.new(finalSize * 0.2, finalSize * 0.2, finalSize * 0.2)
        end
    end)
end)

