LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HumanoidRootPart = newChar:WaitForChild("HumanoidRootPart", 10)
    rayParams.FilterDescendantsInstances = {Character, ringFolder}
    armed       = true
    prevDist    = math.huge
    cachedBall  = nil
    cachedButton = nil
    buttonLastScan = 0
end)

