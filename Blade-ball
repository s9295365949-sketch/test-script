-- Тумблеры
local function createToggle(yPos, text, stateVar, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = stateVar and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
    btn.Text = text .. (stateVar and " ВКЛ" or " ВЫКЛ")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = menuFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        callback()
        btn.BackgroundColor3 = CFG.PARRY_ENABLED and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
        -- Обновляем текст на основе реального состояния
        if text == "Авто-парир" then btn.Text = text .. (CFG.PARRY_ENABLED and " ВКЛ" or " ВЫКЛ")
        elseif text == "Метод Remote" then btn.Text = text .. (CFG.USE_REMOTE and " ВКЛ" or " ВЫКЛ")
        elseif text == "Метод F" then btn.Text = text .. (CFG.USE_F_KEY and " ВКЛ" or " ВЫКЛ")
        end
        btn.BackgroundColor3 = (CFG.PARRY_ENABLED and (CFG.USE_REMOTE or CFG.USE_F_KEY)) and Color3.fromRGB(60, 180, 100) or Color3.fromRGB(180, 60, 60)
    end)
end

createToggle(50, "Авто-парир", CFG.PARRY_ENABLED, function() CFG.PARRY_ENABLED = not CFG.PARRY_ENABLED end)
createToggle(100, "Метод Remote", CFG.USE_REMOTE, function() CFG.USE_REMOTE = not CFG.USE_REMOTE end)
createToggle(150, "Метод F", CFG.USE_F_KEY, function() CFG.USE_F_KEY = not CFG.USE_F_KEY end)

menuBtn.MouseButton1Click:Connect(function() menuFrame.Visible = not menuFrame.Visible end)
closeMenu.MouseButton1Click:Connect(function() menuFrame.Visible = false end)

-- 7. МАТЕМАТИКА
local function getDistanceToSegment(p, a, b)
    local ab = b - a
    local ap = p - a
    local abLenSq = ab:Dot(ab)
    if abLenSq == 0 then return (p - a).Magnitude end
    local t = math.clamp(ap:Dot(ab) / abLenSq, 0, 1)
    local closest = a + ab * t
    return (p - closest).Magnitude
end

-- 8. ГЛАВНЫЙ ЦИКЛ
local state = { diameter = CFG.MAX_RADIUS * 2, color = CFG.COLOR_OUTSIDE, lastFlash = 0 }
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

local lastBall = nil
local prevBallPos = nil

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtColor = CFG.COLOR_OUTSIDE
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_status = "Safe"

    if ball then
        dbg_ball = "YES"
        local ballPos = ball.Position
        local dist = (hrpPos - ballPos).Magnitude
        dbg_dist = dist
        
        if lastBall ~= ball then
            prevBallPos = ballPos
            lastBall = ball
        end

        -- Проверка траектории (Swept Collision)
        local hitTrajectory = false
        if prevBallPos then
            local distanceToPath = getDistanceToSegment(hrpPos, prevBallPos, ballPos)
            if distanceToPath <= CFG.PARRY_RADIUS then
                hitTrajectory = true
            end
        end

        local hitInside = (dist <= CFG.PARRY_RADIUS)

        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then targeting = true
        elseif Character:FindFirstChild("Highlight") then targeting = true
        elseif (ballPos - prevBallPos).Magnitude > 1 and dist < 50 then targeting = true end

        if targeting then
            local targetRadius = math.clamp(dist, CFG.PARRY_RADIUS, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (hitInside or hitTrajectory) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            if hitTrajectory or hitInside then
                executeParry()
                state.lastFlash = tick()
                dbg_status = hitTrajectory and "Hit Path!" or "Hit Inside!"
            end
        end

        prevBallPos = ballPos
    else
        lastBall = nil
        prevBallPos = nil
    end

    debugText.Text = string.format(
        "Ball: %s\nDist: %.1f\nStatus: %s\nMethod: %s\nRemote: %s", 
        dbg_ball, dbg_dist, dbg_status, lastAction, remoteName)

    state.diameter = damp(state.diameter, tgtDiameter, 14, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(14 * dt))

    if CFG.SPHERE_VISIBLE and sphere.Parent then
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
        sphere.Transparency = 0.7
        sphere.Color = finalColor
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP = newChar:WaitForChild("HumanoidRootPart", 15)
    cachedBall = nil
    lastBall = nil
    prevBallPos = nil
end)
