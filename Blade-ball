    MAX_PARRY_DIAMETER  = 45,
    MAX_RADIUS          = 30,
    PARRY_COOLDOWN      = 0.20,
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    THEME               = "Dark",
    
    MIN_SPEED_THRESH    = 50,
    MAX_SPEED_THRESH    = 200,
    HUMAN_DELAY_MIN     = 0.04,
    HUMAN_DELAY_MAX     = 0.12,
    PREDICT_FRAMES      = 2,
    MIN_AHEAD           = 0.06,
    MAX_AHEAD           = 0.25,
    NEAR_TRANSPARENCY   = 0.60,
    FAR_TRANSPARENCY    = 0.80,
    Y_OFFSET            = -0.5,
    DAMP_LAMBDA         = 14,
    PULSE_SPEED         = 2.2,
    PULSE_SIZE_AMPL     = 0.04,
    PULSE_ALPHA_AMPL    = 0.04,
    BOB_SPEED           = 1.8,
    BOB_AMPLITUDE       = 0.15,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
