-- 8. МАТЕМАТИКА
local function getDistanceToSegment(p, a, b)
    local ab = b - a
    local ap = p - a
    local abLenSq = ab:Dot(ab)
    if abLenSq == 0 then return (p - a).Magnitude end
    local t = math.clamp(ap:Dot(ab) / abLenSq, 0, 1)
    local closest = a + ab * t
    return (p - closest).Magnitude
end

-- 9. ГЛАВНЫЙ ЦИКЛ
local state = { diameter = CFG.MAX_RADIUS * 2, color = CFG.COLOR_OUTSIDE, lastFlash = 0 }
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

local lastBall = nil
local prevBallPos = nil

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        sphere.Transparency = 1
        return
    end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtColor = CFG.COLOR_OUTSIDE
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_status = "Safe"
    local dbg_time = 999

    if ball then
        dbg_ball = "YES"
        local ballPos = ball.Position
        local dist = (hrpPos - ballPos).Magnitude
        dbg_dist = dist
        
        if lastBall ~= ball then
            prevBallPos = ballPos
            lastBall = ball
        end

        -- Считаем скорость сближения
        local approach = 0
        if prevBallPos and dt > 0 then
            local moveVec = ballPos - prevBallPos
            if moveVec.Magnitude > 0.1 then
                local dirToMe = (hrpPos - ballPos).Unit
                approach = moveVec:Dot(dirToMe) / dt
            end
        end

        -- Время до удара
        if approach > 1 then
            dbg_time = dist / approach
        end

        -- 1. Проверка траектории
        local hitTrajectory = false
        if prevBallPos then
            local distanceToPath = getDistanceToSegment(hrpPos, prevBallPos, ballPos)
            if distanceToPath <= CFG.PARRY_RADIUS then hitTrajectory = true end
        end

        -- 2. Проверка внутри
        local hitInside = (dist <= CFG.PARRY_RADIUS)

        -- 3. ПРЕДСКАЗАНИЕ (Компенсация пинга)
        local pingDelay = pingCache + CFG.PING_SAFETY
        local willHitSoon = (approach > 10) and (dbg_time <= pingDelay)

        local targeting = false
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then targeting = true
        elseif Character:FindFirstChild("Highlight") then targeting = true
        elseif (ballPos - prevBallPos).Magnitude > 1 and dist < 60 then targeting = true end

        if targeting then
            local targetRadius = math.clamp(dist, CFG.PARRY_RADIUS, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (hitInside or hitTrajectory) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE

            -- Срабатывание (Добавлено willHitSoon)
            if hitTrajectory or hitInside or willHitSoon then
                executeParry()
                state.lastFlash = tick()
                dbg_status = willHitSoon and "Ping Predict!" or (hitTrajectory and "Hit Path!" or "Hit Inside!")
            end
        end

        prevBallPos = ballPos
    else
        lastBall = nil
        prevBallPos = nil
    end

    debugText.Text = string.format(
        "Ball: %s\nDist: %.1f\nTime: %s\nStatus: %s\nMethod: %s", 
        dbg_ball, dbg_dist, (dbg_time > 900 and "N/A" or string.format("%.2fs", dbg_time)), dbg_status, lastAction)

    state.diameter = damp(state.diameter, tgtDiameter, 14, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(14 * dt))

    if CFG.SPHERE_VISIBLE and sphere.Parent then
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
        sphere.Transparency = 0.7
        sphere.Color = finalColor
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP = newChar:WaitForChild("HumanoidRootPart", 15)
    cachedBall = nil
    lastBall = nil
    prevBallPos = nil
end)
