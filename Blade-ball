local function Parry()
    -- Пытаемся найти кнопку блока в интерфейсе
    local blockButton = player.PlayerGui:FindFirstChild("Hotbar") and player.PlayerGui.Hotbar:FindFirstChild("Block")
    
    if blockButton then
        -- Если есть getconnections (поддерживается не всеми экзекуторами)
        if getconnections then
            for _, connection in pairs(getconnections(blockButton.Activated)) do
                connection:Fire()
            end
            -- Можно также попробовать MouseButton1Click, MouseButton1Down
            for _, connection in pairs(getconnections(blockButton.MouseButton1Click)) do
                connection:Fire()
            end
        else
            -- Запасной вариант: VirtualInputManager (если getconnections нет)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end
    end
end
