print("⏳ [BB] Запуск...")

local CFG = {
    PARRY_RADIUS        = 12,        -- Радиус сферы (12 - идеальное окно парира)
    MAX_RADIUS          = 20,        -- Максимальный размер сферы
    PARRY_COOLDOWN      = 0.20,      
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
    
    -- Метод нажатия (меняется в меню)
    USE_REMOTE          = true,
    USE_F_KEY           = true,
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 15)

-- 1. REMOTE
local parryRemote = nil
local remoteName = "None"

task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                parryRemote = obj
                remoteName = obj.Name
                print("✅ [BB] Найден Remote: " .. remoteName)
                break
            end
        end
    end
end)

