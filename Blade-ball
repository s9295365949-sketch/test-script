local function SaveProfileToFile(pName)
    local data = {
        Theme = CurrentThemeName, Enabled = STATE.Enabled, ShowVisuals = STATE.ShowVisuals,
        AntiLag = STATE.AntiLag, HideInner = STATE.HideInner, StaticSphere = STATE.StaticSphere,
        NightModeSphere = STATE.NightModeSphere, NightMap = STATE.NightMap,
        OuterColor = tostring(STATE.OuterColor), InnerColor = tostring(STATE.InnerColor)
    }
    local success = pcall(function()
        writefile("BB_Profile_" .. pName .. ".json", HttpService:JSONEncode(data))
    end)
    if success then print("✅ [BB] Профиль '"..pName.."' сохранен!") 
    else print("❌ [BB] Ошибка сохранения.") end
end

local function LoadProfileFromFile(pName, showMsg)
    local success, data = pcall(function()
        if isfile and isfile("BB_Profile_" .. pName .. ".json") then
            return HttpService:JSONDecode(readfile("BB_Profile_" .. pName .. ".json"))
        end
    end)
    if success and data then
        CurrentThemeName = data.Theme or "Dark Metal"
        CurrentTheme = THEMES[CurrentThemeName] or THEMES["Dark Metal"]
        STATE.Enabled = data.Enabled ~= false
        STATE.ShowVisuals = data.ShowVisuals ~= false
        STATE.AntiLag = data.AntiLag == true
        STATE.HideInner = data.HideInner == true
        STATE.StaticSphere = data.StaticSphere == true
        STATE.NightModeSphere = data.NightModeSphere == true
        STATE.NightMap = data.NightMap == true
        if ApplyTheme then ApplyTheme() end
        if showMsg then print("✅ [BB] Профиль '"..pName.."' загружен!") end
    else
        if showMsg then print("❌ [BB] Профиль не найден.") end
    end
end

