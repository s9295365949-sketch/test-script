    ║   BLADE BALL — DEBUG EDITION                                          ║
    ║   • Экранный отладчик в левом верхнем углу                            ║
    ║   • Парирование через Remote, Кнопку или F (каскадный fallback)       ║
    ╚═══════════════════════════════════════════════════════════════════════╝
]]

print("⏳ [BB] Запуск скрипта...")

local CFG = {
    MIN_PARRY_DIAMETER  = 60,
    MAX_PARRY_DIAMETER  = 100,
    MAX_RADIUS          = 60,
    PARRY_COOLDOWN      = 0.15,
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    
    MIN_SPEED_THRESH    = 30,
    MAX_SPEED_THRESH    = 200,
    HUMAN_DELAY_MIN     = 0.01,
    HUMAN_DELAY_MAX     = 0.04,
    PREDICT_FRAMES      = 2,
    MIN_AHEAD           = 0.06,
    MAX_AHEAD           = 0.25,
    NEAR_TRANSPARENCY   = 0.60,
    FAR_TRANSPARENCY    = 0.80,
    Y_OFFSET            = -0.5,
    DAMP_LAMBDA         = 14,
    PULSE_SPEED         = 2.2,
    PULSE_SIZE_AMPL     = 0.04,
    PULSE_ALPHA_AMPL    = 0.04,
    BOB_SPEED           = 1.8,
    BOB_AMPLITUDE       = 0.15,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService  = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 15)

-- Поиск Remote
local parryRemote = nil
task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") then
                parryRemote = obj; break
            end
        end
    end
end)

-- Поиск Кнопки
local cachedButton = nil
local function findParryButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") then
                return obj
            end
        end
    end
end

-- Сфера
local sphere = Instance.new("Part")
sphere.Name = "AuraVisual"
sphere.Shape = Enum.PartType.Ball
sphere.Anchored = true
sphere.CanCollide = false
sphere.CanTouch = false
sphere.CanQuery = false
sphere.CastShadow = false
sphere.Massless = true
sphere.Material = Enum.Material.ForceField
sphere.Color = CFG.COLOR_OUTSIDE
sphere.Transparency = 1
sphere.Size = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent = Workspace

-- Поиск Мяча
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (o:GetAttribute("realBall") or n:find("ball")) and not n:find("explosion") then
                return o
            end
        end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then cachedBall = o end
end)
Workspace.ChildRemoved:Connect(function(o) if o == cachedBall then cachedBall = nil end end)

-- Парирование
local lastParry = 0
local burstActive = false
local lastAction = "None"

local function executeParry()
    if burstActive or not CFG.PARRY_ENABLED then return end
    burstActive = true
    task.spawn(function()
        task.wait(CFG.HUMAN_DELAY_MIN + math.random() * (CFG.HUMAN_DELAY_MAX - CFG.HUMAN_DELAY_MIN))
        
        local parried = false
        
        -- Способ 1: Remote
        if parryRemote then
            pcall(function() parryRemote:FireServer() end)
            lastAction = "Remote"
            parried = true
        end
        
        -- Способ 2: Кнопка (Тап)
        if not parried then
            if not cachedButton or not cachedButton.Parent then cachedButton = findParryButton() end
            if cachedButton then
                local pos = cachedButton.AbsolutePosition
                local size = cachedButton.AbsoluteSize
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 0)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 0)
                end)
                lastAction = "Button Tap"
                parried = true
            end
        end
        
        -- Способ 3: Клавиша F (PC fallback)
        if not parried then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end)
            lastAction = "Key F"
        end
        
        task.wait(0.1)
        burstActive = false
    end)
end

-- Экранный Отладчик (Левый верхний угол)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BBDebug"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local debugText = Instance.new("TextLabel")
debugText.Size = UDim2.new(0, 250, 0, 100)
debugText.Position = UDim2.new(0, 10, 0, 10)
debugText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
debugText.BackgroundTransparency = 0.5
debugText.TextColor3 = Color3.fromRGB(0, 255, 0)
debugText.Font = Enum.Font.Code
debugText.TextSize = 12
debugText.TextXAlignment = Enum.TextXAlignment.Left
debugText.TextYAlignment = Enum.TextYAlignment.Top
debugText.Text = "Загрузка..."
debugText.Parent = screenGui

-- Главный цикл
local state = { diameter = CFG.MAX_RADIUS * 2, transparency = CFG.FAR_TRANSPARENCY, color = CFG.COLOR_OUTSIDE, lastFlash = 0, phase = 0 }
local function damp(cur, tgt, lambda, dt) return tgt + (cur - tgt) * math.exp(-lambda * dt) end
local function clamp01(x) return math.clamp(x, 0, 1) end

RunService.Heartbeat:Connect(function(dt)
    if not Character or not Character.Parent then Character = LocalPlayer.Character end
    if not HRP or not HRP.Parent then HRP = Character and Character:FindFirstChild("HumanoidRootPart") end
    if not HRP then return end

    if not cachedBall or not cachedBall.Parent then cachedBall = findBall() end
    local hrpPos = HRP.Position
    local ball = cachedBall

    local tgtDiameter = CFG.MAX_RADIUS * 2
    local tgtTransparency = CFG.FAR_TRANSPARENCY
    local tgtColor = CFG.COLOR_OUTSIDE
    local doParry = false
    
    local dbg_ball = "NO"
    local dbg_dist = 0
    local dbg_target = "NO"

    if ball then
        dbg_ball = "YES"
        local dist = (hrpPos - ball.Position).Magnitude
        dbg_dist = dist
        local bv = ball.AssemblyLinearVelocity
        if bv.Magnitude < 0.5 then bv = ball.Velocity end
        local speed = bv.Magnitude
        local approach = 0
        if speed > 0.5 then approach = bv:Dot((hrpPos - ball.Position).Unit) end

        local currentParryRadius = CFG.MIN_PARRY_DIAMETER / 2

        -- Проверка: летит ли мяч в нас?
        local tVal = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if tVal and (tVal == LocalPlayer.Name or tostring(tVal) == LocalPlayer.Name) then 
            dbg_target = "ATTR"
            doParry = true 
        elseif Character:FindFirstChild("Highlight") then 
            dbg_target = "HL"
            doParry = true 
        elseif speed > 5 and approach > 5 and dist < 80 then 
            dbg_target = "FLYING"
            doParry = true 
        end

        if doParry then
            local targetRadius = math.clamp(dist, currentParryRadius, CFG.MAX_RADIUS)
            tgtDiameter = targetRadius * 2
            tgtColor = (dist <= currentParryRadius) and CFG.COLOR_INSIDE or CFG.COLOR_OUTSIDE
            tgtTransparency = CFG.NEAR_TRANSPARENCY

            if dist <= currentParryRadius then 
                if tick() - lastParry >= CFG.PARRY_COOLDOWN then
                    executeParry()
                    lastParry = tick()
                    state.lastFlash = tick()
                end
            end
        end
    end

    -- Обновляем текст отладчика
    debugText.Text = string.format("Ball: %s\nDist: %.1f\nTarget: %s\nMethod: %s", 
        dbg_ball, dbg_dist, dbg_target, lastAction)

    -- Визуал
    state.diameter = damp(state.diameter, tgtDiameter, CFG.DAMP_LAMBDA, dt)
    state.color = state.color:Lerp(tgtColor, clamp01(CFG.DAMP_LAMBDA * dt))
    state.phase = state.phase + dt * CFG.PULSE_SPEED

    if CFG.SPHERE_VISIBLE then
        local finalColor = state.color
        if tick() - state.lastFlash < 0.12 then finalColor = Color3.fromRGB(255, 255, 255) end
        sphere.CFrame = CFrame.new(hrpPos.X, hrpPos.Y + CFG.Y_OFFSET, hrpPos.Z)
        sphere.Size = Vector3.new(state.diameter, state.diameter, state.diameter)
        sphere.Transparency = 0.7
        sphere.Color = finalColor
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HRP = newChar:WaitForChild("HumanoidRootPart", 15)
    cachedBall = nil
    cachedButton = nil
end)
