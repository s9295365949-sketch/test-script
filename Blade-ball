print("⏳ [BB] Запуск...")

local CFG = {
    PARRY_RADIUS        = 35,        
    MAX_RADIUS          = 40,        
    PARRY_COOLDOWN      = 0.15,
    PARRY_ENABLED       = true,
    SPHERE_VISIBLE      = true,
    Y_OFFSET            = -0.5,
    COLOR_INSIDE        = Color3.fromRGB(255, 30, 30),
    COLOR_OUTSIDE       = Color3.fromRGB(30, 255, 50),
}

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP         = Character:WaitForChild("HumanoidRootPart", 15)

-- ============================================================
-- 1. ПОИСК REMOTE
-- ============================================================
local parryRemote = nil
task.spawn(function()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") or n:find("swing") or n:find("combat") then
                parryRemote = obj
                print("✅ [BB] Найден Remote: " .. obj.Name)
                break
            end
        end
    end
end)

-- ============================================================
-- 2. СФЕРА (В WORKSPACE)
-- ============================================================
local sphere = Instance.new("Part")
sphere.Name = "AuraVisual"
sphere.Shape = Enum.PartType.Ball
sphere.Anchored = true
sphere.CanCollide = false
sphere.CanTouch = false
sphere.CanQuery = false
sphere.CastShadow = false
sphere.Massless = true
sphere.Material = Enum.Material.ForceField
sphere.Color = CFG.COLOR_OUTSIDE
sphere.Transparency = 1
sphere.Size = Vector3.new(CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2, CFG.MAX_RADIUS * 2)
sphere.Parent = Workspace  -- ВОЗВРАЩЕНО В WORKSPACE

-- ============================================================
-- 3. ПОИСК МЯЧА
-- ============================================================
local cachedBall = nil
local function findBall()
    local bf = Workspace:FindFirstChild("Balls")
    if bf then for _, o in ipairs(bf:GetChildren()) do if o:IsA("BasePart") then return o end end end
    for _, o in ipairs(Workspace:GetChildren()) do
        if o:IsA("BasePart") then
            local n = o.Name:lower()
            if (o:GetAttribute("realBall") or n:find("ball")) and not n:find("explosion") then
                return o
            end
        end
    end
end
cachedBall = findBall()
Workspace.ChildAdded:Connect(function(o)
    if o:IsA("BasePart") and not cachedBall and (o:GetAttribute("realBall") or o.Name:lower():find("ball")) then cachedBall = o end
end)
Workspace.ChildRemoved:Connect(function(o) if o == cachedBall then cachedBall = nil end end)

-- ============================================================
-- 4. ПАРИРОВАНИЕ (ТОЛЬКО REMOTE)
-- ============================================================
local lastParry = 0
local lastAction = "None"

local function executeParry()
    if not CFG.PARRY_ENABLED then return end
    
    if parryRemote then
        pcall(function() parryRemote:FireServer() end)
        lastAction = "Remote Fired"
    else
        lastAction = "No Remote Found!"
    end
end

