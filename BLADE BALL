    local Hitbox = Instance.new("TextButton")
    Hitbox.Size = UDim2.new(1, 0, 1, 0)
    Hitbox.BackgroundTransparency = 1
    Hitbox.Text = ""
    Hitbox.Parent = Container

    Hitbox.MouseButton1Click:Connect(function()
        PlayClick()
        STATE[stateKey] = not STATE[stateKey]
        SwitchBg.BackgroundColor3 = STATE[stateKey] and CurrentTheme.ACCENT or CurrentTheme.OFF
        local targetPos = STATE[stateKey] and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        TweenService:Create(Knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
        if callback then callback(STATE[stateKey]) end
    end)
end

