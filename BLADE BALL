local function SaveProfile()
    local pName = ProfileTextBox.Text ~= "" and ProfileTextBox.Text or "Default"
    local data = {
        Theme = CurrentThemeName, Enabled = STATE.Enabled, ShowVisuals = STATE.ShowVisuals,
        AntiLag = STATE.AntiLag, HideInner = STATE.HideInner, StaticSphere = STATE.StaticSphere,
        NightModeSphere = STATE.NightModeSphere, NightMap = STATE.NightMap,
        OuterColor = tostring(STATE.OuterColor), InnerColor = tostring(STATE.InnerColor),
        CameraLock = STATE.CameraLock
    }
    local success = pcall(function() writefile(PROFILE_FOLDER .. "/" .. pName .. ".json", HttpService:JSONEncode(data)) end)
    if success then print(">>> [BB] Profile saved: "..pName) end
    if _G.BB_RefreshProfiles then _G.BB_RefreshProfiles() end
end

local function LoadProfile(pName)
    local success, data = pcall(function()
        if isfile and isfile(PROFILE_FOLDER .. "/" .. pName .. ".json") then
            return HttpService:JSONDecode(readfile(PROFILE_FOLDER .. "/" .. pName .. ".json"))
        end
    end)
    if success and data then
        CurrentThemeName = data.Theme or "Premium Dark"
        CurrentTheme = THEMES[CurrentThemeName] or THEMES["Premium Dark"]
        STATE.Enabled = data.Enabled ~= false
        STATE.ShowVisuals = data.ShowVisuals ~= false
        STATE.AntiLag = data.AntiLag == true
        STATE.HideInner = data.HideInner == true
        STATE.StaticSphere = data.StaticSphere == true
        STATE.NightModeSphere = data.NightModeSphere == true
        STATE.NightMap = data.NightMap == true
        STATE.CameraLock = data.CameraLock == true
        if ApplyTheme then ApplyTheme() end
        print(">>> [BB] Profile loaded: "..pName)
    end
end

