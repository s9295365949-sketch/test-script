local PagesList, TabsList = {}, {}

local function CreateTab(name, icon)
    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.Parent = Pages
    
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 10)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Page
    
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.33, -4, 1, 0)
    TabBtn.BackgroundColor3 = CurrentTheme.OFF
    TabBtn.BackgroundTransparency = 0.3
    TabBtn.Text = icon .. " " .. name
    TabBtn.TextColor3 = CurrentTheme.TEXT
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 11
    TabBtn.Parent = TabContainer
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
    
    table.insert(PagesList, Page)
    table.insert(TabsList, {Btn = TabBtn, Page = Page})
    
    TabBtn.MouseButton1Click:Connect(function()
        PlayClick()
        for _, t in ipairs(TabsList) do
            t.Page.Visible = false
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.OFF, TextColor3 = CurrentTheme.TEXT}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.ACCENT, TextColor3 = CurrentTheme.BG}):Play()
    end)
    
    return Page
end

local function CreateToggle(parent, yPos, text, stateKey, callback)
    local Container = Instance.new("Frame")
