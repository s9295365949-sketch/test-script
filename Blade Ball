            if S.NightModeSphere then OS.Material=Enum.Material.Neon; OS.Transparency=0.5; if tc~=Color3.fromRGB(255,50,50) then tc=Color3.fromRGB(20,0,30) end else OS.Material=Enum.Material.ForceField; OS.Transparency=0.65 end
            OS.Color=OS.Color:Lerp(tc,cl(10*dt,0,1))
            if tc==Color3.fromRGB(255,50,50) then IS.Color=IS.Color:Lerp(Color3.fromRGB(255,50,50),cl(10*dt,0,1)) else local fi=S.NightModeSphere and Color3.fromRGB(255,0,255) or S.InnerColor; IS.Color=IS.Color:Lerp(fi,cl(10*dt,0,1)) end
            IS.CFrame=OS.CFrame*CFrame.Angles(PTm,PTm,0); IS.Size=Vector3.new(fs*C.CORE_RATIO,fs*C.CORE_RATIO,fs*C.CORE_RATIO)
        end
        -- DEBUG
        if DL then
            if DL.Status then DL.Status.Text=st; DL.Status.TextColor3=st=="DANGER!" and Color3.fromRGB(255,60,60) or (st=="Incoming" and Color3.fromRGB(255,200,0) or Color3.fromRGB(0,255,100)) end
            if DL.Speed then DL.Speed.Text=string.format("%.0f",speed) end
            if DL.Time then DL.Time.Text=tti>900 and "N/A" or string.format("%.2fs",tti) end
            if DL.Distance then DL.Distance.Text=string.format("%.1f",dist) end
            if DL.Armed then DL.Armed.Text=tostring(S.IsArmed); DL.Armed.TextColor3=S.IsArmed and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,150,150) end
            if DL.Parry then DL.Parry.Text=S.ParryMethod or "N/A" end
            if DL.Delay then DL.Delay.Text=string.format("%.0fms",S.LastDelay*1000); DL.Delay.TextColor3=S.LastMiss and Color3.fromRGB(255,100,100) or Color3.fromRGB(240,240,240) end
            if DL.Skips then DL.Skips.Text=tostring(S.SpamSkips); DL.Skips.TextColor3=Color3.fromRGB(255,200,100) end
            if DL.Sword then
                if S.SwordShrink then DL.Sword.Text="SHRINK"; DL.Sword.TextColor3=Color3.fromRGB(255,200,100)
                elseif SS.Transparency<1 then DL.Sword.Text="Tracking"; DL.Sword.TextColor3=Color3.fromRGB(200,200,255)
                else DL.Sword.Text="—"; DL.Sword.TextColor3=Color3.fromRGB(140,140,150) end
            end
        end
    end)
end)

