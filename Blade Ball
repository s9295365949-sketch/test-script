_G.BB_RefreshProfiles = function()
    for _, child in ipairs(ProfileListFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local autoName = ""
    pcall(function() if isfile and isfile("BB_AutoLoad.txt") then autoName = readfile("BB_AutoLoad.txt") end end)

    local files = {}
    pcall(function()
        if listfiles then
            for _, f in ipairs(listfiles(PROFILE_FOLDER)) do
                local match = f:match("(.+)%.json")
                if match then table.insert(files, match) end
            end
        end
    end)

    if #files == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 25); empty.BackgroundTransparency = 1
        empty.Text = "No profiles saved"; empty.TextColor3 = CurrentTheme.TEXT
        empty.Font = Enum.Font.Gotham; empty.TextSize = 11; empty.Parent = ProfileListFrame
        return
    end

    table.sort(files)
    if autoName ~= "" then
        for i, v in ipairs(files) do
            if v == autoName then table.remove(files, i); table.insert(files, 1, v); break end
        end
    end

    for _, name in ipairs(files) do
        local isAuto = (name == autoName)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 25); row.BackgroundTransparency = 1; row.Parent = ProfileListFrame

