local function TriggerParryInstant(ball)
    local now = tick()
    if now - STATE.LastParry < CONFIG.COOLDOWN then return end
    if now - STATE.LastParry < CONFIG.MIN_PARRY_INTERVAL then return end
    if ball and wasRecentlyParried(ball) then return end

    STATE.LastParry = now
    if ball then STATE.ParryHistory[ball] = now end
    STATE.TotalParries += 1
    cleanParryHistory()

    task.spawn(function()
        task.wait(math.random(20, 50) / 1000)
        if not STATE.BlockButton or not STATE.BlockButton.Parent then
            STATE.BlockButton = FindBlockButton()
        end
        if STATE.BlockButton and getconnections then
            local ok = pcall(function()
                for _, c in ipairs(getconnections(STATE.BlockButton.Activated)) do
                    if c.Fire then c:Fire() end
                end
            end)
            if ok then STATE.ParryMethod = "Core"; return end
        end
        if STATE.Remote then
            pcall(function() STATE.Remote:FireServer() end)
            STATE.ParryMethod = "Core-Remote"; return
        end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.F, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        STATE.ParryMethod = "Core-VIM"
    end)
end

local function TriggerParry(ball)
    local now = tick()
    local cooldown = CONFIG.COOLDOWN + math.random() * CONFIG.PARRY_COOLDOWN_JITTER
    if now - STATE.LastParry < cooldown then return end
    if now - STATE.LastParry < CONFIG.MIN_PARRY_INTERVAL then return end

    if ball then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local myDist = (ball.Position - hrp.Position).Magnitude
            if shouldSkipParry(ball, myDist) then return end
        end
    end

    STATE.LastParry = now
    if ball then STATE.ParryHistory[ball] = now end
    STATE.TotalParries += 1
    cleanParryHistory()

    task.spawn(function()
        local delay
        if math.random() < CONFIG.SLOW_REACTION_CHANCE then
            delay = CONFIG.HUMAN_DELAY_MAX * (1.1 + math.random() * 0.4)
        else
            delay = humanDelay()
        end
        STATE.LastDelay = delay
        task.wait(delay)

        if math.random() < CONFIG.MISS_CHANCE then
            STATE.LastMiss = true
            STATE.ParryMethod = "Miss"
            return
        end
        STATE.LastMiss = false

        if not STATE.BlockButton or not STATE.BlockButton.Parent then
            STATE.BlockButton = FindBlockButton()
        end
        if STATE.BlockButton and getconnections then
            local success = pcall(function()
                for _, c in ipairs(getconnections(STATE.BlockButton.Activated)) do
                    if c.Fire then c:Fire() end
                end
            end)
            if success then STATE.ParryMethod = "Button"; return end
        end
        if STATE.Remote then
            pcall(function() STATE.Remote:FireServer() end)
            STATE.ParryMethod = "Remote"; return
        end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.F, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        STATE.ParryMethod = "VIM"
    end)
end

