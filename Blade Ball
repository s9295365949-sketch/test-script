local function setSwordSphereHidden(hide)
    if STATE.SwordSphereHidden == hide then return end
    STATE.SwordSphereHidden = hide

    local char = LocalPlayer.Character
    if not char then return end

    local containers = {char}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then table.insert(containers, bp) end

    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("sphere") or n:find("orb") or n:find("aura") or n:find("glow") then
                    if obj ~= OuterSphere and obj ~= InnerSphere then
                        if hide then
                            if not STATE._hiddenSwordParts[obj] then
                                STATE._hiddenSwordParts[obj] = {
                                    transparency = obj.Transparency, canCollide = obj.CanCollide,
                                    canTouch = obj.CanTouch, canQuery = obj.CanQuery,
                                }
                            end
                            obj.Transparency = 1; obj.CanCollide = false
                            obj.CanTouch = false; obj.CanQuery = false
                        else
                            local saved = STATE._hiddenSwordParts[obj]
                            if saved and obj.Parent then
                                obj.Transparency = saved.transparency
                                obj.CanCollide = saved.canCollide
                                obj.CanTouch = saved.canTouch
                                obj.CanQuery = saved.canQuery
                            end
                            STATE._hiddenSwordParts[obj] = nil
                        end
                    end
                end
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") then
                local p = obj.Parent
                if p and (p:IsA("Tool") or p:IsA("BasePart")) then
                    if obj.Name:lower():find("sphere") or obj.Name:lower():find("orb")
                       or obj.Name:lower():find("aura") or p:IsA("Tool") then
                        obj.Enabled = not hide
                    end
                end
            end
        end
    end
end

local function sweptHitSphere(prevPos, currPos, center, radius)
    local d = currPos - prevPos
    local f = prevPos - center
    local a = d:Dot(d)
    if a < 1e-10 then return f.Magnitude <= radius end
    local b = 2 * f:Dot(d)
    local c = f:Dot(f) - radius * radius
    local disc = b * b - 4 * a * c
    if disc < 0 then return false end
    local sqrtDisc = math.sqrt(disc)
    local t1 = (-b - sqrtDisc) / (2 * a)
    local t2 = (-b + sqrtDisc) / (2 * a)
    return not (t1 > 1 or t2 < 0)
end

