-- ANTI-SPAM
local function CPH() local n=tick(); for b,t in pairs(S.ParryHistory) do if n-t>C.BALL_TRACK_TIME then S.ParryHistory[b]=nil end end end
local function WRP(b) if not b then return false end; local t=S.ParryHistory[b]; if not t then return false end; if tick()-t<C.BALL_TRACK_TIME then return true end; S.ParryHistory[b]=nil; return false end
local function NPB(b) local n,nd=nil,math.huge; for _,p in ipairs(P:GetPlayers()) do if p~=LP and p.Character then local h=p.Character:FindFirstChild("HumanoidRootPart"); if h then local d=(h.Position-b.Position).Magnitude; if d<nd then n,nd=p,d end end end end; return n,nd end
local function SSP(b,md)
    if WRP(b) then S.ParryMethod="Skip (tracked)"; return true end
    local _,nd=NPB(b); if nd~=math.huge and nd<md*C.NEAREST_PLAYER_FACTOR then if math.random()<C.SPAM_SKIP_CHANCE then S.ParryMethod="Skip (other)"; S.SpamSkips+=1; return true end end
    if md<=C.CLOSE_SPAM_DIST and math.random()<C.CLOSE_SPAM_SKIP_CHANCE then S.ParryMethod="Skip (close)"; S.SpamSkips+=1; return true end
    return false
end

-- TRIGGER
local function TP(b,ovr)
    local n=tick(); local cd=C.COOLDOWN+math.random()*C.PARRY_COOLDOWN_JITTER
    if n-S.LastParry<cd then return end; if n-S.LastParry<C.MIN_PARRY_INTERVAL then return end
    if b and ovr==nil then local ch=LP.Character; local h=ch and ch:FindFirstChild("HumanoidRootPart"); if h then local md=(b.Position-h.Position).Magnitude; if SSP(b,md) then return end end end
    S.LastParry=n; if b then S.ParryHistory[b]=n end; S.TotalParries+=1; CPH()
    task.spawn(function()
        local d
        if ovr~=nil then d=ovr elseif math.random()<C.SLOW_REACTION_CHANCE then d=C.HUMAN_DELAY_MAX*(1.1+math.random()*0.4) else d=HD() end
        S.LastDelay=d; if d>0 then task.wait(d) end
        if ovr==nil and math.random()<C.MISS_CHANCE then S.LastMiss=true; S.ParryMethod="Miss"; return end; S.LastMiss=false
        if not S.BlockButton or not S.BlockButton.Parent then S.BlockButton=FB() end
        if S.BlockButton and getconnections then local ok=pcall(function() local cc=getconnections(S.BlockButton.Activated); for _,x in ipairs(cc) do if x.Fire then x:Fire() end end end); if ok then S.ParryMethod=ovr~=nil and "Sword-Core" or "Button"; return end end
        if S.Remote then pcall(function() S.Remote:FireServer() end); S.ParryMethod=ovr~=nil and "Sword-Core" or "Remote"; return end
        pcall(function() VIM:SendKeyEvent(true,Enum.KeyCode.F,false,game); task.wait(0.02); VIM:SendKeyEvent(false,Enum.KeyCode.F,false,game) end); S.ParryMethod=ovr~=nil and "Sword-Core" or "VIM"
    end)
end

