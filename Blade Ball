        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, STATE.Ball.Position)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        STATE.Frames = STATE.Frames + 1
        local render = true
        if STATE.AntiLag and (STATE.Frames % 3 ~= 0) then render = false end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0) then
            if OuterSphere then OuterSphere.Transparency = 1 end
            return
        end

        local ball = GetBall()
        local dist, speed, timeToImpact = 0, 0, 999
        local targetColor = STATE.OuterColor
        local status = "Safe"
        local targetingMe = false

        if ball then
            local bp = ball.Position
            dist = (hrp.Position - bp).Magnitude

            if STATE.Ball ~= ball then
                STATE.Ball = ball
                STATE.PrevBallPos = bp
                STATE.IsArmed = true
            end
            if dist > 80 then STATE.IsArmed = true end

            targetingMe = IsTargetingMe(ball)
            setSwordSphereHidden(targetingMe)

            -- SWEPT HIT TEST
            if targetingMe and STATE.Enabled then
                local ballR  = ball.Size.Magnitude * 0.5
                local outerR = OuterSphere.Size.X * 0.5
                local innerVisualR = InnerSphere.Size.X * 0.5
                local innerHitR = math.max(innerVisualR, 1.5)

                local prevPos = STATE.PrevBallPos or bp
                local currPos = bp

                local hitOuter = sweptHitSphere(prevPos, currPos, OuterSphere.Position, outerR + ballR)
                local hitInner = sweptHitSphere(prevPos, currPos, InnerSphere.Position, innerHitR + ballR)

                if hitInner then
                    STATE.ShrinkUntil  = tick() + 0.25
                    STATE.ShrinkFactor = 0.15
                    TriggerParryInstant(ball)
                    STATE.IsArmed = false
                elseif hitOuter then
                    STATE.ShrinkUntil  = tick() + 0.20
                    STATE.ShrinkFactor = 0.30
                end
            end

            local bv = ball.AssemblyLinearVelocity
            if bv.Magnitude > 1 then
                speed = bv.Magnitude
                local dirToMe = (hrp.Position - bp).Unit
                local approachSpeed = bv:Dot(dirToMe)
                if approachSpeed > 1 then timeToImpact = dist / approachSpeed end
            elseif STATE.PrevBallPos and dt > 0 then
                local moveVec = bp - STATE.PrevBallPos
                speed = moveVec.Magnitude / dt
                if speed > 1 then
                    local dirToMe = (hrp.Position - bp).Unit
                    local approachSpeed = moveVec.Unit:Dot(dirToMe) * speed
                    if approachSpeed > 1 then timeToImpact = dist / approachSpeed end
                end
            end

            if targetingMe then
                local predictedHit = false
                if speed > 1 then
                    local predictedPos = bp + bv * getPredictTime()
                    if (hrp.Position - predictedPos).Magnitude <= CONFIG.CLOSE_DIST then
                        predictedHit = true
                    end
                end

                if dist <= CONFIG.CLOSE_DIST or timeToImpact <= CONFIG.PING_SAFE or predictedHit then
                    targetColor = Color3.fromRGB(255, 50, 50)
                    status = "DANGER!"
                    if STATE.Enabled then
                        TriggerParry(ball)
                        STATE.IsArmed = false
                    end
                else
                    targetColor = Color3.fromRGB(255, 200, 0)
                    status = "Incoming"
                end
            else
                targetColor = Color3.fromRGB(0, 255, 100)
                status = "Other Target"
            end
            STATE.PrevBallPos = bp
        else
            STATE.IsArmed = true
            STATE.PrevBallPos = nil
            setSwordSphereHidden(false)
        end

        -- ВИЗУАЛ СФЕРЫ
        if render and STATE.ShowVisuals and OuterSphere and InnerSphere then
            PulseTime = PulseTime + (dt * 2.5)

            -- Восстановление после сжатия
            if tick() < STATE.ShrinkUntil then
                STATE.ShrinkFactor = math.max(0.15, STATE.ShrinkFactor - dt * 5)
            else
                STATE.ShrinkFactor = math.min(1.0, STATE.ShrinkFactor + dt * 1.5)
            end

            local targetSize = clamp(math.max(dist * 1.5, CONFIG.SPHERE_MIN), CONFIG.SPHERE_MIN, CONFIG.SPHERE_MAX)
            local currentSize = OuterSphere.Size.X
            local newSize = currentSize + (targetSize - currentSize) * math.exp(-10 * dt)
            local finalSize = newSize * STATE.ShrinkFactor
                             * (STATE.StaticSphere and 1 or (1 + math.sin(PulseTime) * 0.02))

            OuterSphere.Size = Vector3.new(finalSize, finalSize, finalSize)
            OuterSphere.CFrame = CFrame.new(hrp.Position + Vector3.new(0, -0.5, 0))

            if STATE.NightModeSphere then
                OuterSphere.Material = Enum.Material.Neon
                OuterSphere.Transparency = 0.5
                InnerSphere.Transparency = 0.2
                if targetColor ~= Color3.fromRGB(255, 50, 50) then
                    targetColor = Color3.fromRGB(20, 0, 30)
                end
            else
                OuterSphere.Material = Enum.Material.ForceField
                OuterSphere.Transparency = 0.65
                InnerSphere.Transparency = STATE.HideInner and 1 or 0.7
            end

            OuterSphere.Color = OuterSphere.Color:Lerp(targetColor, clamp(10 * dt, 0, 1))
            if targetColor == Color3.fromRGB(255, 50, 50) then
                InnerSphere.Color = InnerSphere.Color:Lerp(Color3.fromRGB(255, 50, 50), clamp(10 * dt, 0, 1))
            else
                local finalInner = STATE.NightModeSphere and Color3.fromRGB(255, 0, 255) or STATE.InnerColor
                InnerSphere.Color = InnerSphere.Color:Lerp(finalInner, clamp(10 * dt, 0, 1))
            end

            InnerSphere.CFrame = OuterSphere.CFrame * CFrame.Angles(PulseTime, PulseTime, 0)
            InnerSphere.Size = Vector3.new(finalSize * CONFIG.CORE_RATIO, finalSize * CONFIG.CORE_RATIO, finalSize * CONFIG.CORE_RATIO)
        end

        -- ДЕБАГ
        if debugLabels then
            if debugLabels["Status"] then
                debugLabels["Status"].Text = status
                if status == "DANGER!" then debugLabels["Status"].TextColor3 = Color3.fromRGB(255, 60, 60)
                elseif status == "Incoming" then debugLabels["Status"].TextColor3 = Color3.fromRGB(255, 200, 0)
                else debugLabels["Status"].TextColor3 = Color3.fromRGB(0, 255, 100) end
            end
            if debugLabels["Speed"]    then debugLabels["Speed"].Text    = string.format("%.0f", speed) end
            if debugLabels["Time"]     then debugLabels["Time"].Text     = (timeToImpact > 900 and "N/A" or string.format("%.2fs", timeToImpact)) end
            if debugLabels["Distance"] then debugLabels["Distance"].Text = string.format("%.1f", dist) end
            if debugLabels["Armed"]    then
                debugLabels["Armed"].Text = tostring(STATE.IsArmed)
                debugLabels["Armed"].TextColor3 = STATE.IsArmed and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 150, 150)
            end
            if debugLabels["Parry"]    then debugLabels["Parry"].Text = STATE.ParryMethod or "N/A" end
            if debugLabels["Delay"]    then
                debugLabels["Delay"].Text = string.format("%.0fms", STATE.LastDelay * 1000)
                debugLabels["Delay"].TextColor3 = STATE.LastMiss and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(240, 240, 240)
            end
            if debugLabels["Skips"]    then
                debugLabels["Skips"].Text = tostring(STATE.SpamSkips)
                debugLabels["Skips"].TextColor3 = Color3.fromRGB(255, 200, 100)
            end
        end
    end)
end)

