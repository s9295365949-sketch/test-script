local function clamp(val, min, max)
    if val < min then return min end
    if val > max then return max end
    return val
end

local function humanDelay()
    local u1 = math.max(1e-10, math.random())
    local u2 = math.random()
    local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
    local mean = (CONFIG.HUMAN_DELAY_MIN + CONFIG.HUMAN_DELAY_MAX) / 2
    local std  = (CONFIG.HUMAN_DELAY_MAX - CONFIG.HUMAN_DELAY_MIN) / 4
    return clamp(mean + z * std, CONFIG.HUMAN_DELAY_MIN * 0.85, CONFIG.HUMAN_DELAY_MAX * 1.25)
end

local function getPredictTime()
    local jitter = (math.random() * 2 - 1) * CONFIG.PREDICT_TIME_JITTER
    return math.max(0.02, CONFIG.PREDICT_TIME_BASE + jitter)
end

