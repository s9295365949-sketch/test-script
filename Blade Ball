local function cleanParryHistory()
    local now = tick()
    for ball, t in pairs(STATE.ParryHistory) do
        if now - t > CONFIG.BALL_TRACK_TIME then STATE.ParryHistory[ball] = nil end
    end
end

local function wasRecentlyParried(ball)
    if not ball then return false end
    local t = STATE.ParryHistory[ball]
    if not t then return false end
    if tick() - t < CONFIG.BALL_TRACK_TIME then return true end
    STATE.ParryHistory[ball] = nil
    return false
end

local function getNearestPlayerToBall(ball)
    local nearest, nearestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - ball.Position).Magnitude
                if d < nearestDist then nearest, nearestDist = plr, d end
            end
        end
    end
    return nearest, nearestDist
end

local function shouldSkipParry(ball, myDist)
    if wasRecentlyParried(ball) then
        STATE.ParryMethod = "Skip (tracked)"; return true
    end
    local _, nearestDist = getNearestPlayerToBall(ball)
    if nearestDist ~= math.huge and nearestDist < myDist * CONFIG.NEAREST_PLAYER_FACTOR then
        if math.random() < CONFIG.SPAM_SKIP_CHANCE then
            STATE.ParryMethod = "Skip (other)"; STATE.SpamSkips += 1; return true
        end
    end
    if myDist <= CONFIG.CLOSE_SPAM_DIST and math.random() < CONFIG.CLOSE_SPAM_SKIP_CHANCE then
        STATE.ParryMethod = "Skip (close)"; STATE.SpamSkips += 1; return true
    end
    return false
end

