LocalPlayer.CharacterAdded:Connect(function()
    STATE.IsArmed = true
    STATE.PrevBallPos = nil
    STATE.Ball = nil
    STATE.CameraLock = false
    STATE.ShrinkFactor = 1.0
    STATE.ShrinkUntil = 0
    STATE.SwordSphereHidden = false
    STATE._hiddenSwordParts = {}
    if Camera.CameraType == Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Custom
    end
    task.delay(0.5, function()
        local ball = STATE.Ball
        if ball and ball.Parent and IsTargetingMe(ball) then
            setSwordSphereHidden(true)
        end
    end)
end)

